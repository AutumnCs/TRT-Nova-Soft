/* pages/auth/auth.wxss */
page {
  background-color: #F3F4F6;
  font-family: -apple-system, sans-serif;
  color: #1F2937;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 0;
  background-color: #F3F4F6;
}

.header {
  padding: 40px 24px 20px;
  text-align: center;
}

.title {
  font-size: 24px;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 14px;
  color: #6B7280;
  display: block;
}

.scroll-content {
  flex: 1;
  padding: 0 24px;
  box-sizing: border-box;
}

.auth-section {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 20px;
}

.auth-card {
  background-color: white;
  padding: 24px;
  border-radius: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.auth-card-title {
  font-size: 16px;
  font-weight: 700;
  color: #374151;
  margin-bottom: 8px;
}

/* Avatar Section */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.avatar-uploader {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  background-color: #F3F4F6;
  border: 2px dashed #D1D5DB;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-uploader::after {
  content: "";
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-hint {
  font-size: 12px;
  color: #6B7280;
}

/* Nickname Section */
.nickname-section {
  width: 100%;
}

.nickname-input {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid #E5E7EB;
  border-radius: 12px;
  font-size: 15px;
  line-height: 1.5;
  min-height: 44px;
  box-sizing: border-box;
  transition: all 0.2s;
}

.nickname-input:focus {
  outline: none;
  border-color: #10B981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
}

/* Old Way Button */
.old-way-btn-container {
  width: 100%;
}

.old-way-btn {
  width: 100%;
  background-color: #10B981;
  color: white;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s;
}

.old-way-btn::after {
  border-radius: 12px;
}

.old-way-btn:active {
  background-color: #059669;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 18px;
}

/* Version Hint */
.version-hint {
  text-align: center;
  color: #9CA3AF;
  font-size: 14px;
  padding: 16px;
  background-color: #F3F4F6;
  border-radius: 12px;
}

/* Logged in state */
.logged-in {
  gap: 16px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.user-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
}

.user-nickname {
  font-size: 18px;
  font-weight: 600;
  color: #1F2937;
}

.enter-btn {
  width: 100%;
  background-color: #10B981;
  color: white;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  border: none;
  margin: 0;
  transition: all 0.2s;
}

.enter-btn::after {
  border-radius: 12px;
}

.enter-btn:active {
  background-color: #059669;
  transform: scale(0.98);
}

/* 移除动画，避免影响页面渲染 */
.fade-in {
  /* 移除动画效果，避免渲染冲突 */
}

/* 引导文字样式 */
.guide-text {
  margin-top: 16px;
  text-align: center;
  font-size: 12px;
  color: #9CA3AF;
  line-height: 1.5;
}