page {
  background:
    radial-gradient(circle at top, rgba(53, 255, 149, 0.08), transparent 28%),
    linear-gradient(180deg, #07110d 0%, #091612 44%, #07110d 100%);
  color: #eafdf0;
}

.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.container::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(82, 255, 164, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(82, 255, 164, 0.08) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.35;
  mask-image: linear-gradient(180deg, rgba(0,0,0,0.7), transparent 96%);
}

.fade-in {
  animation: fadeIn 0.35s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 16px 6px;
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.topbar-brand {
  flex: 1;
  min-width: 0;
}

.topbar-kicker {
  display: block;
  font-size: 10px;
  letter-spacing: 2px;
  color: rgba(116, 255, 180, 0.65);
  text-transform: uppercase;
  margin-bottom: 2px;
}

.plant-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(14, 23, 19, 0.9), rgba(9, 18, 14, 0.96));
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow:
    0 0 0 1px rgba(71, 255, 149, 0.06) inset,
    0 0 18px rgba(33, 255, 135, 0.08);
}

.plant-picker-content {
  min-width: 0;
  flex: 1;
}

.plant-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #66f2a8;
  text-shadow: 0 0 12px rgba(68, 255, 151, 0.35);
}

.plant-meta {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.62);
}

.plant-picker-arrow {
  color: #63f2a4;
  font-size: 14px;
}

.topbar-signal {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 27, 21, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow: 0 0 16px rgba(39, 255, 143, 0.08);
}

.topbar-signal-icon {
  font-size: 16px;
  color: #68ffab;
}

.plant-chip-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.plant-personality-chip,
.plant-favorability-chip {
  min-height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid rgba(122, 255, 175, 0.18);
  background: rgba(15, 27, 21, 0.9);
  box-shadow: 0 0 14px rgba(39, 255, 143, 0.06);
}

.plant-personality-label,
.plant-favorability-label {
  font-size: 10px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(123, 255, 177, 0.76);
}

.plant-personality-value,
.plant-favorability-value {
  font-size: 12px;
  font-weight: 700;
  color: #effff4;
}

.scroll-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding: 2px 16px calc(120px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dark-panel,
.dark-card,
.card,
.device-item,
.add-device,
.grid-item,
.extra-item,
.device-card,
.chat-bubble,
.no-device-guide {
  background: linear-gradient(180deg, rgba(13, 21, 17, 0.96), rgba(10, 18, 14, 0.96));
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow:
    0 0 0 1px rgba(86, 255, 156, 0.05) inset,
    0 0 18px rgba(0, 0, 0, 0.22);
}

.plant-section {
  position: relative;
  min-height: 450rpx;
  padding: 22rpx;
  margin-bottom: 16px;
  border-radius: 28px;
  overflow: hidden;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(80, 255, 164, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(80, 255, 164, 0.08) 1px, transparent 1px);
  background-size: 24px 24px;
  opacity: 0.28;
  pointer-events: none;
}

.glow-bg {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  right: -38px;
  top: 10px;
  background: rgba(68, 255, 151, 0.18);
  filter: blur(34px);
  pointer-events: none;
}

.plant-circle {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 208rpx;
  height: 208rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid rgba(122, 255, 175, 0.18);
  box-shadow:
    0 0 0 1px rgba(103, 255, 171, 0.08) inset,
    0 0 26px rgba(46, 255, 146, 0.18);
}

.plant-img {
  width: 100%;
  height: 100%;
}

.status-pill {
  position: absolute;
  min-height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(11, 18, 14, 0.92);
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow: 0 0 20px rgba(31, 255, 130, 0.08);
  z-index: 2;
}

.status-pill-left {
  top: 20px;
  left: 18px;
}

.status-pill-right {
  top: 20px;
  right: 18px;
  max-width: 44%;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  padding-top: 8px;
  padding-bottom: 8px;
}

.status-pill-label {
  font-size: 10px;
  letter-spacing: 1px;
  color: #7ef4ac;
}

.status-pill-value {
  font-size: 9px;
  line-height: 1.2;
  color: rgba(223, 255, 232, 0.68);
  white-space: nowrap;
}

.weather-widget {
  position: absolute;
  left: 24px;
  bottom: 22px;
  min-width: 96px;
  height: 52px;
  padding: 0 12px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(13, 21, 17, 0.94);
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow: 0 0 18px rgba(31, 255, 130, 0.08);
}

.weather-icon {
  font-size: 18px;
}

.weather-temp {
  font-size: 16px;
  font-weight: 800;
  color: #effff4;
}

.bubble {
  position: absolute;
  min-width: 92px;
  min-height: 42px;
  padding: 8px 10px;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  border: 1px solid rgba(122, 255, 175, 0.16);
  background: rgba(10, 18, 14, 0.9);
  z-index: 1;
}

.bubble-success {
  box-shadow: 0 0 18px rgba(46, 255, 146, 0.08);
}

.bubble-warning {
  border-color: rgba(255, 174, 65, 0.28);
  box-shadow: 0 0 18px rgba(255, 174, 65, 0.08);
}

.bubble-icon {
  font-size: 12px;
}

.bubble-text {
  font-size: 11px;
  color: rgba(232, 255, 238, 0.82);
}

.mood-icon {
  position: absolute;
  right: 22px;
  bottom: 28px;
  width: 42px;
  height: 42px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 21, 17, 0.94);
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow: 0 0 18px rgba(31, 255, 130, 0.08);
  font-size: 20px;
}

.dialogue-section,
.section {
  margin-bottom: 16px;
}

.dialogue-section {
  padding: 14px;
  border-radius: 22px;
}

.chat-bubble {
  border-radius: 20px;
  padding: 14px 16px;
}

.chat-text {
  display: block;
  font-size: 14px;
  line-height: 1.7;
  color: rgba(236, 255, 242, 0.9);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 800;
  color: #f4fff7;
}

.add-todo-btn,
.refresh-btn {
  min-height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(12, 20, 15, 0.9);
  border: 1px solid rgba(122, 255, 175, 0.14);
  color: #63f2a4;
}

.add-todo-btn text,
.refresh-btn-text {
  font-size: 12px;
  font-weight: 700;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.todo-composer {
  margin-bottom: 12px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.9);
}

.todo-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 40px;
  padding: 0 12px;
  border-radius: 10px;
  background: #ffffff;
  color: #26352d;
  border: 1px solid #c7d8bd;
}

.todo-composer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 10px;
}

.todo-cancel,
.todo-confirm {
  margin: 0;
  padding: 0 14px;
  min-height: 32px;
  line-height: 32px;
  border-radius: 999px;
  font-size: 13px;
}

.plant-identity-card,
.plant-status-card {
  margin: 20rpx 28rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #fffdf7;
  border: 2rpx solid rgba(21, 128, 61, .14);
  box-shadow: 0 10rpx 24rpx rgba(21, 128, 61, .08);
}
.plant-identity-card { display: flex; align-items: center; justify-content: space-between; }
.identity-main { display: flex; flex-direction: column; gap: 6rpx; }
.identity-name { color: #163b2a; font-size: 34rpx; font-weight: 700; }
.identity-type, .identity-growth { color: #6b7f72; font-size: 22rpx; }
.identity-growth { color: #7c3aed; }
.plant-status-card { margin-top: 14rpx; }
.status-card-heading { display: flex; align-items: center; gap: 12rpx; }
.status-card-icon { width: 36rpx; height: 36rpx; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; background: #15803d; font-weight: 700; }
.status-card-label { color: #163b2a; font-size: 28rpx; font-weight: 700; }
.status-card-freshness { margin-left: auto; color: #6b7f72; font-size: 21rpx; }
.status-card-description { display: block; margin-top: 12rpx; color: #405447; font-size: 25rpx; line-height: 1.6; }
.status-card-metrics { display: flex; flex-wrap: wrap; gap: 10rpx 20rpx; margin-top: 14rpx; color: #6b7f72; font-size: 21rpx; }
.status-attention { border-color: rgba(234, 88, 12, .3); background: #fff7ed; }
.status-attention .status-card-icon { background: #ea580c; }
.status-offline { border-color: rgba(100, 116, 139, .3); background: #f8fafc; }
.status-offline .status-card-icon, .status-stale .status-card-icon { background: #64748b; }
.status-stale { background: #fafaf9; }
.care-suggestion { display: inline-block; margin-top: 16rpx; padding: 12rpx 18rpx; border-radius: 999rpx; color: #fff; background: #ea580c; font-size: 23rpx; }
.todo-composer-title { display: block; margin-bottom: 12rpx; color: #405447; font-size: 23rpx; font-weight: 600; }
.todo-scope { display: block; margin-top: 6rpx; color: #84958b; font-size: 20rpx; }
.pressed { opacity: .72; transform: scale(.98); }

.topbar-subtitle { margin-left: 12rpx; color: #84958b; font-size: 22rpx; }
.home-module { margin: 20rpx 28rpx 0; padding: 26rpx; border-radius: 32rpx; background: #fffdf7; border: 2rpx solid rgba(21,128,61,.14); box-shadow: 0 10rpx 24rpx rgba(21,128,61,.08); }
.plant-main-card { padding: 0; overflow: hidden; }
.plant-main-visual { position: relative; min-height: 360rpx; border-radius: 30rpx 30rpx 0 0; }
.plant-main-badge { position: absolute; left: 24rpx; bottom: 24rpx; padding: 10rpx 18rpx; color: #fff; background: #15803d; border-radius: 999rpx; font-size: 22rpx; }
.plant-main-info { padding: 24rpx; }
.plant-main-info .status-card { margin-top: 20rpx; padding: 22rpx; border-radius: 24rpx; background: #f4f9ef; }
.module-heading { display: flex; align-items: center; justify-content: space-between; }
.module-kicker { display: block; color: #7c3aed; font-size: 19rpx; letter-spacing: 2rpx; font-weight: 700; }
.module-title { display: block; margin-top: 4rpx; color: #163b2a; font-size: 32rpx; font-weight: 700; }
.action-dialogue { margin: 22rpx 0 18rpx; padding: 18rpx 20rpx; color: #405447; background: #f5f0ff; border-radius: 18rpx; font-size: 24rpx; line-height: 1.5; }
.todo-list { display: flex; flex-direction: column; gap: 12rpx; }
.todo-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 12rpx; border-bottom: 1rpx solid #edf2e9; }
.todo-row:last-child { border-bottom: 0; }
.todo-check { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #15803d; font-size: 28rpx; }
.todo-row-urgent .todo-check { background: #ea580c; }
.todo-row-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.todo-row-title { color: #244332; font-size: 26rpx; font-weight: 600; }
.todo-row-desc { color: #84958b; font-size: 21rpx; }
.device-empty { padding: 36rpx 12rpx 18rpx; text-align: center; }
.device-empty-icon { display: block; color: #15803d; font-size: 48rpx; }
.device-empty-title { display: block; margin-top: 8rpx; color: #244332; font-size: 28rpx; font-weight: 700; }
.device-empty-desc { display: block; margin-top: 8rpx; color: #84958b; font-size: 22rpx; }
.facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin-top: 24rpx; }
.fact-item { padding: 16rpx 8rpx; text-align: center; background: #f4f9ef; border-radius: 18rpx; }
.fact-value { display: block; color: #244332; font-size: 27rpx; font-weight: 700; }
.fact-unit { margin-left: 2rpx; color: #84958b; font-size: 17rpx; }
.fact-label { display: block; margin-top: 6rpx; color: #84958b; font-size: 19rpx; }
.fan-row { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; padding: 18rpx; border-radius: 20rpx; background: #fff7ed; }
.fan-row-pending { opacity: .7; }
.fan-state-dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.fan-on { background: #15803d; box-shadow: 0 0 0 6rpx rgba(21,128,61,.12); }
.fan-off { background: #94a3b8; }
.fan-row-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.fan-row-title { color: #244332; font-size: 25rpx; font-weight: 600; }
.fan-row-desc { color: #84958b; font-size: 20rpx; }
.fan-row-action { color: #ea580c; font-size: 22rpx; }
.device-detail-link { display: flex; justify-content: space-between; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #edf2e9; color: #6b7f72; font-size: 21rpx; }

.todo-cancel::after,
.todo-confirm::after {
  border: 0;
}

.todo-cancel {
  color: #5f6f64;
  background: #eef2ea;
}

.todo-confirm {
  color: #ffffff;
  background: #4d8758;
}

.card {
  padding: 14px;
  border-radius: 20px;
}

.dark-task-card {
  background: linear-gradient(180deg, rgba(13, 21, 17, 0.95), rgba(10, 18, 14, 0.96));
}

.border-l-red {
  border-left: 4px solid rgba(255, 98, 98, 0.85);
}

.border-l-blue {
  border-left: 4px solid rgba(90, 211, 255, 0.85);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-circle {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(18, 30, 23, 0.95);
  border: 1px solid rgba(122, 255, 175, 0.1);
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #f4fff7;
}

.card-desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
}

.text-red {
  color: rgba(255, 130, 130, 0.9);
}

.text-gray {
  color: rgba(223, 255, 232, 0.58);
}

.empty-state {
  padding: 14px 0 2px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.56);
}

.no-device-guide {
  padding: 18px;
  border-radius: 22px;
}

.no-device-icon {
  display: block;
  font-size: 24px;
  margin-bottom: 8px;
}

.no-device-title {
  display: block;
  font-size: 15px;
  font-weight: 800;
  color: #f4fff7;
}

.no-device-desc {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.6;
  color: rgba(223, 255, 232, 0.6);
}

.device-scroll {
  overflow: hidden;
}

.device-list {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.device-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.device-item,
.add-device {
  width: 168px;
  min-width: 168px;
  padding: 14px;
  border-radius: 22px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.device-item.active {
  border-color: rgba(113, 255, 170, 0.28);
  box-shadow:
    0 0 0 1px rgba(79, 255, 160, 0.08) inset,
    0 0 18px rgba(39, 255, 143, 0.1);
}

.device-item-icon,
.add-device-icon {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
}

.device-item-name {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f4fff7;
}

.device-item-plant,
.device-item-location,
.device-item-status {
  display: block;
  font-size: 11px;
  line-height: 1.5;
  color: rgba(223, 255, 232, 0.62);
}

.status-text-online {
  color: rgba(117, 255, 180, 0.96);
}

.status-text-offline {
  color: rgba(255, 186, 103, 0.95);
}

.add-device {
  justify-content: center;
  align-items: center;
  color: #63f2a4;
  border-style: dashed;
  background: rgba(10, 18, 14, 0.76);
}

.add-device-text {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.grid-item {
  padding: 14px;
  border-radius: 20px;
  min-height: 116px;
}

.grid-icon-wrap {
  width: 32px;
  height: 32px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
}

.grid-icon-emoji {
  font-size: 16px;
}

.grid-value {
  display: block;
  font-size: 24px;
  font-weight: 800;
  color: #66f2a8;
  line-height: 1.1;
}

.unit {
  font-size: 12px;
  color: rgba(223, 255, 232, 0.64);
  margin-left: 2px;
}

.grid-label {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.58);
}

.extra-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.extra-item {
  padding: 14px;
  border-radius: 18px;
  min-height: 86px;
}

.extra-item.full {
  grid-column: 1 / -1;
}

.extra-label {
  display: block;
  font-size: 11px;
  letter-spacing: 1px;
  color: rgba(122, 255, 175, 0.58);
  margin-bottom: 10px;
}

.extra-value {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: #f4fff7;
  line-height: 1.55;
  word-break: break-all;
}

.extra-value.uid {
  color: #67f2a4;
}

.control-section {
  margin-top: 4px;
}

.device-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.device-card {
  position: relative;
  border-radius: 24px;
  padding: 16px;
  min-height: 164px;
  overflow: hidden;
}

.device-card.active {
  border-color: rgba(113, 255, 170, 0.3);
  box-shadow:
    0 0 0 1px rgba(79, 255, 160, 0.08) inset,
    0 0 18px rgba(39, 255, 143, 0.12);
}

.device-card.pending {
  opacity: 0.92;
}

.device-state-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  min-width: 66px;
  height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 34, 26, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.14);
}

.device-state-badge.is-on {
  background: linear-gradient(180deg, rgba(91, 255, 169, 0.98), rgba(37, 195, 104, 0.98));
}

.device-state-badge.is-off {
  background: rgba(18, 30, 23, 0.96);
}

.device-state-badge-text {
  font-size: 11px;
  font-weight: 800;
  color: #05110b;
}

.device-icon-box {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
  box-shadow: 0 0 18px rgba(39, 255, 143, 0.08);
}

.device-icon {
  font-size: 26px;
}

.device-info {
  max-width: 82%;
}

.device-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #f4fff7;
}

.device-status {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  color: #66f2a8;
}

.device-hint {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.6;
  color: rgba(223, 255, 232, 0.58);
}

/* 潮玩植物伙伴主题：保留业务布局，只重置视觉层。 */
page {
  background: #fff8ee;
  color: #26352d;
}

.container {
  background:
    radial-gradient(circle at 92% 7%, rgba(255, 205, 112, 0.34), transparent 24%),
    linear-gradient(180deg, #fff7e9 0%, #f2f4e4 46%, #e7efdc 100%);
}

.container::before,
.grid-overlay {
  background-image: none;
  opacity: 0;
}

.topbar {
  padding: 14px 18px 8px;
}

.topbar-kicker {
  color: #ee8b42;
  font-size: 11px;
  letter-spacing: 1.4px;
  font-weight: 700;
}

.plant-picker {
  padding: 10px 12px;
  border: 2px solid #26352d;
  border-radius: 20px;
  background: #fffdf8;
  box-shadow: 0 5px 0 #d8e4c8;
}

.plant-name,
.section-title,
.card-title,
.device-item-name,
.device-name,
.no-device-title,
.extra-value {
  color: #26352d;
  text-shadow: none;
}

.plant-name { font-size: 18px; }
.plant-meta,
.plant-personality-label,
.plant-favorability-label,
.text-gray,
.device-item-plant,
.device-item-location,
.grid-label,
.extra-label,
.device-hint,
.no-device-desc {
  color: #718071;
}

.plant-picker-arrow,
.topbar-signal-icon {
  color: #ee8b42;
}

.topbar-signal {
  background: #ffd36f;
  border: 2px solid #26352d;
  box-shadow: 0 4px 0 #e2b551;
}

.plant-personality-chip,
.plant-favorability-chip {
  border: 1.5px solid #c9ddbf;
  background: #eff8e9;
  box-shadow: none;
}

.plant-personality-value,
.plant-favorability-value {
  color: #3f674b;
}

.dark-panel,
.dark-card,
.card,
.device-item,
.add-device,
.grid-item,
.extra-item,
.device-card,
.chat-bubble,
.no-device-guide {
  background: #fffdf8;
  border: 1.5px solid #d7e4ce;
  box-shadow: 0 5px 0 rgba(195, 211, 183, 0.72);
}

.plant-section {
  min-height: 430rpx;
  border: 2px solid #26352d;
  border-radius: 32px;
  background:
    radial-gradient(circle at 80% 18%, rgba(255, 211, 111, 0.8), transparent 25%),
    linear-gradient(145deg, #dff1c9 0%, #b9dfb7 100%);
  box-shadow: 0 7px 0 #9bc39c;
}

.glow-bg {
  width: 180px;
  height: 180px;
  background: rgba(255, 247, 196, 0.76);
  filter: blur(18px);
}

.plant-circle {
  width: 230rpx;
  height: 230rpx;
  border: 6px solid #fffdf8;
  box-shadow: 0 7px 0 rgba(79, 127, 83, 0.42);
}

.status-pill,
.weather-widget,
.bubble,
.mood-icon {
  background: #fffdf8;
  border: 1.5px solid #26352d;
  box-shadow: 0 4px 0 rgba(195, 211, 183, 0.8);
}

.status-pill-label,
.status-pill-value,
.weather-temp,
.bubble-text {
  color: #385440;
}

.status-pill-label { font-weight: 800; }
.bubble-warning { border-color: #e6a14a; }

.dialogue-section { padding: 12px 2px; }
.chat-bubble { border-radius: 22px 22px 22px 8px; padding: 15px 17px; }
.chat-text { color: #435d48; line-height: 1.65; }

.empty-state {
  margin-top: 2px;
  padding: 12px 14px;
  border-radius: 14px;
  background: #e8ddff;
  border: 1.5px solid #b6a6ed;
  color: #5b469c;
  font-size: 12px;
  box-shadow: 0 3px 0 #c2b5eb;
}

.section:not(:first-of-type) {
  padding: 4px 0;
}

.section-header { margin-bottom: 14px; }
.section-title { font-size: 18px; font-weight: 800; }

.add-todo-btn,
.refresh-btn {
  min-height: 34px;
  background: #ffd36f;
  border: 1.5px solid #26352d;
  color: #26352d;
  box-shadow: 0 3px 0 #e2b551;
}

.card { border-radius: 20px; padding: 15px; }
.border-l-red { border-left: 6px solid #ef8b5d; }
.border-l-blue { border-left: 6px solid #8bc6a0; }

.icon-circle,
.grid-icon-wrap,
.device-item-icon,
.add-device-icon,
.device-icon-box {
  background: #f2e9d9;
  border: 1.5px solid #dfcba9;
}

.grid { gap: 14px; }
.grid-item { min-height: 120px; border-radius: 22px; }
.grid-value { color: #3c7b52; }
.unit { color: #718071; }

.device-item,
.add-device { border-radius: 22px; }
.device-item.active { border-color: #7eb28a; box-shadow: 0 5px 0 #b5d3b4; }
.status-text-online { color: #3c9a61; }
.status-text-offline { color: #c47d35; }
.add-device { color: #4d8758; border-style: dashed; }

.extra-item { border-radius: 18px; min-height: 82px; }
.extra-label { letter-spacing: 0; }
.extra-value.uid { color: #4d8758; }

.device-card { border-radius: 24px; }
.device-card.active { border-color: #7eb28a; box-shadow: 0 5px 0 #b5d3b4; }
.device-state-badge { border: 1.5px solid #26352d; background: #f1f4e9; }
.device-state-badge.is-on { background: #9ed5a1; }
.device-state-badge-text { color: #26352d; }
.device-icon { color: #e38a42; }
.device-status { color: #3c7b52; }

/* 更强的潮玩撞色：用深墨绿和橙黄做锚点，避免整体发淡。 */
.topbar-kicker { color: #d94f35; }
.plant-picker { border-color: #17251e; box-shadow: 0 5px 0 #a9c997, 5px 5px 0 rgba(217, 79, 53, 0.12); }
.plant-name { color: #17251e; }
.topbar-signal { background: #ffb83e; border-color: #17251e; box-shadow: 0 4px 0 #c87524; }
.topbar-signal-icon { color: #17251e; }

.plant-section {
  background:
    radial-gradient(circle at 78% 16%, #ffcc4d 0 10%, transparent 11%),
    radial-gradient(circle at 88% 26%, rgba(229, 88, 67, 0.72), transparent 22%),
    linear-gradient(140deg, #b7e7ae 0%, #8dcc9d 100%);
  border-color: #17251e;
  box-shadow: 0 8px 0 #3d7b59, 8px 8px 0 rgba(217, 79, 53, 0.18);
}

.plant-circle { border-color: #17251e; box-shadow: 0 7px 0 #3d7b59; }
.status-pill-label { color: #d94f35; }
.weather-widget { background: #ffb83e; border-color: #17251e; box-shadow: 0 4px 0 #c87524; }
.weather-temp { color: #17251e; }
.mood-icon { background: #8d74d8; border-color: #17251e; box-shadow: 0 4px 0 #5b469c; }

.section-title { color: #17251e; }
.add-todo-btn,
.refresh-btn { background: #ffb83e; border-color: #17251e; box-shadow: 0 4px 0 #c87524; }
.card { border-color: #bfd6b8; box-shadow: 0 5px 0 #c7d8bd, 5px 5px 0 rgba(141, 116, 216, 0.1); }
.border-l-red { border-left-color: #d94f35; }
.border-l-blue { border-left-color: #8d74d8; }
.grid-item { box-shadow: 0 5px 0 #c7d8bd; }
.grid-item:nth-child(2) { background: #fff0c7; border-color: #e5be61; }
.grid-item:nth-child(3) { background: #e4ddff; border-color: #b6a6ed; }
.grid-item:nth-child(4) { background: #ffdcd3; border-color: #e7a18e; }
.grid-value { color: #284d36; }
.device-item.active,
.device-card.active { border-color: #d94f35; box-shadow: 0 5px 0 #e5a087; }
.device-item-icon,
.add-device-icon,
.device-icon-box { background: #e4ddff; border-color: #b6a6ed; }
.device-state-badge.is-on { background: #ffb83e; }
