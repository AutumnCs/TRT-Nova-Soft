page { background: #f3f7e9; color: #244332; }

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-grid {
  position: fixed;
  inset: 0;
  background-image: linear-gradient(rgba(21, 128, 61, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(21, 128, 61, 0.06) 1px, transparent 1px);
  background-size: 32px 32px;
  opacity: 0.24;
  pointer-events: none;
  mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.4), transparent 80%);
}

.bg-glow-1 { background: rgba(166, 220, 153, .38); }.bg-glow-2 { background: rgba(255, 198, 84, .2); }

.bg-glow {
  position: fixed;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  filter: blur(50px);
  opacity: 0.2;
  pointer-events: none;
}

.bg-glow-1 {
  top: -80px;
  right: -120px;
  background: rgba(36, 255, 141, 0.45);
}

.bg-glow-2 {
  bottom: 6%;
  left: -120px;
  background: rgba(0, 223, 162, 0.22);
}

.topbar { padding-left: 28rpx; padding-right: 28rpx; }.icon-btn { color: #244332; border: 0; background: #fffdf7; box-shadow: 0 5rpx 0 #c9d8bd; }.brand-kicker { color: #7c3aed; }.brand-title { color: #163b2a; text-shadow: none; }.signal-pill { color: #15803d; background: #e3f3df; border-color: #c5dfbd; }
.content { padding: 0 28rpx 160rpx; }.hero-card, .panel, .record-card { background: #fffdf7; border: 2rpx solid rgba(21,128,61,.12); box-shadow: 0 7rpx 0 rgba(201,216,189,.7); }.hero-card { border-radius: 30rpx; }.hero-chip { background: #dff1d8; color: #477c43; }.hero-chip.ghost { background: #f5f0ff; color: #7c3aed; }.device-name, .panel-title, .day-title, .record-title, .composer-title { color: #244332; }.device-subtitle, .day-subtitle, .record-type, .record-content, .empty-desc { color: #84958b; }.device-cta { color: #ea580c; }.calendar-panel, .day-panel, .empty-panel { border-radius: 28rpx; }.panel-kicker, .composer-kicker { color: #7c3aed; }.nav-arrow { color: #244332; background: #f4f9ef; }.nav-arrow.active { color: #fff; background: #15803d; }.day-cell.active { background: #a8d99b; color: #163b2a; }.day-dot, .timeline-dot { background: #ea580c; }.action-btn.primary, .composer-btn.primary { background: #ea580c; color: #fff; }.action-btn.ghost, .composer-btn.secondary { color: #15803d; background: #e3f3df; }.record-icon { background: #e3f3df; color: #15803d; }.composer-mask { background: rgba(22,59,42,.36); }.composer { background: #fffdf7; border-radius: 30rpx 30rpx 0 0; }.composer-field { background: #f4f9ef; border-color: #dcebd3; }.composer-field-label { color: #6b7f72; }.composer-input, .composer-textarea, .composer-picker-text { color: #244332; }

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 16px 10px;
}

.topbar-inner {
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #32e184;
  border: 1px solid rgba(110, 255, 169, 0.25);
  background: rgba(8, 18, 14, 0.72);
  box-shadow: 0 0 0 1px rgba(56, 255, 150, 0.08) inset;
}

.icon-btn-text {
  font-size: 22px;
  line-height: 1;
  transform: translateY(-1px);
}

.brand-block {
  flex: 1;
  text-align: center;
}

.brand-kicker {
  display: block;
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(110, 255, 169, 0.68);
}

.brand-title {
  display: block;
  margin-top: 2px;
  font-size: 18px;
  font-weight: 800;
  color: #5ef2a4;
  text-shadow: 0 0 12px rgba(84, 255, 156, 0.45);
}

.signal-pill {
  min-width: 72px;
  padding: 0 12px;
  height: 36px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid rgba(110, 255, 169, 0.25);
  background: rgba(8, 18, 14, 0.72);
  color: #52ef97;
  box-shadow: 0 0 0 1px rgba(56, 255, 150, 0.08) inset;
}

.signal-wave {
  font-size: 12px;
}

.signal-text {
  font-size: 11px;
  letter-spacing: 1px;
}

.content {
  position: relative;
  z-index: 1;
  height: calc(100vh - 82px);
  box-sizing: border-box;
  padding: 4px 16px calc(120px + env(safe-area-inset-bottom));
}

.hero-card,
.panel,
.record-card,
.empty-panel,
.empty-device {
  background: linear-gradient(180deg, rgba(13, 23, 18, 0.92), rgba(9, 18, 13, 0.95));
  border: 1px solid rgba(127, 255, 169, 0.2);
  box-shadow:
    0 0 0 1px rgba(83, 255, 145, 0.06) inset,
    0 0 20px rgba(0, 0, 0, 0.28),
    0 0 32px rgba(40, 255, 143, 0.06);
}

.hero-card,
.panel,
.empty-panel {
  border-radius: 26px;
}

.hero-card {
  padding: 16px;
  margin-bottom: 14px;
}

.hero-chip-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.hero-chip {
  height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  border: 1px solid rgba(110, 255, 169, 0.26);
  background: rgba(33, 58, 43, 0.66);
  display: inline-flex;
  align-items: center;
}

.hero-chip.ghost {
  background: rgba(255, 255, 255, 0.02);
}

.hero-chip-label {
  font-size: 11px;
  color: rgba(204, 255, 221, 0.78);
  letter-spacing: 1px;
}

.device-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border-radius: 20px;
  background:
    linear-gradient(135deg, rgba(35, 75, 52, 0.85), rgba(13, 29, 22, 0.95)),
    rgba(16, 28, 21, 0.88);
  border: 1px solid rgba(91, 255, 151, 0.2);
  box-shadow: 0 0 16px rgba(53, 255, 151, 0.08);
}

.device-avatar {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  background: radial-gradient(circle at 35% 30%, rgba(98, 255, 166, 0.26), rgba(28, 58, 41, 0.92));
  border: 1px solid rgba(123, 255, 169, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 18px rgba(78, 255, 150, 0.18);
}

.device-avatar-text {
  font-size: 24px;
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #edfdf2;
}

.device-subtitle {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
  color: rgba(204, 255, 221, 0.62);
}

.device-cta {
  min-width: 58px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #69f2a6;
}

.device-cta-text {
  font-size: 12px;
  font-weight: 700;
}

.device-cta-arrow {
  font-size: 22px;
  line-height: 1;
}

.empty-device {
  padding: 18px;
  border-radius: 20px;
}

.empty-device-title,
.empty-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f1fff4;
}

.empty-device-desc,
.empty-desc {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.6;
  color: rgba(204, 255, 221, 0.68);
}

.calendar-panel {
  padding: 16px;
  margin-bottom: 14px;
  border-radius: 28px;
}

.panel-head,
.day-header,
.composer-top,
.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.panel-kicker,
.composer-kicker {
  display: block;
  font-size: 10px;
  letter-spacing: 2px;
  color: rgba(110, 255, 169, 0.62);
  text-transform: uppercase;
}

.panel-title,
.day-title,
.composer-title {
  display: block;
  margin-top: 3px;
  font-size: 18px;
  font-weight: 800;
  color: #f0fff6;
}

.month-nav {
  display: flex;
  align-items: center;
  gap: 10px;
}

.nav-arrow {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(110, 255, 169, 0.18);
  background: rgba(11, 20, 16, 0.84);
  color: rgba(211, 255, 221, 0.88);
  font-size: 20px;
}

.nav-arrow.active {
  color: #44f18e;
  box-shadow: 0 0 16px rgba(56, 255, 150, 0.18);
}

.week-row {
  display: flex;
  align-items: center;
  margin-top: 14px;
  margin-bottom: 10px;
}

.week-item {
  width: calc(100% / 7);
  text-align: center;
  font-size: 11px;
  color: rgba(204, 255, 221, 0.54);
  letter-spacing: 1px;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  min-height: 42px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 6px;
}

.day-cell.empty {
  opacity: 0;
}

.day-number {
  font-size: 13px;
  font-weight: 600;
  color: rgba(243, 255, 247, 0.9);
}

.day-cell.today .day-number {
  color: #59f7a0;
}

.day-cell.active .day-number {
  width: 34px;
  height: 34px;
  line-height: 34px;
  border-radius: 12px;
  text-align: center;
  color: #06110c;
  background: linear-gradient(180deg, #6affab 0%, #1ccc68 100%);
  box-shadow: 0 0 0 1px rgba(116, 255, 178, 0.18) inset, 0 0 18px rgba(40, 255, 143, 0.38);
}

.day-dot {
  width: 6px;
  height: 6px;
  margin-top: 4px;
  border-radius: 50%;
  background: #52f18f;
  box-shadow: 0 0 10px rgba(82, 241, 143, 0.9);
}

.day-panel {
  padding: 16px;
  margin-bottom: 14px;
  border-radius: 26px;
}

.day-subtitle {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
  color: rgba(204, 255, 221, 0.6);
}

.day-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.action-btn {
  height: 34px;
  padding: 0 14px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  box-sizing: border-box;
  border: 1px solid transparent;
}

.action-btn.ghost {
  color: #78f3aa;
  background: rgba(17, 31, 23, 0.9);
  border-color: rgba(120, 243, 170, 0.18);
}

.action-btn.primary {
  color: #05110b;
  background: linear-gradient(180deg, #68ffab, #18c965);
  box-shadow: 0 0 18px rgba(39, 255, 143, 0.25);
}

.timeline-wrap {
  position: relative;
  padding-left: 20px;
  margin-bottom: 12px;
}

.timeline-rail {
  position: absolute;
  left: 10px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  border-radius: 2px;
  background: linear-gradient(180deg, rgba(99, 255, 171, 0.85), rgba(99, 255, 171, 0.18));
  box-shadow: 0 0 18px rgba(71, 255, 149, 0.22);
}

.timeline-item {
  position: relative;
  margin-bottom: 14px;
}

.timeline-dot {
  position: absolute;
  left: -18px;
  top: 22px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #57f39b;
  box-shadow: 0 0 0 4px rgba(87, 243, 155, 0.12), 0 0 16px rgba(87, 243, 155, 0.6);
}

.record-card {
  position: relative;
  margin-left: 14px;
  padding: 16px;
  border-radius: 22px;
  overflow: hidden;
}

.record-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  border: 1px solid transparent;
}

.record-head {
  align-items: center;
}

.record-icon {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(18, 31, 23, 0.96);
  border: 1px solid rgba(115, 255, 181, 0.12);
}

.record-icon-text {
  font-size: 18px;
}

.record-meta {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 15px;
  font-weight: 800;
  color: #f2fff6;
}

.record-type {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  color: rgba(204, 255, 221, 0.58);
  letter-spacing: 1px;
}

.record-time {
  font-size: 11px;
  color: rgba(204, 255, 221, 0.5);
  white-space: nowrap;
}

.record-content {
  display: block;
  margin-top: 10px;
  font-size: 13px;
  line-height: 1.7;
  color: rgba(232, 255, 238, 0.88);
}

.event-watering .record-card {
  border: 1px solid rgba(88, 210, 255, 0.34);
  box-shadow:
    0 0 0 1px rgba(88, 210, 255, 0.08) inset,
    0 0 24px rgba(88, 210, 255, 0.06);
}

.event-fertilizing .record-card {
  border: 1px solid rgba(96, 255, 141, 0.34);
  box-shadow:
    0 0 0 1px rgba(96, 255, 141, 0.08) inset,
    0 0 24px rgba(96, 255, 141, 0.06);
}

.event-pruning .record-card {
  border: 1px solid rgba(255, 183, 70, 0.34);
  box-shadow:
    0 0 0 1px rgba(255, 183, 70, 0.08) inset,
    0 0 24px rgba(255, 183, 70, 0.06);
}

.event-relocation .record-card,
.event-note .record-card,
.event-photo .record-card,
.event-todo_done .record-card {
  border: 1px solid rgba(143, 160, 186, 0.22);
}

.empty-panel {
  padding: 22px 18px;
  text-align: center;
}

.empty-title {
  text-align: center;
}

.composer-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(2, 8, 5, 0.7);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: flex-end;
}

.composer {
  width: 100%;
  box-sizing: border-box;
  padding: 20px 16px calc(28px + env(safe-area-inset-bottom));
  border-radius: 28px 28px 0 0;
  background:
    linear-gradient(180deg, rgba(12, 23, 17, 0.98), rgba(7, 16, 12, 0.98)),
    #08110d;
  border-top: 1px solid rgba(122, 255, 175, 0.18);
  box-shadow: 0 -12px 32px rgba(0, 0, 0, 0.32);
}

.composer-top {
  align-items: center;
  margin-bottom: 16px;
}

.composer-title {
  margin-top: 2px;
  font-size: 20px;
}

.composer-close {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(122, 255, 175, 0.14);
  color: #7ef4ac;
  background: rgba(16, 29, 22, 0.9);
  font-size: 20px;
}

.composer-field {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18px;
  margin-bottom: 12px;
  border: 1px solid rgba(122, 255, 175, 0.16);
  background: rgba(14, 24, 18, 0.94);
}

.composer-field-label {
  display: block;
  font-size: 10px;
  letter-spacing: 1.8px;
  color: rgba(110, 255, 169, 0.6);
  text-transform: uppercase;
  margin-bottom: 8px;
}

.composer-picker {
  min-height: 62px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.composer-picker-text {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: #f1fff4;
}

.composer-picker-arrow {
  font-size: 16px;
  color: rgba(204, 255, 221, 0.66);
}

.composer-input-wrap {
  padding: 14px 16px 12px;
}

.composer-input {
  width: 100%;
  box-sizing: border-box;
  height: 28px;
  line-height: 28px;
  font-size: 14px;
  color: #f1fff4;
}

.composer-textarea-wrap {
  padding: 14px 16px 12px;
}

.composer-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 116px;
  font-size: 14px;
  line-height: 1.7;
  color: #f1fff4;
}

.composer-placeholder {
  color: rgba(204, 255, 221, 0.36);
}

.composer-actions {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.composer-btn {
  flex: 1;
  height: 44px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 800;
}

.composer-btn.secondary {
  background: rgba(20, 33, 26, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
  color: #d7f6df;
}

.composer-btn.primary {
  background: linear-gradient(180deg, #68ffab 0%, #18c965 100%);
  color: #05110b;
  box-shadow: 0 0 18px rgba(39, 255, 143, 0.24);
}
