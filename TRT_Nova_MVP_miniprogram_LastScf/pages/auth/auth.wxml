<view class="page" style="padding-top: {{statusBarHeight}}px;">
  <view wx:if="{{transitioning}}" class="transition-mask">
    <view class="transition-inner">
      <view class="transition-logo">TRT Nova</view>
      <view class="transition-spinner"><view class="spinner-ring"></view></view>
      <text class="transition-text">正在进入...</text>
    </view>
  </view>

  <view class="hero">
    <view class="hero-blob blob1"></view>
    <view class="hero-blob blob2"></view>
    <view class="hero-icon-wrap">
      <text class="hero-icon">🪴</text>
    </view>
    <text class="hero-title">TRT Nova</text>
    <text class="hero-subtitle">智能植物养护助手</text>
  </view>

  <view wx:if="{{loginState === 'choose'}}" class="card">
    <button class="wechat-login-btn" bindtap="onWeixinLogin" loading="{{saving}}" disabled="{{saving}}">
      <text class="wechat-btn-text">{{saving ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view wx:if="{{devPhoneLoginEnabled}}" class="secondary-actions">
      <button class="text-btn" bindtap="showPhoneLogin">开发体验登录</button>
    </view>

    <text class="footer-hint">登录后即可管理你的植物设备</text>
  </view>

  <view wx:if="{{loginState === 'wechat-profile'}}" class="card profile-card">
    <text class="card-label">选择头像与昵称</text>
    <text class="card-sub">可以使用微信资料，也可以自定义资料。</text>

    <button class="wechat-profile-btn" bindtap="onUseWechatProfile" disabled="{{saving}}">
      <text class="wechat-profile-text">使用微信头像昵称</text>
    </button>

    <view class="avatar-wrap">
      <button wx:if="{{!isApp}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-img {{userInfo.avatarUrl !== defaultAvatarUrl ? '' : 'avatar-placeholder'}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      </button>
      <button wx:else class="avatar-btn" bindtap="onPickAvatar">
        <image class="avatar-img {{userInfo.avatarUrl !== defaultAvatarUrl ? '' : 'avatar-placeholder'}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      </button>
      <text class="avatar-hint">点击更换头像</text>
    </view>

    <view class="input-wrap">
      <text class="input-icon">N</text>
      <input
        type="nickname"
        class="name-input"
        placeholder="输入你的昵称"
        placeholder-class="input-placeholder"
        value="{{userInfo.nickName}}"
        bindinput="onNickNameChange"
        maxlength="20"
      />
    </view>

    <button
      class="login-btn {{canSave ? 'login-btn-active' : ''}}"
      bindtap="onSaveProfile"
      disabled="{{!canSave || saving}}"
      loading="{{saving}}"
    >
      <text class="login-btn-text">{{saving ? '保存中...' : '进入花园'}}</text>
    </button>

    <view class="profile-actions">
      <button class="text-btn" bindtap="onUseCustomProfile">清空重填</button>
      <button class="text-btn" bindtap="backToChoose">返回</button>
    </view>
  </view>

  <view wx:if="{{loginState === 'phone-login'}}" class="card phone-card">
    <text class="card-label">开发体验登录</text>
    <text class="card-sub">仅供本地开发，不是正式手机号认证。</text>

    <view class="input-wrap">
      <text class="input-icon">P</text>
      <input
        class="name-input"
        type="number"
        placeholder="请输入手机号"
        placeholder-class="input-placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <button class="wechat-login-btn" bindtap="onPhoneLogin" loading="{{saving}}" disabled="{{saving}}">
      <text class="wechat-btn-text">进入开发体验</text>
    </button>

    <button class="text-btn" bindtap="backToChoose">返回</button>
  </view>
</view>
