.garden-page { width: 100%; min-height: 100vh; position: relative; overflow: hidden; background: #f3f7e9; color: #244332; }
.garden-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 10% 5%, rgba(166, 220, 153, .42), transparent 30%), radial-gradient(circle at 90% 15%, rgba(255, 198, 84, .22), transparent 25%); }
.topbar, .garden-intro, .list-scroll, .fab { position: relative; z-index: 1; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 26rpx 18rpx; }
.back-btn, .more-btn { width: 72rpx; height: 72rpx; border: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fffdf7; color: #244332; box-shadow: 0 5rpx 0 #c9d8bd; }
.back-btn::after { border: 0; }.back-btn { padding: 0; font-size: 44rpx; line-height: 1; }.more-btn { font-size: 30rpx; letter-spacing: 4rpx; }
.brand-block { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }.brand { color: #163b2a; font-size: 34rpx; font-weight: 800; }.brand-sub { color: #84958b; font-size: 17rpx; letter-spacing: 4rpx; }
.garden-intro { margin: 8rpx 28rpx 22rpx; padding: 22rpx 24rpx; border-radius: 28rpx; background: #a8d99b; box-shadow: 0 7rpx 0 #7cab77; }.intro-kicker { display: block; color: #477c43; font-size: 19rpx; letter-spacing: 3rpx; }.intro-title { display: block; margin-top: 6rpx; color: #163b2a; font-size: 40rpx; font-weight: 800; }.intro-subtitle { display: block; margin-top: 8rpx; color: #47704a; font-size: 23rpx; }
.list-scroll { height: calc(100vh - 250rpx); }.device-list { padding: 4rpx 28rpx 210rpx; }
.device-entry { display: flex; gap: 20rpx; margin-bottom: 16rpx; padding: 16rpx; border-radius: 28rpx; background: rgba(255, 253, 247, .94); border: 2rpx solid rgba(21, 128, 61, .12); box-shadow: 0 6rpx 0 rgba(201, 216, 189, .8); }
.device-image { width: 184rpx; height: 184rpx; flex-shrink: 0; border-radius: 22rpx; background: #dcebd3; }.device-main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }.top-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }.name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #244332; font-size: 32rpx; font-weight: 800; }.online { flex-shrink: 0; padding: 6rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; }.online.ok { color: #15803d; background: #e3f3df; }.online.offline { color: #64748b; background: #eef1ed; }.meta, .plant-type { display: block; margin-top: 8rpx; color: #84958b; font-size: 21rpx; }.status-line { display: flex; align-items: center; gap: 8rpx; margin-top: 14rpx; color: #15803d; font-size: 22rpx; }.status-line.warn { color: #ea580c; }.status-line.pending { color: #64748b; }.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: currentColor; }.detail-arrow { margin-left: auto; color: #84958b; font-size: 20rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 72rpx 34rpx; text-align: center; border-radius: 28rpx; background: #fffdf7; border: 2rpx dashed rgba(21, 128, 61, .24); gap: 14rpx; }.empty-icon { color: #15803d; font-size: 64rpx; }.empty-title { color: #244332; font-size: 32rpx; font-weight: 800; }.empty-desc { color: #84958b; font-size: 23rpx; line-height: 1.6; }.empty-btn { margin-top: 8rpx; padding: 16rpx 34rpx; border-radius: 999rpx; background: #ea580c; color: #fff; }.empty-btn-text { font-size: 24rpx; font-weight: 700; }
.fab { position: fixed; right: 34rpx; bottom: 128rpx; width: 112rpx; height: 112rpx; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f6ad35; color: #244332; box-shadow: 0 7rpx 0 #c77b22, 0 12rpx 24rpx rgba(128, 88, 20, .2); }.fab-plus { font-size: 52rpx; line-height: .9; font-weight: 700; }.fab-label { margin-top: 4rpx; font-size: 16rpx; }.pressed { opacity: .72; transform: scale(.97); }
