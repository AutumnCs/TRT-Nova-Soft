page {
  background:
    radial-gradient(circle at top, rgba(49, 243, 139, 0.08), transparent 34%),
    linear-gradient(180deg, #07110d 0%, #091613 50%, #07110d 100%);
  color: #d9f8e1;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(48, 255, 156, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(48, 255, 156, 0.08) 1px, transparent 1px);
  background-size: 34px 34px;
  opacity: 0.24;
  pointer-events: none;
}

.bg-glow {
  position: fixed;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.18;
  pointer-events: none;
}

.bg-glow-1 {
  top: -90px;
  right: -120px;
  background: rgba(46, 255, 138, 0.4);
}

.bg-glow-2 {
  bottom: 4%;
  left: -140px;
  background: rgba(0, 223, 162, 0.22);
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 16px 10px;
}

.topbar-inner {
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #32e184;
  border: 1px solid rgba(110, 255, 169, 0.2);
  background: rgba(8, 18, 14, 0.72);
}

.icon-btn-text {
  font-size: 16px;
  font-weight: 800;
}

.brand-block {
  flex: 1;
  text-align: center;
}

.brand-kicker {
  display: block;
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(110, 255, 169, 0.72);
}

.brand-title {
  display: block;
  margin-top: 2px;
  font-size: 18px;
  font-weight: 800;
  color: #5ef2a4;
}

.signal-pill {
  min-width: 72px;
  padding: 0 12px;
  height: 36px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid rgba(110, 255, 169, 0.25);
  background: rgba(8, 18, 14, 0.72);
  color: #52ef97;
}

.signal-text {
  font-size: 11px;
  letter-spacing: 1px;
}

.content {
  position: relative;
  z-index: 1;
  height: calc(100vh - 82px);
  box-sizing: border-box;
  padding: 10px 16px 100px;
}

.hero-card,
.section-card,
.loading-card,
.empty-state {
  background: linear-gradient(180deg, rgba(13, 23, 18, 0.92), rgba(9, 18, 13, 0.95));
  border: 1px solid rgba(127, 255, 169, 0.2);
  box-shadow:
    0 0 0 1px rgba(83, 255, 145, 0.06) inset,
    0 0 20px rgba(0, 0, 0, 0.28),
    0 0 32px rgba(40, 255, 143, 0.06);
}

.hero-card,
.section-card,
.empty-state {
  border-radius: 24px;
}

.hero-card {
  padding: 18px;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.category-pill,
.source-pill {
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
}

.category-pill {
  color: #69f2a6;
  background: rgba(7, 17, 13, 0.86);
  border: 1px solid rgba(57, 255, 136, 0.18);
}

.source-pill {
  color: rgba(204, 255, 221, 0.68);
  background: rgba(7, 17, 13, 0.68);
  border: 1px solid rgba(110, 255, 169, 0.12);
}

.hero-title {
  display: block;
  margin-top: 12px;
  font-size: 24px;
  line-height: 1.35;
  font-weight: 900;
  color: #f3fff6;
}

.hero-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.75;
  color: rgba(204, 255, 221, 0.68);
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.meta-chip {
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: #69f2a6;
  background: rgba(7, 17, 13, 0.74);
  border: 1px solid rgba(57, 255, 136, 0.12);
}

.section-card {
  margin-top: 12px;
  padding: 16px;
}

.section-title {
  display: block;
  font-size: 14px;
  font-weight: 800;
  color: #f1fff4;
  margin-bottom: 10px;
}

.article-content {
  display: block;
  font-size: 14px;
  line-height: 1.85;
  color: #dff7e7;
  white-space: pre-wrap;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag-item {
  padding: 8px 10px;
  border-radius: 999px;
  font-size: 12px;
  color: #9feab9;
  background: rgba(8, 18, 14, 0.8);
  border: 1px solid rgba(110, 255, 169, 0.16);
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 14px;
}

.action-btn {
  height: 48px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 800;
}

.action-btn.secondary {
  color: #dff7e7;
  border: 1px solid rgba(110, 255, 169, 0.16);
  background: rgba(8, 18, 14, 0.82);
}

.action-btn.primary {
  color: #06110b;
  background: linear-gradient(180deg, #67ffab, #1aca67);
  box-shadow: 0 0 18px rgba(57, 255, 136, 0.2);
}

.loading-state {
  padding: 16px;
}

.loading-card {
  border-radius: 22px;
  padding: 18px;
}

.loading-line {
  height: 12px;
  border-radius: 999px;
  background: linear-gradient(90deg, #13211a 0%, #1d3127 50%, #13211a 100%);
  background-size: 200% 100%;
  margin-bottom: 10px;
}

.loading-line-lg {
  width: 76%;
}

.loading-line-md {
  width: 58%;
}

.loading-line-sm {
  width: 42%;
}

.empty-state {
  margin: 16px;
  padding: 24px 18px;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f1fff4;
}

.empty-desc {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.65;
  color: rgba(204, 255, 221, 0.66);
}
