<view class="page" style="padding-top: {{statusBarHeight}}px;">
  <view class="bg"></view>
  <scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}">
    <view class="top-shell">
      <view class="nav">
        <view class="nav-btn" bindtap="goBack">←</view>
        <view class="nav-title">个人资料</view>
        <view class="nav-placeholder"></view>
      </view>

      <view class="hero">
        <view class="avatar-wrap">
          <view class="avatar-ring"></view>
          <button wx:if="{{!isApp}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="avatar-empty">
              <text class="avatar-empty-icon">🖼️</text>
            </view>
          </button>
          <button wx:else class="avatar-btn" bindtap="onPickAvatar">
            <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="avatar-empty">
              <text class="avatar-empty-icon">🖼️</text>
            </view>
          </button>
          <view class="avatar-status"></view>
        </view>

        <text class="hero-name">{{form.nickName || '未填写昵称'}}</text>
        <view class="hero-badge">
          <text class="hero-badge-text">LV.1 新手指南</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">基础信息</text>
        <text class="section-desc">完善资料，获得更贴心的养护建议</text>
      </view>

      <view class="field">
        <text class="field-label">昵称</text>
        <input
          type="nickname"
          class="field-input"
          placeholder="请输入昵称"
          placeholder-class="field-placeholder"
          value="{{form.nickName}}"
          bindinput="onNickNameChange"
          maxlength="20"
        />
      </view>

      <view class="field">
        <text class="field-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="field-picker">
            <text class="field-picker-text">{{genderOptions[genderIndex].label}}</text>
            <text class="field-picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">所在地</text>
        <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
          <view class="field-picker">
            <text class="field-picker-text">{{regionText || '请选择'}}</text>
            <text class="field-picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">生日</text>
        <picker mode="date" value="{{form.birthday}}" bindchange="onBirthdayChange">
          <view class="field-picker">
            <text class="field-picker-text">{{form.birthday || '请选择'}}</text>
            <text class="field-picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">种植经验</text>
        <picker mode="selector" range="{{experienceOptions}}" value="{{experienceIndex}}" bindchange="onExperienceChange">
          <view class="field-picker">
            <text class="field-picker-text">{{form.experienceLevel || '请选择'}}</text>
            <text class="field-picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="textarea-field">
        <text class="field-label">个人签名</text>
        <textarea
          class="textarea"
          placeholder="介绍一下你自己（可选）"
          placeholder-class="textarea-placeholder"
          value="{{form.signature}}"
          bindinput="onSignatureInput"
          maxlength="120"
          auto-height="true"
        />
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">联系方式</text>
        <text class="section-desc">便于后续消息通知与账号找回</text>
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" placeholder="选填" placeholder-class="field-placeholder" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="20" />
      </view>

      <view class="field">
        <text class="field-label">邮箱</text>
        <input class="field-input" type="text" placeholder="选填" placeholder-class="field-placeholder" value="{{form.email}}" bindinput="onEmailInput" maxlength="50" />
      </view>
    </view>

    <view class="footer-space"></view>
  </scroll-view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存资料</button>
  </view>
</view>
