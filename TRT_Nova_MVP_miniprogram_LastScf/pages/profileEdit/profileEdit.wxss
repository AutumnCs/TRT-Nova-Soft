page {
  background:
    linear-gradient(180deg, #071310 0%, #081612 44%, #091915 100%);
  color: #eafef3;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    linear-gradient(180deg, #071310 0%, #081612 44%, #091915 100%);
}

.bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(30, 255, 154, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(30, 255, 154, 0.08) 1px, transparent 1px);
  background-size: 84rpx 84rpx;
  background-position: -1px -1px;
  opacity: 0.85;
}

.bg::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(circle at 50% 0%, rgba(34, 255, 152, 0.12), transparent 26%),
    radial-gradient(circle at 82% 14%, rgba(44, 255, 166, 0.08), transparent 20%),
    radial-gradient(circle at 12% 18%, rgba(42, 255, 158, 0.08), transparent 24%);
}

.scroll-content {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.top-shell {
  position: relative;
  z-index: 1;
  padding: 0 24rpx 24rpx;
}

.nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.nav-btn,
.nav-placeholder {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.nav-btn {
  font-size: 42rpx;
  color: #31ff9a;
  background: rgba(0, 0, 0, 0.34);
  border: 2rpx solid rgba(26, 255, 149, 0.28);
  box-shadow: 0 0 26rpx rgba(17, 255, 140, 0.12);
  backdrop-filter: blur(12rpx);
}

.nav-btn::after {
  display: none;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #34ff9f;
  letter-spacing: 4rpx;
  text-shadow: 0 0 18rpx rgba(52, 255, 159, 0.38);
}

.hero {
  position: relative;
  margin: 10rpx 0 10rpx;
  padding: 42rpx 28rpx 34rpx;
  border-radius: 34rpx;
  border: 1.5rpx solid rgba(33, 255, 151, 0.2);
  background:
    linear-gradient(180deg, rgba(8, 18, 13, 0.92), rgba(3, 8, 6, 0.94));
  box-shadow:
    0 0 0 1rpx rgba(52, 255, 159, 0.06) inset,
    0 0 36rpx rgba(0, 255, 140, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -16rpx;
  top: 24rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 255, 152, 0.14), transparent 64%);
  filter: blur(12rpx);
}

.avatar-wrap {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 18rpx;
}

.avatar-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 3rpx solid rgba(58, 255, 155, 0.92);
  background: rgba(0, 0, 0, 0.22);
  box-shadow:
    0 0 0 10rpx rgba(58, 255, 155, 0.08),
    0 0 28rpx rgba(58, 255, 155, 0.22);
}

.avatar-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 0;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
}

.avatar-btn::after {
  display: none;
}

.avatar,
.avatar-empty {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar {
  object-fit: cover;
  background: #0c1411;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.22), transparent 30%),
    linear-gradient(180deg, #101d17, #07110d);
}

.avatar-empty-icon {
  font-size: 30rpx;
}

.avatar-status {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #3cff9f;
  border: 4rpx solid #071310;
  box-shadow: 0 0 18rpx rgba(57, 200, 113, 0.55);
}

.hero-name {
  margin-top: 2rpx;
  font-size: 36rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #f0fff8;
  text-shadow: 0 8rpx 24rpx rgba(18, 28, 22, 0.12);
}

.hero-badge {
  margin-top: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(58, 170, 92, 0.22);
  background: rgba(6, 15, 11, 0.72);
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.04) inset,
    0 8rpx 20rpx rgba(18, 28, 22, 0.12);
}

.hero-badge-text {
  color: #33ff9c;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1px;
}

.section-card {
  position: relative;
  z-index: 1;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 18rpx 10rpx;
  border-radius: 30rpx;
  border: 1.5rpx solid rgba(26, 255, 149, 0.16);
  background:
    linear-gradient(180deg, rgba(9, 18, 14, 0.9), rgba(4, 10, 8, 0.94));
  box-shadow:
    0 0 0 1rpx rgba(40, 255, 155, 0.04) inset,
    0 12rpx 36rpx rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(12rpx);
}

.section-head {
  margin-bottom: 10rpx;
  padding: 2rpx 2rpx 12rpx;
  border-bottom: 1rpx solid rgba(95, 143, 109, 0.1);
}

.section-title {
  display: block;
  font-size: 18px;
  font-weight: 900;
  color: #f0fff8;
}

.section-desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(220, 255, 240, 0.54);
  font-size: 12px;
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 54rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(95, 143, 109, 0.08);
}

.field:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}

.field-label {
  width: 92rpx;
  flex: none;
  color: rgba(235, 255, 244, 0.86);
  font-size: 14px;
  font-weight: 700;
}

.field-input,
.field-picker {
  width: 100%;
  min-height: 48rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background:
    linear-gradient(180deg, rgba(10, 20, 15, 0.92), rgba(6, 12, 9, 0.92));
  border: 1rpx solid rgba(95, 143, 109, 0.18);
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.03) inset,
    0 0 24rpx rgba(0, 255, 145, 0.06);
}

.field-input {
  padding: 0 14rpx;
  text-align: right;
  color: #f0fff8;
  font-size: 14px;
}

.field-placeholder,
.textarea-placeholder {
  color: rgba(220, 255, 240, 0.32);
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
}

.field-picker-text {
  font-size: 14px;
  color: #f0fff8;
}

.field-picker-arrow {
  font-size: 20px;
  color: #33ff9c;
}

.textarea-field {
  padding-top: 14rpx;
}

.textarea {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(180deg, rgba(10, 20, 15, 0.92), rgba(6, 12, 9, 0.92));
  border: 1rpx solid rgba(95, 143, 109, 0.18);
  color: #f0fff8;
  font-size: 14px;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.03) inset,
    0 0 24rpx rgba(0, 255, 145, 0.06);
}

.footer-space {
  height: 112rpx;
}

.bottom-bar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  padding: 14rpx 16rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: linear-gradient(180deg, rgba(7, 19, 15, 0.36), rgba(7, 19, 15, 0.94));
  border-top: 1rpx solid rgba(95, 143, 109, 0.12);
  backdrop-filter: blur(10px);
}

.save-btn {
  width: 100%;
  height: 54px;
  border-radius: 18px;
  border: none;
  background: linear-gradient(180deg, #38ff9f, #18c96e);
  color: #04110b;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 1px;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.08) inset,
    0 16rpx 28rpx rgba(11, 116, 58, 0.28),
    0 0 28rpx rgba(52, 255, 159, 0.12);
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  transform: scale(0.985);
}
.page { background: #f7edda; color: #191923; }.top-shell, .hero, .form-card, .field-card, .section { background: #fffdf7; border-color: #191923; box-shadow: 5rpx 5rpx 0 #2778c9; }.nav-title, .section-title, .field-label { color: #191923; }.hint, .field-desc { color: #626276; }.avatar-ring { border-color: #191923; box-shadow: 0 0 0 8rpx #ffe36e; }.avatar-btn, input, textarea { background: #fffdf7; color: #191923; border-color: #191923; }button, .save-btn, .submit-btn { background: #ef3d4b; color: #fffdf7; border: 3rpx solid #191923; box-shadow: 4rpx 4rpx 0 #ffe36e; }
