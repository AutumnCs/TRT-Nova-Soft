page {
  background: #f7edda;
  color: #191923;
}

.page {
  min-height: 100vh;
  background: #f7edda;
  box-sizing: border-box;
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 18px 10px;
  box-sizing: border-box;
}

.header-row {
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.eyebrow {
  display: block;
  font-size: 12px;
  color: rgba(190, 236, 205, 0.72);
}

.page-title {
  display: block;
  margin-top: 2px;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 800;
  color: #191923;
}

.count-pill {
  flex-shrink: 0;
  padding: 7px 11px;
  border-radius: 999px;
  font-size: 12px;
  color: #191923;
  background: #ffe36e;
  border: 3rpx solid #191923;
}

.search-box {
  margin-top: 14px;
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  border-radius: 14px;
  background: #fffdf7;
  border: 3rpx solid #191923;
  box-shadow: 4rpx 4rpx 0 #2778c9;
}

.search-icon {
  color: #ef3d4b;
  font-size: 18px;
}

.search-input {
  flex: 1;
  color: #191923;
  font-size: 14px;
}

.placeholder {
  color: #77768a;
}

.clear-btn {
  color: #ef3d4b;
  font-size: 12px;
}

.mode-grid {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.mode-card {
  min-height: 76px;
  padding: 14px;
  border-radius: 14px;
  box-sizing: border-box;
  background: #fffdf7;
  border: 3rpx solid #191923;
  box-shadow: 4rpx 4rpx 0 #c9c6bc;
}

.mode-card.active {
  background: #dff1d8;
  border-color: #191923;
  box-shadow: 4rpx 4rpx 0 #ef3d4b;
}

.mode-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #191923;
}

.mode-desc {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.45;
  color: #6b6b7c;
}

.filter-strip {
  margin-top: 12px;
}

.chip-scroll {
  white-space: nowrap;
}

.chip-row {
  display: flex;
  gap: 8px;
}

.chip-row.nowrap {
  flex-wrap: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 34px;
  padding: 0 13px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  color: #626276;
  background: #fffdf7;
  border: 2rpx solid #191923;
}

.chip.active {
  color: #191923;
  background: #ffe36e;
  border-color: #191923;
}

.content {
  height: calc(100vh - 214px);
  padding: 8px 18px 108px;
  box-sizing: border-box;
}

.article-list,
.plant-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.article-card,
.plant-card,
.loading-panel,
.empty-panel {
  border-radius: 14px;
  background: #fffdf7;
  border: 3rpx solid #191923;
  box-shadow: 5rpx 5rpx 0 #2778c9;
}

.article-card {
  padding: 15px;
}

.article-topline,
.plant-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.article-category,
.article-more,
.difficulty {
  font-size: 12px;
  color: #ef3d4b;
}

.article-title {
  display: block;
  margin-top: 8px;
  font-size: 17px;
  line-height: 1.42;
  font-weight: 800;
  color: #191923;
}

.article-summary {
  display: block;
  margin-top: 7px;
  font-size: 13px;
  line-height: 1.65;
  color: #626276;
}

.meta-row,
.care-row {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.meta-chip,
.care-chip {
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: #191923;
  background: #ffe36e;
}

.plant-card {
  padding: 12px;
  display: flex;
  gap: 12px;
}

.plant-thumb {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border-radius: 12px;
  background: #dff1d8;
}

.plant-info {
  min-width: 0;
  flex: 1;
}

.plant-name {
  min-width: 0;
  font-size: 16px;
  font-weight: 800;
  color: #191923;
}

.plant-family {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: rgba(226, 255, 235, 0.52);
}

.eyebrow { color: #2778c9; font-weight: 800; letter-spacing: 2rpx; }.article-list, .plant-list { gap: 16rpx; }.empty-panel { color: #191923; }.empty-title { color: #191923; }.empty-desc { color: #6b6b7c; }

.plant-desc {
  display: -webkit-box;
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
  color: rgba(226, 255, 235, 0.68);
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.loading-panel,
.empty-panel {
  padding: 18px;
}

.loading-line {
  height: 12px;
  border-radius: 999px;
  background: #17271e;
  margin-bottom: 10px;
}

.loading-line-lg {
  width: 72%;
}

.loading-line-md {
  width: 52%;
}

.loading-card {
  height: 90px;
  border-radius: 12px;
  margin-top: 12px;
  background: #17271e;
}

.empty-panel {
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f1fff4;
}

.empty-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.6;
  color: rgba(226, 255, 235, 0.62);
}

/* Final readability pass: legacy dark rules above must not win on the paper theme. */
.plant-family, .plant-desc, .article-summary, .mode-desc, .empty-desc { color: #4f5363 !important; }
.article-title, .plant-name, .empty-title, .mode-title, .page-title { color: #191923 !important; }
.article-category, .article-more, .difficulty { color: #c6283b !important; }
.meta-chip, .care-chip { color: #191923 !important; background: #ffe36e !important; }
.loading-panel, .empty-panel { background: #fffdf7 !important; border: 3rpx solid #191923 !important; box-shadow: 5rpx 5rpx 0 #2778c9 !important; }
.loading-line, .loading-card { background: #dcebd3 !important; }
.search-input { color: #191923 !important; }.placeholder { color: #5f6272 !important; opacity: 1 !important; }
