page {
  background: #07110d;
  color: #e9fff0;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, rgba(24, 55, 38, 0.92) 0%, #07110d 220px), #07110d;
  box-sizing: border-box;
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 18px 10px;
  box-sizing: border-box;
}

.header-row {
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.eyebrow {
  display: block;
  font-size: 12px;
  color: rgba(190, 236, 205, 0.72);
}

.page-title {
  display: block;
  margin-top: 2px;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 800;
  color: #f6fff8;
}

.count-pill {
  flex-shrink: 0;
  padding: 7px 11px;
  border-radius: 999px;
  font-size: 12px;
  color: #80e9aa;
  background: rgba(7, 17, 13, 0.72);
  border: 1px solid rgba(128, 233, 170, 0.22);
}

.search-box {
  margin-top: 14px;
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.search-icon {
  color: #83e9ad;
  font-size: 18px;
}

.search-input {
  flex: 1;
  color: #f7fff9;
  font-size: 14px;
}

.placeholder {
  color: rgba(229, 255, 237, 0.45);
}

.clear-btn {
  color: #7ee6a8;
  font-size: 12px;
}

.mode-grid {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.mode-card {
  min-height: 76px;
  padding: 14px;
  border-radius: 14px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.mode-card.active {
  background: rgba(42, 214, 114, 0.18);
  border-color: rgba(80, 236, 143, 0.45);
}

.mode-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f5fff7;
}

.mode-desc {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.45;
  color: rgba(222, 255, 233, 0.62);
}

.filter-strip {
  margin-top: 12px;
}

.chip-scroll {
  white-space: nowrap;
}

.chip-row {
  display: flex;
  gap: 8px;
}

.chip-row.nowrap {
  flex-wrap: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 34px;
  padding: 0 13px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  color: rgba(221, 255, 232, 0.72);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.chip.active {
  color: #06110b;
  background: #45e889;
  border-color: #45e889;
}

.content {
  height: calc(100vh - 214px);
  padding: 8px 18px 108px;
  box-sizing: border-box;
}

.article-list,
.plant-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.article-card,
.plant-card,
.loading-panel,
.empty-panel {
  border-radius: 14px;
  background: #0d1a14;
  border: 1px solid rgba(119, 209, 150, 0.16);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
}

.article-card {
  padding: 15px;
}

.article-topline,
.plant-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.article-category,
.article-more,
.difficulty {
  font-size: 12px;
  color: #78dfa1;
}

.article-title {
  display: block;
  margin-top: 8px;
  font-size: 17px;
  line-height: 1.42;
  font-weight: 800;
  color: #f4fff7;
}

.article-summary {
  display: block;
  margin-top: 7px;
  font-size: 13px;
  line-height: 1.65;
  color: rgba(226, 255, 235, 0.68);
}

.meta-row,
.care-row {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.meta-chip,
.care-chip {
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: rgba(217, 255, 229, 0.78);
  background: rgba(255, 255, 255, 0.06);
}

.plant-card {
  padding: 12px;
  display: flex;
  gap: 12px;
}

.plant-thumb {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border-radius: 12px;
  background: #14251b;
}

.plant-info {
  min-width: 0;
  flex: 1;
}

.plant-name {
  min-width: 0;
  font-size: 16px;
  font-weight: 800;
  color: #f4fff7;
}

.plant-family {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: rgba(226, 255, 235, 0.52);
}

.plant-desc {
  display: -webkit-box;
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
  color: rgba(226, 255, 235, 0.68);
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.loading-panel,
.empty-panel {
  padding: 18px;
}

.loading-line {
  height: 12px;
  border-radius: 999px;
  background: #17271e;
  margin-bottom: 10px;
}

.loading-line-lg {
  width: 72%;
}

.loading-line-md {
  width: 52%;
}

.loading-card {
  height: 90px;
  border-radius: 12px;
  margin-top: 12px;
  background: #17271e;
}

.empty-panel {
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f1fff4;
}

.empty-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.6;
  color: rgba(226, 255, 235, 0.62);
}
