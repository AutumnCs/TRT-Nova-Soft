<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-row">
      <view>
        <text class="eyebrow">内容中心</text>
        <text class="page-title">知识库</text>
      </view>
      <view class="count-pill">{{countText}}</view>
    </view>

    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        placeholder="{{searchPlaceholder}}"
        placeholder-class="placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearch"
      />
      <view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearFilters">清除</view>
    </view>

    <view class="mode-grid">
      <view class="mode-card {{currentMode === 'articles' ? 'active' : ''}}" bindtap="switchToArticles">
        <text class="mode-title">知识文章</text>
        <text class="mode-desc">养护、设备字段、系统规则</text>
      </view>
      <view class="mode-card {{currentMode === 'plants' ? 'active' : ''}}" bindtap="switchToPlants">
        <text class="mode-title">植物库</text>
        <text class="mode-desc">植物资料、养护参数、常见问题</text>
      </view>
    </view>

    <view wx:if="{{currentMode === 'articles'}}" class="filter-strip">
      <scroll-view scroll-x="true" show-scrollbar="{{false}}" class="chip-scroll">
        <view class="chip-row nowrap">
          <view
            wx:for="{{categories}}"
            wx:key="value"
            class="chip {{activeCategory === item.value ? 'active' : ''}}"
            bindtap="setCategory"
            data-category="{{item.value}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <scroll-view scroll-y="true" class="content" show-scrollbar="{{false}}">
    <view wx:if="{{currentMode === 'articles'}}">
      <view wx:if="{{loading && filteredArticles.length === 0}}" class="loading-panel">
        <view class="loading-line loading-line-lg"></view>
        <view class="loading-line loading-line-md"></view>
        <view class="loading-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>

      <view wx:elif="{{filteredArticles.length > 0}}" class="article-list">
        <view
          wx:for="{{filteredArticles}}"
          wx:key="id"
          class="article-card"
          bindtap="openArticle"
          data-id="{{item.id}}"
        >
          <view class="article-topline">
            <text class="article-category">{{item.displayCategory || item.category}}</text>
            <text class="article-more">查看</text>
          </view>
          <text class="article-title">{{item.title}}</text>
          <text class="article-summary">{{item.summary}}</text>
          <view class="meta-row">
            <text wx:for="{{item.tags}}" wx:key="*this" class="meta-chip">{{item}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="empty-panel">
        <text class="empty-title">没有找到相关文章</text>
        <text class="empty-desc">换一个关键词，或者清除当前筛选后再试。</text>
      </view>
    </view>

    <view wx:else>
      <view wx:if="{{plantLoading && filteredPlants.length === 0}}" class="loading-panel">
        <view class="loading-line loading-line-lg"></view>
        <view class="loading-line loading-line-md"></view>
        <view class="loading-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>

      <view wx:elif="{{filteredPlants.length > 0}}" class="plant-list">
        <view wx:for="{{filteredPlants}}" wx:key="id" class="plant-card">
          <image class="plant-thumb" src="{{item.image || '/images/plant-default.jpg'}}" mode="aspectFill"></image>
          <view class="plant-info">
            <view class="plant-title-row">
              <text class="plant-name">{{item.name}}</text>
              <text class="difficulty">{{item.difficulty || '通用'}}</text>
            </view>
            <text class="plant-family">{{item.family || item.scientificName}}</text>
            <text class="plant-desc">{{item.featureText || item.description}}</text>
            <view class="care-row">
              <text wx:if="{{item.care.light}}" class="care-chip">光照 {{item.care.light}}</text>
              <text wx:if="{{item.care.water}}" class="care-chip">浇水 {{item.care.water}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-panel">
        <text class="empty-title">没有找到植物资料</text>
        <text class="empty-desc">换一个植物名称、科属或特征关键词再试。</text>
      </view>
    </view>
  </scroll-view>
</view>
