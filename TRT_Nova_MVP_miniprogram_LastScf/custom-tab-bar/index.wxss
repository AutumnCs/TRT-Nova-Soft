.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 16rpx calc(env(safe-area-inset-bottom) + 8rpx);
  box-sizing: border-box;
  pointer-events: none;
}

.tab-bar {
  pointer-events: auto;
  height: 118rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(9, 14, 15, 0.92) 0%, rgba(7, 11, 12, 0.98) 100%);
  border: 1rpx solid rgba(50, 255, 143, 0.22);
  box-shadow:
    0 -8rpx 28rpx rgba(0, 0, 0, 0.35),
    inset 0 0 0 1rpx rgba(50, 255, 143, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  overflow: hidden;
}

.tab-bar::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(57, 255, 136, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(57, 255, 136, 0.08) 1rpx, transparent 1rpx);
  background-size: 24rpx 24rpx;
  opacity: 0.45;
  pointer-events: none;
}

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: rgba(181, 192, 188, 0.78);
  height: 100%;
}

.tab-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(9, 16, 18, 0.92);
  border: 1rpx solid rgba(57, 255, 136, 0.12);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.02);
  transition: all 0.22s ease;
}

.tab-icon {
  font-size: 30rpx;
  line-height: 1;
  color: currentColor;
  font-weight: 700;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.tab-indicator {
  width: 54rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: transparent;
  box-shadow: 0 0 0 rgba(57, 255, 136, 0);
  transition: all 0.22s ease;
}

.tab-item.active {
  color: #39ff88;
}

.tab-item.active .tab-icon-wrap {
  background: rgba(10, 24, 16, 0.98);
  border-color: rgba(57, 255, 136, 0.5);
  box-shadow:
    0 0 18rpx rgba(57, 255, 136, 0.16),
    inset 0 0 0 1rpx rgba(57, 255, 136, 0.2);
  transform: translateY(-2rpx);
}

.tab-item.active .tab-indicator {
  background: linear-gradient(90deg, rgba(57, 255, 136, 0), #39ff88, rgba(57, 255, 136, 0));
  box-shadow: 0 0 18rpx rgba(57, 255, 136, 0.85);
}

.tab-item:active .tab-icon-wrap {
  transform: scale(0.96);
}
