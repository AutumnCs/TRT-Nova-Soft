.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 132rpx;
  padding: 0 18rpx 10rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.tab-bar {
  width: 100%;
  height: 116rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-around;
  box-sizing: border-box;
  overflow: hidden;
  pointer-events: auto;
  border: 4rpx solid #191923;
  border-radius: 30rpx;
  background: #fff7e7;
  box-shadow: 6rpx 6rpx 0 #2778c9, -4rpx -3rpx 0 #ef3d4b;
}

.tab-item {
  position: relative;
  z-index: 1;
  width: 25%;
  flex: 1 1 25%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #626276;
}

.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid #191923;
  border-radius: 16rpx;
  background: #f4e7cc;
  box-shadow: 3rpx 3rpx 0 #c9c6bc;
}

.tab-icon {
  color: currentColor;
  font-size: 31rpx;
  line-height: 1;
  font-weight: 800;
}

.tab-text {
  margin-top: 7rpx;
  color: currentColor;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
}

.tab-indicator {
  width: 46rpx;
  height: 6rpx;
  margin-top: 7rpx;
  border-radius: 999rpx;
  background: transparent;
}

.tab-item.active { color: #191923; }
.tab-item.active .tab-icon-wrap { background: #ffe36e; box-shadow: 3rpx 3rpx 0 #ef3d4b; }
.tab-item.active .tab-indicator { background: #ef3d4b; }
.tab-item:active .tab-icon-wrap { opacity: .8; }
