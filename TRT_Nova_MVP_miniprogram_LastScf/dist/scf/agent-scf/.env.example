# agent-scf 环境变量示例

# 数据库连接
DB_HOST=<mysql-host>
DB_PORT=3306
DB_NAME=<mysql-database>
DB_USER=<mysql-user>
DB_PASSWORD=<mysql-password>
DB_CONN_LIMIT=5

# 鉴权
JWT_SECRET=<jwt-secret>

# 仅隔离开发环境可显式开启；生产环境保持 0
ALLOW_LEGACY_OPENID_FALLBACK=0
DEBUG_OPENID=<debug-openid>

# 普通对话 API，可接 OpenAI-compatible Chat Completions 服务
LLM_API_ENABLED=false
LLM_API_BASE_URL=https://api.example.com
LLM_API_PATH=/v1/chat/completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500
LLM_TIMEOUT_MS=12000
