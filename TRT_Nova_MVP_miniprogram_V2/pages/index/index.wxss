/* ================= 首页 · 双主题（浅色元气日光 / 深色萤火温室） ================= */

/* ---------- 浅色变量 ---------- */
.theme-light {
  --bg: #F7F5EE;
  --jelly: #FFFFFF;
  --jelly2: #EFEBDD;
  --line: #3A423C;
  --line2: #C8C2B2;
  --text: #2A332D;
  --text2: #7C837B;
  --matcha: #2FA266;
  --matcha-deep: #2E8259;
  --matcha-soft: rgba(47, 162, 102, 0.12);
  --matcha-ink: #EAF6EF;
  --peach: #F0A487;
  --peach-deep: #D96A45;
  --peach-soft: rgba(240, 164, 135, 0.14);
  --warn: #C05B3C;
  --sky: linear-gradient(180deg, #E9E2CE 0%, #F2EFE5 60%, #F7F5EE 100%);
  --shadow-sm: 0 6px 18rpx rgba(52, 66, 58, 0.06);
}

/* ---------- 深色变量（萤火温室） ---------- */
.theme-dark {
  --bg: #0C1410;
  --jelly: #132019;
  --jelly2: #1A2C21;
  --line: #26402F;
  --line2: #31523B;
  --text: #EAF3EA;
  --text2: #93A896;
  --matcha: #7FE0A8;
  --matcha-deep: #5EC98A;
  --matcha-soft: rgba(127, 224, 168, 0.13);
  --matcha-ink: #0A2318;
  --peach: #F5B87A;
  --peach-deep: #E8A05F;
  --peach-soft: rgba(245, 184, 122, 0.12);
  --gold: #F5D98B;
  --gold-soft: rgba(245, 217, 139, 0.13);
  --warn: #E8A05F;
  --warn-soft: rgba(232, 160, 95, 0.12);
  --danger: #F08E82;
  --surface: #132019;
  --surface2: #1A2C21;
  --border: #26402F;
  --border2: #31523B;
  --accent: #7FE0A8;
  --accent-soft: rgba(127, 224, 168, 0.13);
  --stage: radial-gradient(130% 100% at 50% 0%, #183723 0%, #0E1B13 62%, #0A120D 100%);
  --sky: radial-gradient(130% 100% at 50% 0%, #183723 0%, #0E1B13 62%, #0A120D 100%);
  --shadow-sm: 0 12px 44rpx rgba(0, 0, 0, 0.35);
}

/* ---------- 容器 ---------- */
.container {
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  background-image: radial-gradient(rgba(47, 162, 102, 0.045) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
  box-sizing: border-box;
}
.theme-dark.container {
  background-image: radial-gradient(rgba(127, 224, 168, 0.05) 2rpx, transparent 2rpx);
}
.ppad { padding: 12rpx 32rpx 0; }

/* ---------- 主题切换按钮 ---------- */
.theme-btn {
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
  background: var(--jelly2); border: 2rpx solid var(--line2);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.theme-dark .theme-btn { border-color: rgba(245, 217, 139, 0.35); background: rgba(245, 217, 139, 0.08); }

/* ---------- 状态点 ---------- */
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--text2); flex: none; }
.dot.on { background: var(--matcha); box-shadow: 0 0 12rpx rgba(47, 162, 102, 0.6); }
.theme-dark .dot.on { background: var(--gold); box-shadow: 0 0 12rpx rgba(245, 217, 139, 0.6); }
.dot.off { background: var(--warn); }
.dot.off-warn { background: var(--warn); }

/* ================= 浅色 · 元气日光 ================= */

/* 顶栏 */
.l-top { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 4rpx 20rpx; }
.l-top-l { display: flex; flex-direction: column; gap: 6rpx; }
.l-hello { font-size: 36rpx; font-weight: 700; color: var(--text); font-family: var(--font-serif); letter-spacing: 2rpx; }
.l-date { font-size: 21rpx; color: var(--text2); }
.l-top-r { display: flex; gap: 14rpx; }
.l-signal { width: 68rpx; height: 68rpx; border-radius: 10rpx; background: var(--jelly2); border: 2rpx solid var(--line2); display: flex; align-items: center; justify-content: center; }
.l-signal-ico { font-size: 30rpx; color: var(--matcha-deep); }

/* 植宠选择 */
.l-picker { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; background: var(--jelly); border: 2rpx solid var(--line2); border-radius: 14rpx; margin-bottom: 20rpx; }
.l-picker-txt { display: flex; flex-direction: column; gap: 4rpx; }
.l-picker-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.l-picker-meta { font-size: 21rpx; color: var(--text2); }
.l-picker-arrow { font-size: 26rpx; color: var(--text2); }

/* Live 舞台 */
.l-stage { position: relative; height: 704rpx; border-radius: 56rpx; overflow: hidden; background: var(--sky); }
.cloud { position: absolute; background: rgba(255, 255, 255, 0.9); border-radius: 50%; z-index: 1; animation: drift 22s linear infinite; }
.cloud.c1 { width: 120rpx; height: 44rpx; top: 104rpx; }
.cloud.c2 { width: 88rpx; height: 34rpx; top: 192rpx; animation-delay: -9s; animation-duration: 30s; opacity: 0.75; }
.cloud.c3 { width: 140rpx; height: 48rpx; top: 64rpx; animation-delay: -16s; animation-duration: 26s; opacity: 0.6; }
.cloud::before { content: ''; position: absolute; left: 28rpx; top: -18rpx; width: 44rpx; height: 36rpx; background: inherit; border-radius: 50%; }
.sun { position: absolute; top: 48rpx; right: 52rpx; width: 124rpx; height: 124rpx; z-index: 1; }
.sun .rays { position: absolute; inset: -16rpx; animation: spin 26s linear infinite; }
.sun .rays i { position: absolute; left: 50%; top: 0; width: 6rpx; height: 18rpx; margin-left: -3rpx; border-radius: 4rpx; background: #FFC94D; transform-origin: 50% 78rpx; }
.sun .core { position: absolute; inset: 16rpx; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #FFE3A0, #FFC94D); box-shadow: 0 0 48rpx rgba(255, 201, 77, 0.55); }
.hill { position: absolute; bottom: -52rpx; left: -80rpx; right: -80rpx; height: 176rpx; border-radius: 50%; background: linear-gradient(180deg, #7CC98F, #5BAE74); z-index: 2; }
.hill::after { content: ''; position: absolute; bottom: -36rpx; left: 8%; right: 8%; height: 120rpx; border-radius: 50%; background: #4E9E66; }
.rec-chip { position: absolute; top: 32rpx; left: 32rpx; z-index: 3; display: inline-flex; align-items: center; gap: 10rpx; height: 52rpx; padding: 0 22rpx; border-radius: 26rpx; background: rgba(255, 255, 255, 0.88); font-size: 19rpx; font-weight: 700; color: var(--text); }
.l-stage-wrap { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding-bottom: 16rpx; }
.l-bubble { position: relative; z-index: 3; margin-bottom: 20rpx; padding: 18rpx 32rpx; border-radius: 36rpx 36rpx 36rpx 10rpx; background: #FFFFFF; border: 3rpx solid var(--peach); color: var(--peach-deep); font-size: 25rpx; font-weight: 700; animation: bounce2 3.8s ease-in-out infinite; box-shadow: 0 12rpx 32rpx rgba(255, 146, 104, 0.18); }
/* 植宠立于草地：底部沉入山丘（z-index 低于山丘），像站在草地上 */
.l-pet-ring { position: relative; z-index: 1; width: 300rpx; height: 300rpx; border-radius: 50%; overflow: hidden; margin-top: 140rpx; border: 6rpx solid rgba(255, 255, 255, 0.9); box-sizing: border-box; filter: drop-shadow(0 24rpx 32rpx rgba(46, 107, 71, 0.35)); animation: breathe 3.6s ease-in-out infinite; }
.l-pet { width: 100%; height: 100%; }
.l-mood { position: relative; z-index: 3; margin-top: 20rpx; font-size: 23rpx; color: var(--text2); }
.l-hearts { position: absolute; bottom: 32rpx; left: 32rpx; z-index: 3; display: inline-flex; align-items: center; gap: 14rpx; height: 64rpx; padding: 0 26rpx; border-radius: 32rpx; background: rgba(255, 255, 255, 0.88); font-size: 22rpx; font-weight: 700; color: var(--matcha-deep); }
.l-hearts .ico { width: 26rpx; height: 26rpx; }
.l-hearts .track { width: 144rpx; height: 14rpx; border-radius: 8rpx; background: var(--jelly2); overflow: hidden; }
.l-hearts .fill { display: block; height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #F2AE2E, #FF9268); }
.l-face { position: absolute; bottom: 32rpx; right: 32rpx; z-index: 3; width: 84rpx; height: 84rpx; border-radius: 42rpx; background: rgba(255, 255, 255, 0.88); display: flex; align-items: center; justify-content: center; font-size: 40rpx; }

/* 挂绳吊牌传感 */
.l-dd { position: relative; margin-top: 32rpx; padding: 12rpx 20rpx 20rpx; background: #FAF8F1; border: 2rpx solid #3A423C; border-radius: 12rpx; box-shadow: var(--shadow-sm); }
.l-dd-tag { position: absolute; top: -18rpx; left: 28rpx; z-index: 3; background: #3A423C; color: #FAF8F1; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; padding: 6rpx 20rpx; border-radius: 6rpx; }
.pegboard { position: relative; display: flex; gap: 14rpx; padding-top: 28rpx; }
.pegboard::before { content: ''; position: absolute; top: 8rpx; left: 4%; right: 4%; height: 2rpx; background: #9A9280; }
.peg { position: relative; flex: 1; background: #FAF8F1; border: 2rpx solid #3A423C; border-radius: 0 0 12rpx 12rpx; padding: 10rpx 8rpx 16rpx; text-align: center; box-shadow: 0 4rpx 12rpx rgba(52, 66, 58, 0.06); }
.peg .ph { width: 10rpx; height: 10rpx; border: 2rpx solid #3A423C; border-radius: 50%; background: var(--bg); margin: -24rpx auto 10rpx; position: relative; z-index: 2; }
.peg-ico { width: 36rpx; height: 36rpx; margin: 0 auto; color: var(--matcha-deep); }
.peg .pn { font-size: 30rpx; font-weight: 700; color: var(--text); line-height: 1.1; font-family: var(--font-num); letter-spacing: 0.5rpx; }
.peg .pn i { font-style: normal; font-size: 18rpx; color: var(--text2); font-weight: 500; }
.peg .pl { font-size: 18rpx; color: var(--text2); margin-top: 6rpx; letter-spacing: 2rpx; }
.l-dd-foot { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; font-size: 20rpx; color: var(--text2); padding: 0 8rpx; }
.l-more { margin-left: auto; font-size: 21rpx; color: var(--matcha-deep); }

/* AI 便签 */
.l-sticky { position: relative; margin-top: 28rpx; background: #F2E9D8; border: 2rpx solid #C8C2B2; padding: 26rpx 30rpx; font-size: 24rpx; line-height: 1.8; color: var(--text); box-shadow: 0 6rpx 20rpx rgba(52, 66, 58, 0.08); }
.l-sticky .sk { font-size: 20rpx; font-weight: 700; color: #7A6A45; letter-spacing: 4rpx; margin-bottom: 10rpx; }

/* 无设备引导 */
.l-noguide { margin-top: 28rpx; padding: 40rpx 30rpx; background: var(--jelly); border: 2rpx dashed var(--line2); border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.l-noguide-ico { width: 64rpx; height: 64rpx; color: var(--text2); }
.l-noguide-t { font-size: 28rpx; font-weight: 700; color: var(--text); }
.l-noguide-d { font-size: 22rpx; color: var(--text2); }

/* 折叠通用 */
.sec-fold { margin-top: 32rpx; }
.fold-summary { cursor: pointer; }
.fs-head { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.fs-title { font-size: 28rpx; font-weight: 700; color: var(--text); font-family: var(--font-serif); }
.fold-arr { font-size: 26rpx; color: var(--text2); transition: transform 0.25s; display: inline-block; }
.fold-arr.up { transform: rotate(180deg); }
.fold-body { display: none; margin-top: 20rpx; }
.sec-fold.open .fold-body { display: block; }
.sec-fold.open .fold-arr { transform: rotate(180deg); }
.brief-row { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; font-size: 24rpx; color: var(--text); min-height: 44rpx; }
.brief-row .b-main { font-weight: 700; }
.brief-row .b-tag { font-size: 19rpx; font-weight: 700; color: var(--peach-deep); background: var(--peach-soft); padding: 4rpx 16rpx; border-radius: 18rpx; letter-spacing: 2rpx; }
.brief-row .hint { margin-left: auto; font-size: 21rpx; color: var(--text2); }

/* 待办录入 */
.l-composer { background: var(--jelly); border: 2rpx solid var(--line2); border-radius: 14rpx; padding: 22rpx; }
.l-composer-t { font-size: 24rpx; font-weight: 700; color: var(--text); margin-bottom: 14rpx; display: block; }
.l-composer.dark { background: var(--surface2); border-color: var(--border2); }
.l-input { height: 72rpx; background: var(--bg); border: 2rpx solid var(--line2); border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; color: var(--text); }
.l-composer-acts { display: flex; gap: 16rpx; margin-top: 16rpx; }
.l-cancel { flex: 1; height: 68rpx; line-height: 68rpx; font-size: 24rpx; background: var(--jelly2); color: var(--text2); border: 0; border-radius: 12rpx; padding: 0; }
.l-confirm { flex: 1; height: 68rpx; line-height: 68rpx; font-size: 24rpx; background: var(--matcha); color: var(--matcha-ink); border: 0; border-radius: 12rpx; padding: 0; font-weight: 700; }
.l-add { margin-top: 16rpx; height: 72rpx; border: 2rpx dashed var(--line2); border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text2); }

/* 待办任务 */
.l-task { display: flex; align-items: center; gap: 22rpx; background: var(--jelly); border: 2rpx solid var(--line2); border-radius: 12rpx; padding: 22rpx 26rpx; margin-top: 20rpx; }
.l-task-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.l-task-title { font-size: 28rpx; font-weight: 700; color: var(--text); font-family: var(--font-serif); }
.l-task-desc { font-size: 21rpx; color: var(--text2); }
.l-task-desc.warn { color: var(--warn); }
.l-sticker { font-size: 20rpx; font-weight: 700; color: var(--warn); border: 2rpx solid var(--warn); padding: 6rpx 18rpx; border-radius: 4rpx; transform: rotate(-2deg); }
.l-empty { margin-top: 20rpx; padding: 30rpx 0; text-align: center; font-size: 22rpx; color: var(--text2); }

.task-check { width: 60rpx; height: 60rpx; border-radius: 50%; border: 2rpx dashed var(--line2); display: flex; align-items: center; justify-content: center; flex: none; font-size: 28rpx; color: var(--text2); background: transparent; }
.task-check.done { border-color: transparent; background: radial-gradient(circle, var(--peach-soft), transparent); color: var(--peach-deep); }

/* 设备横滑 */
.l-devband { display: flex; gap: 16rpx; margin-top: 20rpx; overflow-x: auto; }
.l-devcard { flex: none; width: 264rpx; border: 2rpx solid var(--line); border-radius: 8rpx; background: #FAF8F1; padding: 18rpx; }
.l-devcard-h { display: flex; justify-content: space-between; align-items: center; }
.l-devcard-n { font-size: 24rpx; font-weight: 700; color: var(--text); }
.l-devcard-d { font-size: 19rpx; color: var(--text2); margin-top: 8rpx; display: block; }
.l-devadd { flex: none; width: 112rpx; border: 2rpx dashed var(--line); border-radius: 8rpx; display: flex; align-items: center; justify-content: center; color: var(--text2); font-size: 32rpx; }

/* 台扇（拉绳开关） */
.l-fan .l-fan-row { display: flex; gap: 28rpx; align-items: center; padding-top: 16rpx; }
.sfan { position: relative; display: flex; flex-direction: column; align-items: center; flex: none; }
.sfan .guard { position: relative; width: 128rpx; height: 128rpx; border: 3rpx solid #3A423C; border-radius: 50%; background: #FAF8F1; display: flex; align-items: center; justify-content: center; }
.sfan .guard::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(rgba(58, 66, 60, 0.12) 0 1deg, transparent 1deg 10deg); z-index: 2; }
.sfan .blade { width: 84rpx; height: 84rpx; color: var(--matcha); position: relative; z-index: 1; }
.l-fan.is-off .sfan .blade { color: var(--text2); }
.sfan .pole { width: 8rpx; height: 28rpx; background: #3A423C; }
/* 拉绳开关：绳 + 拉头 */
.sfan .cord { position: absolute; right: -22rpx; top: 16rpx; display: flex; flex-direction: column; align-items: center; z-index: 3; }
.sfan .cord::before { content: ''; width: 2rpx; height: 30rpx; background: #3A423C; }
.sfan .cord i { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--matcha); border: 2rpx solid #3A423C; box-sizing: border-box; }
.l-fan.is-off .sfan .cord i { background: var(--text2); }
.sfan .base { width: 88rpx; height: 10rpx; background: #3A423C; border-radius: 4rpx; }
.l-fan-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.l-fan-name { font-size: 30rpx; font-weight: 700; color: var(--text); font-family: var(--font-serif); }
.l-fan-state { font-size: 23rpx; color: var(--matcha-deep); font-weight: 600; }
.l-fan.is-off .l-fan-state { color: var(--text2); }
.l-fan-hint { font-size: 20rpx; color: var(--text2); }

/* ================= 深色 · 萤火温室 ================= */

/* 守夜手记 */
.nw { text-align: center; font-size: 17rpx; letter-spacing: 4rpx; color: rgba(245, 217, 139, 0.45); padding: 10rpx 12rpx; font-weight: 600; position: relative; z-index: 2; }

/* 萤火虫（页面漂浮） */
.ff { position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--gold); box-shadow: 0 0 20rpx 8rpx rgba(245, 217, 139, 0.5); animation: fly 9s ease-in-out infinite; z-index: 1; pointer-events: none; }
.ff.f1 { left: 14%; top: 24%; }
.ff.f2 { right: 11%; top: 38%; animation-delay: 3.5s; animation-duration: 11s; }

/* 顶栏 */
.d-top { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.d-top-l { display: flex; flex-direction: column; gap: 6rpx; }
.d-top-k { font-size: 19rpx; letter-spacing: 4rpx; color: var(--text2); font-weight: 600; }
.d-top-t { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.d-top-name { font-size: 30rpx; font-weight: 800; color: var(--text); }
.d-top-meta { font-size: 22rpx; color: var(--text2); font-weight: 500; }
.d-top-r { display: flex; gap: 14rpx; }
.d-signal { width: 72rpx; height: 72rpx; border-radius: 26rpx; background: var(--surface); border: 2rpx solid var(--border); display: flex; align-items: center; justify-content: center; animation: breathe 3s infinite; }
.d-signal text { font-size: 28rpx; color: var(--accent); }

/* 星空草地 */
.d-stage { position: relative; height: 504rpx; border-radius: 56rpx; margin-top: 24rpx; background: var(--stage); overflow: hidden; }
.starfield { position: absolute; inset: 0; pointer-events: none; z-index: 1;
  background-image:
    radial-gradient(3rpx 3rpx at 12% 18%, rgba(234, 243, 234, 0.85) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 28% 9%, rgba(234, 243, 234, 0.55) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 44% 22%, rgba(245, 217, 139, 0.75) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 61% 7%, rgba(234, 243, 234, 0.5) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 74% 16%, rgba(234, 243, 234, 0.8) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 87% 26%, rgba(245, 217, 139, 0.6) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 8% 42%, rgba(234, 243, 234, 0.45) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 92% 48%, rgba(234, 243, 234, 0.7) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 36% 38%, rgba(234, 243, 234, 0.4) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 68% 34%, rgba(245, 217, 139, 0.5) 50%, transparent 51%);
  animation: twinkle 4.5s ease-in-out infinite; }
.starfield.s2 { animation-delay: 2.2s; animation-duration: 6s; transform: scaleX(-1); }
.shoot { position: absolute; top: 14%; left: -10%; width: 92rpx; height: 3rpx; background: linear-gradient(90deg, transparent, rgba(234, 243, 234, 0.9)); border-radius: 4rpx; transform: rotate(14deg); animation: shoot 7s ease-in infinite; pointer-events: none; z-index: 1; }
.shoot.s2 { animation-delay: 3.8s; left: 34%; }
.shoot::after { content: ''; position: absolute; right: -4rpx; top: -2.5rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.95); }
.moon { position: absolute; right: 52rpx; top: 44rpx; width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--gold); opacity: 0.85; box-shadow: 0 0 48rpx 12rpx rgba(245, 217, 139, 0.35); z-index: 1; }
.moon i { position: absolute; border-radius: 50%; background: rgba(12, 20, 16, 0.16); }
.moon i:nth-child(1) { width: 14rpx; height: 14rpx; left: 14rpx; top: 18rpx; }
.moon i:nth-child(2) { width: 8rpx; height: 8rpx; left: 38rpx; top: 36rpx; }
.moon i:nth-child(3) { width: 10rpx; height: 10rpx; left: 24rpx; top: 46rpx; }
.hills { position: absolute; left: -60rpx; right: -60rpx; bottom: -80rpx; height: 190rpx; border-radius: 50%; background: rgba(24, 55, 35, 0.85); z-index: 2; pointer-events: none; }
.hills.h2 { left: 40rpx; right: -100rpx; bottom: -110rpx; height: 170rpx; background: rgba(10, 18, 13, 0.95); z-index: 2; }
.orbit { position: absolute; left: 50%; top: 56%; width: 380rpx; height: 380rpx; margin: -190rpx 0 0 -190rpx; border: 2rpx dashed rgba(127, 224, 168, 0.22); border-radius: 50%; animation: spin 26s linear infinite; z-index: 1; }
.orbit .ff { width: 12rpx; height: 12rpx; box-shadow: 0 0 24rpx 6rpx rgba(245, 217, 139, 0.75); animation: fly 7s ease-in-out infinite; top: 12%; left: 46%; position: absolute; }
.orbit .ff.b2 { animation-delay: 2.6s; top: 70%; left: 58%; }
.orbit .ff.b3 { animation-delay: 5s; top: 30%; left: 70%; }
/* 植宠立于夜草地：底部沉入山丘剪影，像站在草地上 */
.d-pet-ring { position: relative; z-index: 1; width: 280rpx; height: 280rpx; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; margin: 0 auto; top: 160rpx; border: 4rpx solid rgba(127, 224, 168, 0.18); box-sizing: border-box; animation: float 5s ease-in-out infinite; filter: drop-shadow(0 24rpx 44rpx rgba(0, 0, 0, 0.5)); }
.d-pet { width: 100%; height: 100%; }
.d-bubble { position: absolute; left: 32rpx; top: 36rpx; background: rgba(19, 32, 25, 0.88); border: 2rpx solid var(--border2); border-radius: 28rpx 28rpx 28rpx 8rpx; padding: 16rpx 24rpx; font-size: 22rpx; color: var(--text); z-index: 3; max-width: 60%; line-height: 1.6; }
.d-heart { position: absolute; right: 36rpx; bottom: 32rpx; z-index: 3; text-align: right; }
.d-heart .hnum { font-size: 60rpx; font-weight: 900; color: var(--gold); line-height: 1; font-family: var(--font-num); }
.d-heart .hlab { font-size: 19rpx; color: var(--text2); letter-spacing: 4rpx; margin-top: 6rpx; }

/* 草地夜光读数 */
.bt-scale { position: relative; z-index: 3; display: flex; gap: 12rpx; margin-top: 24rpx; }
.bs { flex: 1; text-align: center; padding: 16rpx 0 14rpx; border-radius: 24rpx; background: rgba(127, 224, 168, 0.07); border: 2rpx solid rgba(127, 224, 168, 0.14); }
.bs i { display: block; font-style: normal; font-size: 26rpx; font-weight: 800; color: var(--accent); text-shadow: 0 0 20rpx rgba(127, 224, 168, 0.45); font-family: var(--font-num); letter-spacing: 0.5rpx; }
.bs em { display: block; font-style: normal; font-size: 17rpx; letter-spacing: 4rpx; color: var(--text2); margin-top: 6rpx; }

/* 好感度 */
.bt-liquid { position: relative; z-index: 3; margin-top: 20rpx; padding: 18rpx 26rpx; border-radius: 26rpx; background: rgba(127, 224, 168, 0.05); border: 2rpx solid rgba(127, 224, 168, 0.12); }
.bt-liquid .track { display: flex; height: 12rpx; border-radius: 8rpx; background: rgba(127, 224, 168, 0.12); overflow: hidden; }
.bt-liquid .fill { display: block; height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, var(--accent), var(--gold)); box-shadow: 0 0 20rpx rgba(127, 224, 168, 0.5); }
.bt-liquid-b { display: flex; justify-content: space-between; font-size: 19rpx; color: var(--text2); margin-top: 12rpx; letter-spacing: 2rpx; }
.bt-liquid-i { color: var(--gold); }

/* 打盹伙伴 */
.bt-sibling { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 20rpx 28rpx; border-radius: 30rpx; border: 2rpx dashed rgba(245, 217, 139, 0.25); font-size: 21rpx; color: var(--text2); }
.bt-sibling .mini { width: 52rpx; height: 40rpx; border-radius: 16rpx 16rpx 8rpx 8rpx; border: 2rpx solid rgba(127, 224, 168, 0.3); background: rgba(127, 224, 168, 0.05); position: relative; flex: none; }
.bt-sibling .mini::after { content: ''; position: absolute; left: 50%; top: 10rpx; transform: translateX(-50%); width: 20rpx; height: 6rpx; border-radius: 4rpx; background: #8A6B45; }
.bt-sib-b { color: var(--text); font-weight: 700; }
.bt-sib-go { margin-left: auto; font-size: 20rpx; color: var(--gold); }

/* 深色卡片 */
.d-card { background: var(--surface); border: 2rpx solid var(--border); border-radius: 44rpx; box-shadow: var(--shadow-sm); }

/* AI 夜话 */
.ai-preview { display: flex; gap: 22rpx; padding: 28rpx; margin-top: 24rpx; align-items: flex-start; }
.ai-ava { width: 72rpx; height: 72rpx; border-radius: 26rpx; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; flex: none; }
.ai-ava .ico { width: 40rpx; height: 40rpx; color: var(--accent); }
.ai-body { flex: 1; min-width: 0; }
.ai-text { font-size: 26rpx; line-height: 1.75; color: var(--text); }
.ai-time { font-size: 20rpx; color: var(--text2); margin-top: 12rpx; }

/* 无设备引导（深色） */
.d-noguide { margin-top: 24rpx; padding: 40rpx 30rpx; background: var(--surface); border: 2rpx dashed rgba(245, 217, 139, 0.3); border-radius: 30rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.d-noguide-ico { font-size: 52rpx; }
.d-noguide-t { font-size: 28rpx; font-weight: 700; color: var(--text); }
.d-noguide-d { font-size: 22rpx; color: var(--text2); }

/* 守夜折叠 */
.d-fold-head { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; }
.fh-badge { width: 76rpx; height: 76rpx; border-radius: 28rpx; background: var(--accent-soft); border: 2rpx solid rgba(127, 224, 168, 0.3); display: flex; align-items: center; justify-content: center; flex: none; color: var(--accent); font-size: 30rpx; font-weight: 800; }
.fh-txt { flex: 1; min-width: 0; }
.fh-k { font-size: 18rpx; letter-spacing: 5rpx; color: var(--text2); font-weight: 700; display: block; }
.fh-t { font-size: 27rpx; font-weight: 800; margin-top: 6rpx; color: var(--text); display: block; }
.fh-t i { font-style: normal; font-size: 21rpx; color: var(--accent); font-weight: 700; margin-left: 12rpx; }
.d-fold .fold-body { margin-top: 8rpx; }

/* 章节横排小标 */
.d-sec { display: flex; align-items: center; gap: 16rpx; margin: 36rpx 0 18rpx; }
.d-sec .ln { flex: 1; height: 2rpx; background: var(--border); }
.d-sec text { font-size: 19rpx; letter-spacing: 5rpx; color: var(--text2); font-weight: 700; }
.d-sec text b { color: var(--accent); }
.btn-ghost { height: 48rpx; padding: 0 20rpx; border: 2rpx solid var(--border2); border-radius: 24rpx; display: flex; align-items: center; font-size: 20rpx; color: var(--text2); }

/* 守夜任务 */
.d-task { display: flex; align-items: center; gap: 24rpx; background: var(--surface); border: 2rpx solid var(--border); border-radius: 36rpx; padding: 26rpx 28rpx; margin-top: 20rpx; }
.d-task .tt { font-size: 20rpx; color: var(--accent); letter-spacing: 3rpx; writing-mode: vertical-rl; font-weight: 800; border-right: 2rpx dashed var(--border2); padding-right: 16rpx; flex: none; }
.theme-dark .task-check { border-color: var(--border2); }
.theme-dark .task-check.done { background: radial-gradient(circle, rgba(245, 217, 139, 0.25), rgba(245, 217, 139, 0.05)); color: var(--gold); }
.d-task-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.d-task-title { font-size: 26rpx; font-weight: 700; color: var(--text); }
.d-task-desc { font-size: 21rpx; color: var(--text2); }
.d-task-desc.warn { color: var(--warn); }
.sticker { display: inline-flex; align-items: center; gap: 10rpx; height: 52rpx; padding: 0 24rpx; border-radius: 26rpx; border: 4rpx solid var(--accent); background: var(--surface); font-size: 21rpx; font-weight: 800; color: var(--accent); transform: rotate(-2.5deg); white-space: nowrap; flex: none; }
.sticker.rt { transform: rotate(2deg); }
.sticker.warm { border-color: var(--warn); color: var(--warn); }
.d-add { margin-top: 16rpx; height: 76rpx; border: 2rpx dashed var(--border2); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text2); }
.d-empty { margin-top: 20rpx; padding: 30rpx 0; text-align: center; font-size: 22rpx; color: var(--text2); }

/* 设备横滑带 */
.d-band { display: flex; gap: 20rpx; overflow-x: auto; white-space: nowrap; }
.d-meter { min-width: 300rpx; background: var(--surface); border: 2rpx solid var(--border); border-radius: 36rpx; padding: 26rpx 28rpx; display: inline-block; box-sizing: border-box; }
.d-meter .mk { font-size: 19rpx; color: var(--text2); letter-spacing: 3rpx; display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.d-meter-v { font-size: 26rpx; font-weight: 800; margin-top: 12rpx; color: var(--text); }
.d-meter .mn { font-size: 19rpx; color: var(--accent); margin-top: 8rpx; }
.d-meter.hot { border-color: var(--accent); background: linear-gradient(180deg, var(--accent-soft), var(--surface) 70%); }
.d-meter-add { min-width: 180rpx; display: inline-flex; align-items: center; justify-content: center; font-size: 44rpx; color: var(--accent); }

/* 终端巡检牌 */
.d-term { background: #0A130E; border: 2rpx solid var(--border); border-radius: 36rpx; padding: 30rpx 32rpx; font-family: Menlo, Consolas, monospace; }
.d-term .thead { font-size: 19rpx; letter-spacing: 4rpx; color: var(--text2); border-bottom: 2rpx dashed var(--border2); padding-bottom: 16rpx; margin-bottom: 8rpx; display: flex; justify-content: space-between; }
.d-term .thead b { color: var(--gold); }
.d-term .tl { display: flex; gap: 18rpx; align-items: center; font-size: 24rpx; color: var(--text); padding: 14rpx 0; }
.d-term .tl .pr { color: var(--accent); font-weight: 700; }
.d-term .tl .cur { display: inline-block; width: 14rpx; height: 28rpx; background: var(--accent); animation: blink 1s steps(2) infinite; }
.d-term .tl .hint { color: var(--text2); font-size: 22rpx; margin-left: auto; }

/* 风扇卡 */
.fan-card { display: flex; align-items: center; gap: 28rpx; padding: 32rpx; border-color: var(--accent); margin-top: 8rpx; }
.fan-ico { width: 108rpx; height: 108rpx; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; background: var(--accent-soft); }
.fan-ico .ico { width: 56rpx; height: 56rpx; color: var(--accent); }
.fan-card.is-off .fan-ico { opacity: 0.55; }
.fan-card.is-off { border-color: var(--border); opacity: 0.85; }
.fan-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.fan-name { font-size: 32rpx; font-weight: 800; color: var(--text); }
.fan-state { font-size: 22rpx; color: var(--accent); }
.fan-hint { font-size: 20rpx; color: var(--text2); }
.fan-toggle { position: relative; width: 104rpx; height: 60rpx; border-radius: 30rpx; background: var(--border2); flex: none; transition: 0.25s; }
.fan-toggle.on { background: var(--accent); }
.fan-toggle .knob { position: absolute; left: 6rpx; top: 6rpx; width: 48rpx; height: 48rpx; border-radius: 24rpx; background: var(--surface); transition: 0.25s; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2); }
.fan-toggle.on .knob { left: auto; right: 6rpx; background: var(--gold); }

/* ================= 动画 ================= */
@keyframes spin { to { transform: rotate(360deg); } }
.spin-anim { display: inline-block; animation: spin 3s linear infinite; }
@keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
@keyframes bounce2 { 0%, 100% { transform: translateY(0); } 30% { transform: translateY(-14rpx); } 55% { transform: translateY(0); } 72% { transform: translateY(-6rpx); } }
@keyframes drift { from { transform: translateX(-180rpx); } to { transform: translateX(920rpx); } }
@keyframes blink { 0%, 92%, 100% { opacity: 1; } 95% { opacity: 0.2; } }
@keyframes twinkle { 0%, 100% { opacity: 0.25; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.18); } }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
@keyframes fly { 0%, 100% { transform: translate(0, 0); opacity: 0.1; } 30% { opacity: 0.85; } 55% { transform: translate(32rpx, -44rpx); opacity: 0.45; } 80% { opacity: 0.9; } }
@keyframes shoot { 0% { opacity: 0; transform: translate(0, 0) rotate(14deg); } 3% { opacity: 1; } 14% { opacity: 0; transform: translate(380rpx, 116rpx) rotate(14deg); } 100% { opacity: 0; transform: translate(380rpx, 116rpx) rotate(14deg); } }
