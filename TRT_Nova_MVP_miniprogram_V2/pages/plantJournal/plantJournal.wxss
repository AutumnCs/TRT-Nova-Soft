/* ================= 成长手记 · 双主题（浅色元气日光 / 深色萤火温室） =================
   共享 CSS 变量见 app.wxss（--bg / --jelly / --matcha / --gold / --accent 等） */

/* ---------- 容器 ---------- */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  background-image: radial-gradient(rgba(47, 162, 102, 0.05) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
}
.theme-dark.page { background-image: radial-gradient(rgba(127, 224, 168, 0.05) 2rpx, transparent 2rpx); }
.ppad { padding: 24rpx 32rpx 0; }

/* 宋体标题统一 */
.sw-name, .cal-title, .today-t, .tl-title, .dd-name, .j-month-t, .j-date, .jt-title, .composer-title { font-family: var(--font-serif); }

/* ---------- 顶栏（双主题共用） ---------- */
.pg-top { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 24rpx; }
.pg-top .back { width: 72rpx; height: 72rpx; border-radius: 28rpx; background: var(--jelly2); display: flex; align-items: center; justify-content: center; color: var(--text); }
.back-ico { font-size: 44rpx; line-height: 1; margin-top: -4rpx; }
.pg-top .mid { flex: 1; text-align: center; }
.pg-top .mid .k { display: block; font-size: 18rpx; letter-spacing: 5rpx; color: var(--text2); font-weight: 700; }
.pg-top .mid .t { display: block; margin-top: 6rpx; font-size: 29rpx; font-weight: 800; color: var(--text); }
.pg-top .act { min-width: 72rpx; display: flex; justify-content: flex-end; }
.chip { display: inline-flex; align-items: center; gap: 12rpx; height: 46rpx; padding: 0 26rpx; border-radius: 23rpx; background: var(--jelly2); border: 2rpx solid var(--line2); font-size: 22rpx; color: var(--text2); white-space: nowrap; }
.chip-t { font-size: 22rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--matcha); flex: none; }
.dot.on { background: #35C873; box-shadow: 0 0 14rpx rgba(53, 200, 115, 0.6); }
.theme-dark .dot.on { background: var(--gold); box-shadow: 0 0 16rpx rgba(245, 217, 139, 0.6); }
.theme-dark .chip { height: 58rpx; border-radius: 999rpx; background: var(--surface2); border-color: var(--border); }

/* ---------- 通用按钮 ---------- */
.btn-soft { display: inline-flex; align-items: center; justify-content: center; height: 56rpx; padding: 0 24rpx; border-radius: 28rpx; background: var(--matcha-soft); color: var(--matcha-deep); font-size: 22rpx; font-weight: 700; border: 2rpx solid rgba(47, 162, 102, 0.35); white-space: nowrap; flex: none; box-sizing: border-box; }
.btn-soft-t { font-size: 22rpx; color: inherit; }
.btn-ghost { display: inline-flex; align-items: center; justify-content: center; height: 56rpx; padding: 0 24rpx; border-radius: 28rpx; background: transparent; color: var(--text); font-size: 22rpx; font-weight: 700; border: 3rpx solid var(--line2); white-space: nowrap; flex: none; box-sizing: border-box; }
.btn-ghost-t { font-size: 22rpx; color: inherit; }
.theme-dark .btn-soft { height: 58rpx; border-radius: 999rpx; background: var(--accent-soft); color: var(--accent); border: none; font-size: 23rpx; }

/* ================= 浅色 · 元气日光 ================= */

/* 卡片基底 */
.card { background: linear-gradient(180deg, #FFFFFF, #FDFAF2); border: 2rpx solid var(--line); border-radius: 52rpx; box-shadow: var(--shadow-sm), inset 0 2rpx 0 #fff; }

/* 植宠切换卡 */
.switch-card { padding: 28rpx; display: flex; align-items: center; gap: 24rpx; }
.sw-ico { width: 88rpx; height: 88rpx; border-radius: 20rpx; background: var(--matcha-soft); display: flex; align-items: center; justify-content: center; flex: none; }
.sw-ico-t { font-size: 44rpx; }
.sw-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.sw-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.sw-sub { display: block; font-size: 21rpx; color: var(--text2); margin-top: 4rpx; }

/* 成长日历 */
.cal-card { padding: 32rpx; margin-top: 24rpx; }
.cal-head { display: flex; justify-content: space-between; align-items: center; }
.cal-k { display: block; font-size: 20rpx; letter-spacing: 4rpx; color: var(--matcha-deep); font-weight: 700; }
.cal-title { display: block; font-size: 32rpx; font-weight: 800; margin-top: 6rpx; color: var(--text); }
.cal-nav { display: flex; gap: 12rpx; }
.cal-nav-btn { width: 60rpx; height: 56rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--line2); color: var(--text); font-size: 36rpx; line-height: 1; }
.cal-grid { display: flex; flex-wrap: wrap; margin-top: 28rpx; }
.cal-wk { width: 14.285%; text-align: center; font-size: 20rpx; color: var(--text2); padding: 12rpx 0; box-sizing: border-box; }
.cal-day { width: 14.285%; min-height: 88rpx; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; font-size: 24rpx; color: var(--text); padding: 16rpx 0; box-sizing: border-box; font-variant-numeric: tabular-nums; }
.cal-day.blank { visibility: hidden; }
.cal-day-t { font-weight: 600; }
.cal-day.today { background: var(--matcha-soft); border-radius: 22rpx; }
.cal-day.today .cal-day-t { font-weight: 800; color: var(--matcha-deep); }
.cal-day.sel { background: var(--matcha-soft); border-radius: 22rpx; }
.cal-day.sel .cal-day-t { font-weight: 700; color: var(--matcha-deep); }
.cal-mark { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--matcha); margin-top: 6rpx; }

/* 当日卡 */
.today-card { padding: 28rpx 32rpx; margin-top: 24rpx; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.today-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.today-t { font-size: 28rpx; font-weight: 800; color: var(--text); }
.today-d { display: block; font-size: 21rpx; color: var(--text2); margin-top: 6rpx; }
.today-acts { display: flex; gap: 12rpx; flex: none; }

/* 圆点藤蔓时间线 */
.tl { margin-top: 32rpx; position: relative; padding-left: 44rpx; }
.tl-item { position: relative; margin-bottom: 24rpx; }
.tl-node { position: absolute; left: -43rpx; top: 32rpx; width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--matcha); box-shadow: 0 0 0 7rpx var(--matcha-soft); }
.tl-card { padding: 26rpx 28rpx; }
.tl-top { display: flex; justify-content: space-between; align-items: center; }
.tl-act { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; }
.tl-act .ico { width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--matcha-soft); display: flex; align-items: center; justify-content: center; flex: none; }
.tl-act .ico.warn { background: rgba(192, 91, 60, 0.12); }
.ico-t { font-size: 28rpx; }
.tl-act-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.tl-title { font-size: 27rpx; font-weight: 700; color: var(--text); }
.tl-type { display: block; font-size: 19rpx; color: var(--text2); margin-top: 2rpx; }
.tl-time { font-size: 19rpx; color: var(--text2); white-space: nowrap; flex: none; }
.tl-desc { display: block; font-size: 22rpx; color: var(--text2); line-height: 1.65; margin-top: 16rpx; }

/* 空状态 */
.empty-card { margin-top: 24rpx; padding: 44rpx 36rpx; text-align: center; }
.empty-t { display: block; font-size: 30rpx; font-weight: 700; color: var(--text); text-align: center; }
.empty-d { display: block; font-size: 22rpx; color: var(--text2); margin-top: 12rpx; line-height: 1.6; text-align: center; }

/* ================= 深色 · 萤火温室 · 夜记本 ================= */

/* 当前记录对象 */
.dd { margin-top: 32rpx; padding: 24rpx 28rpx; display: flex; align-items: center; gap: 22rpx; background: var(--jelly); border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 12rpx; position: relative; }
.dd-tag { position: absolute; top: -18rpx; left: 28rpx; z-index: 3; background: rgba(127, 224, 168, 0.3); color: #F3F1E8; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; padding: 6rpx 20rpx; border-radius: 6rpx; }
.dd-ava { width: 84rpx; height: 84rpx; border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 8rpx; background: var(--surface2); display: flex; align-items: center; justify-content: center; flex: none; }
.dd-ava-t { font-size: 56rpx; }
.dd-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.dd-name { display: block; font-size: 28rpx; font-weight: 700; color: var(--text); }
.dd-sub { display: block; font-size: 20rpx; color: var(--text2); margin-top: 4rpx; line-height: 1.6; }
.dd-empty { flex-direction: column; align-items: flex-start; gap: 8rpx; }

/* 记录本（左页日历 + 右页今日） */
.journal { margin-top: 36rpx; background: var(--jelly); border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 12rpx; padding: 32rpx 30rpx; position: relative; background-image: repeating-linear-gradient(0deg, transparent 0 54rpx, rgba(127, 224, 168, 0.09) 54rpx 56rpx); background-origin: content-box; }
.journal::before { content: ''; position: absolute; left: 50%; top: 12rpx; bottom: 12rpx; width: 2rpx; margin-left: -1rpx; background: rgba(127, 224, 168, 0.14); }
.j-washi { position: absolute; top: -14rpx; left: 48rpx; width: 120rpx; height: 30rpx; background: rgba(245, 217, 139, 0.2); z-index: 3; }
.j-washi.w2 { left: auto; right: 56rpx; background: rgba(127, 224, 168, 0.16); }
.j-pages { display: flex; gap: 28rpx; position: relative; z-index: 2; }
.j-left { flex: 1.55; min-width: 0; }
.j-right { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.j-month { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.j-month-t { font-size: 27rpx; font-weight: 700; color: var(--text); }
.j-month-nav { display: flex; gap: 10rpx; }
.theme-dark .cal-nav { width: 48rpx; height: 44rpx; border: 3rpx solid rgba(127, 224, 168, 0.4); border-radius: 14rpx; background: #0E1B13; justify-content: center; align-items: center; font-size: 22rpx; color: var(--text2); line-height: 1; }

/* 夜记本日历 */
.calgrid { display: flex; flex-wrap: wrap; }
.calw { width: 14.285%; text-align: center; font-size: 20rpx; color: var(--accent); padding: 10rpx 0; box-sizing: border-box; }
.cald { width: 14.285%; min-height: 72rpx; position: relative; text-align: center; font-size: 24rpx; color: var(--text); padding: 14rpx 0; box-sizing: border-box; font-variant-numeric: tabular-nums; }
.cald.blank { visibility: hidden; }
.cald.rec { color: var(--matcha); }
.cald.rec::after { content: ''; position: absolute; left: 50%; transform: translateX(-50%); bottom: 4rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--matcha); }
.cald.today { background: var(--accent); border-radius: 22rpx; }
.cald.today .cald-t { color: var(--matcha-ink); font-weight: 800; }
.cald.sel { background: var(--accent-soft); border-radius: 22rpx; }
.cald.sel .cald-t { color: var(--accent); font-weight: 700; }

/* 右页今日卡 */
.j-date { display: block; font-size: 27rpx; font-weight: 700; color: var(--text); margin-bottom: 18rpx; }
.jr-today { background: #0E1B13; border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 8rpx; padding: 22rpx; box-shadow: 4rpx 4rpx 0 rgba(127, 224, 168, 0.07); flex: 1; display: flex; flex-direction: column; justify-content: center; }
.jr-today-d { display: block; font-size: 21rpx; color: var(--text2); line-height: 1.7; }
.jr-btns { display: flex; gap: 12rpx; margin-top: 20rpx; }
.jr-btn { display: inline-flex; align-items: center; justify-content: center; font-size: 19rpx; font-weight: 700; color: var(--text); border: 2rpx solid rgba(127, 224, 168, 0.3); background: var(--jelly); padding: 8rpx 20rpx; border-radius: 6rpx; }
.jr-btn.go { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
.jr-btn-t { font-size: 19rpx; color: inherit; }

/* 当日记录 */
.j-sec { display: flex; align-items: baseline; gap: 20rpx; margin-top: 36rpx; padding: 0 8rpx; }
.j-sec-t { font-size: 30rpx; font-weight: 700; color: var(--text); font-family: var(--font-serif); }
.j-sec-ln { flex: 1; border-top: 2rpx dashed rgba(127, 224, 168, 0.22); }
.j-sec-n { font-size: 20rpx; color: var(--text2); }
.jt-list { display: flex; flex-direction: column; gap: 28rpx; margin-top: 24rpx; }
.jt-item { background: var(--jelly); border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 8rpx; padding: 22rpx 26rpx; position: relative; box-shadow: 4rpx 4rpx 0 rgba(127, 224, 168, 0.07); }
.jt-item::before { content: ''; position: absolute; top: -12rpx; left: 50%; width: 100rpx; height: 24rpx; margin-left: -50rpx; background: rgba(245, 217, 139, 0.14); }
.jt-top { display: flex; justify-content: space-between; align-items: center; }
.jt-act { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; }
.jr-ico { width: 60rpx; height: 60rpx; border: 2rpx solid rgba(127, 224, 168, 0.3); border-radius: 6rpx; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; flex: none; }
.jr-ico.warn { background: rgba(232, 160, 95, 0.12); }
.jr-ico-t { font-size: 28rpx; }
.jt-act-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.jt-title { font-size: 27rpx; font-weight: 700; color: var(--text); }
.jt-type { display: block; font-size: 18rpx; color: var(--text2); margin-top: 2rpx; }
.jt-time { font-size: 19rpx; color: var(--text2); white-space: nowrap; flex: none; }
.jt-desc { display: block; font-size: 21rpx; color: var(--text2); line-height: 1.65; margin-top: 16rpx; }
.jt-empty { text-align: center; }
.jt-empty .jt-title { display: block; text-align: center; }

/* ================= 新增记录弹层（双主题共用） ================= */
.composer-mask { position: fixed; inset: 0; z-index: 20; background: rgba(22, 59, 42, 0.36); backdrop-filter: blur(6px); display: flex; align-items: flex-end; }
.theme-dark .composer-mask { background: rgba(2, 8, 5, 0.7); }
.composer { width: 100%; box-sizing: border-box; padding: 40rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); border-radius: 60rpx 60rpx 0 0; background: linear-gradient(180deg, #FFFFFF, #FDFAF2); border-top: 2rpx solid var(--line2); }
.theme-dark .composer { background: linear-gradient(170deg, rgba(245, 217, 139, 0.04), rgba(245, 217, 139, 0) 40%), var(--jelly); border-top: 2rpx solid rgba(127, 224, 168, 0.3); }
.composer-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.composer-kicker { display: block; font-size: 20rpx; letter-spacing: 4rpx; color: var(--matcha-deep); text-transform: uppercase; }
.theme-dark .composer-kicker { color: var(--accent); }
.composer-title { display: block; margin-top: 4rpx; font-size: 40rpx; font-weight: 800; color: var(--text); }
.composer-close { width: 64rpx; height: 64rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--line2); color: var(--text); background: var(--jelly2); }
.composer-close-t { font-size: 40rpx; line-height: 1; }
.theme-dark .composer-close { border-color: rgba(127, 224, 168, 0.3); background: var(--surface2); color: var(--accent); }
.composer-field { width: 100%; box-sizing: border-box; border-radius: 36rpx; margin-bottom: 24rpx; border: 2rpx solid #DCEBD3; background: #F4F9EF; }
.theme-dark .composer-field { border-color: rgba(127, 224, 168, 0.3); background: #0E1B13; }
.composer-field-label { display: block; font-size: 20rpx; letter-spacing: 3.6rpx; color: #6B7F72; text-transform: uppercase; margin-bottom: 16rpx; }
.theme-dark .composer-field-label { color: var(--text2); }
.composer-picker { min-height: 124rpx; padding: 28rpx 32rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.composer-picker-text { display: block; font-size: 30rpx; font-weight: 700; color: var(--text); }
.composer-picker-arrow { font-size: 32rpx; color: var(--text2); }
.composer-input-wrap { padding: 28rpx 32rpx 24rpx; }
.composer-input { width: 100%; box-sizing: border-box; height: 56rpx; line-height: 56rpx; font-size: 28rpx; color: var(--text); }
.composer-textarea-wrap { padding: 28rpx 32rpx 24rpx; }
.composer-textarea { width: 100%; box-sizing: border-box; min-height: 232rpx; font-size: 28rpx; line-height: 1.7; color: var(--text); }
.composer-placeholder { color: var(--text2); opacity: 0.7; }
.composer-actions { display: flex; gap: 20rpx; margin-top: 8rpx; }
.composer-btn { flex: 1; height: 88rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; }
.composer-btn.secondary { background: var(--matcha-soft); color: var(--matcha-deep); }
.theme-dark .composer-btn.secondary { background: var(--surface2); color: var(--text); border: 2rpx solid rgba(127, 224, 168, 0.3); }
.composer-btn.primary { background: var(--matcha-deep); color: #FFFFFF; }
.theme-dark .composer-btn.primary { background: var(--accent); color: var(--matcha-ink); box-shadow: 0 0 24rpx rgba(127, 224, 168, 0.25); }
