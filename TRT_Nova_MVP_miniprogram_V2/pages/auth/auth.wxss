/* ================= 登录页 · 双主题（浅色元气日光 · 登录标本卡 / 深色萤火温室 · 温室之门） ================= */
/* 变量复用 app.wxss：page 默认浅色，.theme-dark 覆盖深色 */

.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 64rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  background-image: radial-gradient(rgba(47, 162, 102, 0.045) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
}
.theme-dark.auth-page {
  background-image: radial-gradient(rgba(127, 224, 168, 0.05) 2rpx, transparent 2rpx);
}

/* ================= 浅色 · 元气日光 · 登录标本卡 ================= */
.specimen {
  position: relative;
  margin: 120rpx 40rpx 0;
  padding: 72rpx 44rpx 60rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  text-align: center;
  animation: cardSlide 0.4s ease-out forwards;
}
.specimen::after {
  content: '';
  position: absolute;
  inset: -10rpx;
  border: 2rpx solid var(--line);
  pointer-events: none;
}
.specimen::before {
  content: '';
  position: absolute;
  inset: 18rpx;
  border: 2rpx dashed var(--line2);
  pointer-events: none;
}
.sp-no { display: block; font-size: 18rpx; letter-spacing: 8rpx; color: var(--text2); font-weight: 600; }
.sp-pet {
  display: block;
  font-size: 248rpx;
  line-height: 1.15;
  margin: 36rpx 0 24rpx;
  animation: breathe 4.5s ease-in-out infinite;
  filter: drop-shadow(0 20rpx 28rpx rgba(52, 66, 58, 0.18));
}
.sp-name { display: block; font-size: 54rpx; font-weight: 700; letter-spacing: 14rpx; color: var(--text); }
.sp-sub { display: block; font-size: 22rpx; color: var(--text2); margin-top: 16rpx; letter-spacing: 4rpx; }
.sp-rule { width: 92rpx; height: 2rpx; background: var(--line); margin: 36rpx auto 28rpx; }
.sp-motto { display: block; font-size: 21rpx; color: var(--text2); letter-spacing: 4rpx; }

/* ================= 深色 · 萤火温室 · 温室之门 ================= */
.nw {
  text-align: center;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 217, 139, 0.45);
  padding: 16rpx 12rpx 10rpx;
  font-weight: 600;
  position: relative;
  z-index: 2;
}
.d-pad { padding: 8rpx 32rpx 0; }
.d-chips { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.d-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--jelly2);
  font-size: 20rpx;
  color: var(--text2);
}
.d-chip .d-chip-b { font-size: 21rpx; color: var(--text); font-weight: 700; }
.ff-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--gold); box-shadow: 0 0 16rpx rgba(245, 217, 139, 0.6); flex: none; }

.d-door {
  position: relative;
  height: 660rpx;
  border-radius: 60rpx;
  margin-top: 32rpx;
  background: radial-gradient(120% 90% at 50% 110%, #1E4430 0%, #0E1D14 58%, #0A120D 100%);
  border: 2rpx solid var(--line2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: cardSlide 0.4s ease-out forwards;
}
.doorline { position: absolute; inset: 28rpx; border: 2rpx dashed rgba(245, 217, 139, 0.22); border-radius: 44rpx; }
.starfield {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  background-image:
    radial-gradient(3rpx 3rpx at 12% 18%, rgba(234, 243, 234, 0.85) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 28% 9%, rgba(234, 243, 234, 0.55) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 44% 22%, rgba(245, 217, 139, 0.75) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 61% 7%, rgba(234, 243, 234, 0.5) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 74% 16%, rgba(234, 243, 234, 0.8) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 87% 26%, rgba(245, 217, 139, 0.6) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 8% 42%, rgba(234, 243, 234, 0.45) 50%, transparent 51%),
    radial-gradient(3rpx 3rpx at 92% 48%, rgba(234, 243, 234, 0.7) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 36% 38%, rgba(234, 243, 234, 0.4) 50%, transparent 51%),
    radial-gradient(2rpx 2rpx at 68% 34%, rgba(245, 217, 139, 0.5) 50%, transparent 51%);
  animation: twinkle 4.5s ease-in-out infinite;
}
.ff {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 18rpx 4rpx rgba(245, 217, 139, 0.6);
  z-index: 4;
  animation: fly 9s ease-in-out infinite;
}
.ff1 { left: 18%; top: 26%; animation-duration: 8s; }
.ff2 { right: 20%; top: 34%; animation-delay: 2.2s; animation-duration: 10s; }
.ff3 { left: 26%; bottom: 28%; animation-delay: 4.5s; animation-duration: 12s; }
.d-pet {
  position: relative;
  z-index: 2;
  font-size: 260rpx;
  line-height: 1.15;
  filter: drop-shadow(0 28rpx 56rpx rgba(0, 0, 0, 0.6));
  animation: float 5.5s ease-in-out infinite;
}
.d-door-word { position: relative; z-index: 2; font-size: 23rpx; color: var(--text2); margin-top: 32rpx; letter-spacing: 2rpx; }
.mat {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  padding: 6rpx 28rpx;
  border-top: 2rpx solid rgba(245, 217, 139, 0.28);
  border-bottom: 2rpx solid rgba(245, 217, 139, 0.28);
  font-size: 19rpx;
  letter-spacing: 10rpx;
  color: rgba(245, 217, 139, 0.55);
  font-weight: 700;
}
.d-brand { text-align: center; margin-top: 44rpx; }
.d-brand-name { display: block; font-size: 48rpx; font-weight: 900; letter-spacing: 2rpx; color: var(--text); }
.d-brand-sub { display: block; font-size: 22rpx; color: var(--text2); margin-top: 12rpx; letter-spacing: 2rpx; }

/* ================= 登录入口（结构共用 · 样式随主题） ================= */
.entry { margin: 88rpx 40rpx 0; }
.theme-dark .entry { margin-top: 44rpx; }

.main-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 10rpx;
  margin: 0;
  padding: 0 32rpx;
  border: 2rpx solid var(--matcha-deep);
  background: var(--matcha);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.main-btn::after { border: none; }
.main-btn:active { transform: scale(0.98); }
.main-btn[disabled] { opacity: 0.72; }
.main-btn-txt { font-size: 29rpx; font-weight: 600; color: var(--matcha-ink); letter-spacing: 4rpx; }
.theme-dark .main-btn {
  height: 100rpx;
  border: none;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 56rpx rgba(127, 224, 168, 0.25);
}
.theme-dark .main-btn-txt { font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }

.a-hint { text-align: center; font-size: 21rpx; color: var(--text2); margin-top: 24rpx; line-height: 1.7; }
.a-hint-link { text-decoration: underline; text-underline-offset: 6rpx; }

/* ================= 功能卡 · 选择头像与昵称 / 开发体验登录 ================= */
.form-card {
  margin: 40rpx 40rpx 0;
  padding: 56rpx 44rpx 48rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
  box-sizing: border-box;
  animation: cardSlide 0.4s ease-out forwards;
}
.theme-dark .form-card {
  background: var(--jelly);
  border-color: var(--line);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
}

.card-label { font-size: 26rpx; font-weight: 800; color: var(--matcha-deep); letter-spacing: 4rpx; align-self: flex-start; }
.card-sub { font-size: 24rpx; color: var(--text2); line-height: 1.6; align-self: flex-start; margin-top: -20rpx; }

.wechat-profile-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  margin: 0;
  padding: 0 32rpx;
  background: var(--matcha-soft);
  border: 2rpx solid rgba(46, 74, 60, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.wechat-profile-btn::after { border: none; }
.wechat-profile-text { font-size: 28rpx; font-weight: 700; color: var(--matcha-deep); }
.theme-dark .wechat-profile-btn { border-color: rgba(127, 224, 168, 0.3); }

.avatar-wrap { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.avatar-btn {
  width: 176rpx;
  height: 176rpx;
  min-width: 176rpx;
  max-width: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0 auto;
  line-height: 0;
  font-size: 0;
  background: var(--jelly2);
  border: 6rpx solid var(--matcha);
  box-shadow: 0 0 0 8rpx var(--matcha-soft);
  position: relative;
  display: block;
  box-sizing: content-box;
}
.avatar-btn::after { border: none; }
.avatar-img { position: absolute; inset: 0; width: 176rpx; height: 176rpx; border-radius: 50%; display: block; }
.avatar-placeholder { opacity: 0.42; }
.avatar-hint { font-size: 24rpx; color: var(--text2); }

.input-wrap {
  width: 100%;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--matcha-ink);
  border: 3rpx solid var(--line2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 20rpx;
}
.input-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--matcha-soft);
  color: var(--matcha-deep);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}
.name-input { flex: 1; height: 100rpx; line-height: 100rpx; font-size: 30rpx; color: var(--text); }
.input-placeholder { color: var(--text2); opacity: 0.6; font-size: 28rpx; }

.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 12rpx;
  margin: 0;
  padding: 0 32rpx;
  background: var(--jelly2);
  border: 2rpx solid var(--line2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.login-btn::after { border: none; }
.login-btn-text { font-size: 29rpx; font-weight: 700; color: var(--text2); letter-spacing: 4rpx; }
.login-btn-active { background: var(--matcha); border-color: var(--matcha-deep); }
.login-btn-active .login-btn-text { color: var(--matcha-ink); }
.theme-dark .login-btn-active { box-shadow: 0 20rpx 56rpx rgba(127, 224, 168, 0.25); }

.profile-actions { display: flex; align-items: center; justify-content: center; gap: 80rpx; }
.text-btn { margin: 0; padding: 0; height: 56rpx; line-height: 56rpx; background: transparent; color: var(--text2); font-size: 26rpx; }
.text-btn::after { border: none; }
.back-btn { margin-top: -12rpx; }

/* ================= 过渡遮罩 ================= */
.transition-mask {
  position: fixed;
  inset: 0;
  background: linear-gradient(160deg, #F7F5EE 0%, #EAF6EF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: maskIn 0.25s ease forwards;
}
.theme-dark .transition-mask {
  background: radial-gradient(130% 100% at 50% 0%, #183723 0%, #0E1B13 62%, #0A120D 100%);
}
.transition-inner { display: flex; flex-direction: column; align-items: center; gap: 40rpx; }
.transition-logo { font-size: 68rpx; font-weight: 900; color: var(--text); letter-spacing: 8rpx; animation: logoPulse 1.2s ease-in-out infinite; }
.theme-dark .transition-logo { color: var(--gold); }
.transition-spinner { width: 88rpx; height: 88rpx; }
.spinner-ring {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid rgba(47, 162, 102, 0.25);
  border-top-color: var(--matcha);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.theme-dark .spinner-ring { border-color: rgba(245, 217, 139, 0.25); border-top-color: var(--gold); }
.transition-text { color: var(--text2); font-size: 30rpx; font-weight: 500; letter-spacing: 4rpx; }

/* ================= 动画 ================= */
@keyframes cardSlide { from { transform: translateY(64rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes logoPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.08); opacity: 0.86; } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
@keyframes fly { 0%, 100% { transform: translate(0, 0); opacity: 0.1; } 30% { opacity: 0.85; } 55% { transform: translate(32rpx, -44rpx); opacity: 0.45; } 80% { opacity: 0.9; } }
@keyframes twinkle { 0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0); } 50% { opacity: 1; transform: scale(1.18) rotate(18deg); } }
