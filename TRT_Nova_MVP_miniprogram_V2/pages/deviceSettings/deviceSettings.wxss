/* ================= 设备设置 · 双主题（浅色元气日光 / 深色萤火温室） ================= */
/* 变量沿用 app.wxss 全局定义，此处仅补充本页浅色危险区用色 */

page {
  background: #F7F5EE;
}

/* page 背景随主题翻转，消除切页瞬间原生底与页面色的跳变 */
page:has(.theme-dark) { background: #0C1410; }

.theme-light {
  --danger: #8A3428;
  --danger-soft: rgba(138, 52, 40, 0.07);
}

/* ---------- 容器 ---------- */
.page {
  position: relative;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  background-image: radial-gradient(rgba(47, 162, 102, 0.045) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
  box-sizing: border-box;
}

.page.theme-dark {
  background-image: radial-gradient(rgba(127, 224, 168, 0.05) 2rpx, transparent 2rpx);
}

.top-shell {
  position: relative;
  z-index: 2;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 主题切换按钮 ---------- */
.theme-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--jelly2);
  border: 2rpx solid var(--line2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.theme-btn.dark {
  border-color: rgba(245, 217, 139, 0.35);
  background: rgba(245, 217, 139, 0.08);
}

/* ================= 浅色 · 元气日光（功能条目分区） ================= */

/* 顶栏 */
.l-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 -4rpx 36rpx;
  padding: 16rpx 8rpx 24rpx;
}

.l-back {
  width: 72rpx;
  text-align: center;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--text2);
}

.l-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--text);
}

.l-acts {
  min-width: 72rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.l-signal {
  font-size: 30rpx;
  line-height: 1;
  color: var(--matcha);
}

/* 纸感卡片（dd） */
.dd {
  position: relative;
  background: var(--paper);
  border: 2rpx solid #3A423C;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(52, 66, 58, 0.07);
}

.dd-tag {
  position: absolute;
  top: -18rpx;
  left: 28rpx;
  z-index: 3;
  background: #3A423C;
  color: #F3F1E8;
  font-family: var(--font-serif);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
}

/* 设备概览 */
.dev-overview {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 26rpx 28rpx;
}

.dev-fig {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #3A423C;
  border-radius: 8rpx;
  background: var(--jelly2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dev-fig-img {
  width: 100%;
  height: 100%;
}

.dev-fig-ph {
  font-size: 48rpx;
}

.dev-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dev-name {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-sub {
  font-size: 20rpx;
  color: var(--text2);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-id {
  font-family: 'SF Pro Rounded', 'DIN Alternate', 'Bahnschrift', sans-serif;
  font-size: 18rpx;
  color: var(--text2);
  margin-top: 4rpx;
}

.dev-id .on {
  color: var(--matcha-deep);
  font-weight: 700;
}

.dev-id .off {
  color: var(--warn);
}

/* 分区标题 */
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 36rpx;
  padding: 0 8rpx;
}

.sec-title {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  flex: none;
}

.sec-title.danger {
  color: var(--danger);
}

.sec-line {
  flex: 1;
  border-top: 2rpx dashed var(--line2);
}

/* 基础配置条目 */
.furn {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 26rpx 30rpx;
  margin-top: 24rpx;
}

.f-ico {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid #3A423C;
  border-radius: 10rpx;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 0 rgba(35, 40, 47, 0.07);
  font-size: 40rpx;
}

.f-body {
  flex: 1;
  min-width: 0;
}

.f-k {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 19rpx;
  color: var(--text2);
}

.f-no {
  font-family: 'SF Pro Rounded', 'DIN Alternate', 'Bahnschrift', sans-serif;
  font-weight: 700;
  color: var(--matcha-deep);
}

.f-field {
  margin-top: 10rpx;
}

.f-input {
  font-family: var(--font-serif);
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
}

.f-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.f-pick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.f-thumb {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid #3A423C;
  border-radius: 6rpx;
  background: var(--paper);
}

.f-pick-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.f-pick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.f-pick-family {
  font-size: 18rpx;
  color: var(--text2);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.f-ph {
  font-size: 28rpx;
  color: var(--text2);
}

.f-chev {
  flex: none;
  font-size: 26rpx;
  line-height: 1;
  color: var(--matcha-deep);
}

/* 配网设置 */
.provision {
  padding: 28rpx;
  margin-top: 24rpx;
}

.pv-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-title {
  font-family: var(--font-serif);
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
}

.pv-tag {
  font-family: 'SF Pro Rounded', 'DIN Alternate', 'Bahnschrift', sans-serif;
  font-size: 18rpx;
  color: var(--text2);
  border: 2rpx solid var(--line2);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: var(--paper);
}

.pv-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text2);
  line-height: 1.75;
  margin-top: 14rpx;
}

.pv-url {
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
  background: var(--paper);
  border: 2rpx dashed var(--matcha-deep);
  border-radius: 8rpx;
  font-family: 'SF Pro Rounded', 'DIN Alternate', 'Bahnschrift', sans-serif;
  font-size: 24rpx;
  color: var(--matcha-deep);
  font-weight: 600;
}

.pv-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 浅色按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 0;
  margin: 0;
  border: 2rpx solid transparent;
  background: transparent;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn.ghost {
  flex: 1;
  background: transparent;
  color: var(--text);
  border-color: #3A423C;
}

.btn.soft {
  flex: 1;
  background: var(--matcha-soft);
  color: var(--matcha-deep);
  border-color: rgba(46, 74, 60, 0.3);
}

.btn.save-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 32rpx;
  background: var(--matcha);
  color: var(--matcha-ink);
  border-color: var(--matcha-deep);
  font-size: 29rpx;
  letter-spacing: 4rpx;
}

/* 危险操作（浅色） */
.danger-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  border-color: rgba(138, 52, 40, 0.5);
}

.dg-ico {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid var(--danger);
  border-radius: 8rpx;
  background: var(--danger-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger);
  font-size: 40rpx;
  font-weight: 700;
}

.dg-body {
  flex: 1;
  min-width: 0;
}

.dg-title {
  display: block;
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}

.dg-desc {
  display: block;
  font-size: 20rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 4rpx;
}

.dg-act {
  flex: none;
  font-family: var(--font-serif);
  font-size: 21rpx;
  font-weight: 700;
  color: var(--danger);
}

/* ================= 深色 · 萤火温室（它的小房间） ================= */

/* 守夜手记 + 萤火虫 */
.nw {
  text-align: center;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 217, 139, 0.45);
  padding: 10rpx 12rpx 0;
  font-weight: 600;
  position: relative;
  z-index: 2;
}

.ff {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 20rpx 8rpx rgba(245, 217, 139, 0.5);
  animation: fly 9s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}

.ff.f1 { left: 14%; top: 24%; }
.ff.f2 { right: 11%; top: 38%; animation-delay: 3.5s; animation-duration: 11s; }

@keyframes fly {
  0%, 100% { transform: translate(0, 0); opacity: 0.1; }
  30% { opacity: 0.85; }
  55% { transform: translate(32rpx, -44rpx); opacity: 0.45; }
  80% { opacity: 0.9; }
}

/* 顶栏：夜灯布置 */
.pg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 28rpx;
  position: relative;
  z-index: 2;
}

.back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--surface2);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 40rpx;
  line-height: 1;
}

.mid {
  text-align: center;
  display: flex;
  flex-direction: column;
}

.mid .k {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: var(--accent);
  font-weight: 800;
}

.mid .t {
  font-size: 27rpx;
  font-weight: 700;
  margin-top: 4rpx;
  color: var(--text);
}

.act {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--surface2);
  border: 2rpx solid var(--border);
}

.chip.green {
  background: var(--accent-soft);
  border-color: rgba(245, 217, 139, 0.28);
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}

.chip-dot.on {
  background: var(--accent);
  box-shadow: 0 0 12rpx rgba(127, 224, 168, 0.6);
}

.chip-dot.off {
  background: var(--warn);
}

.chip-b {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ONLINE 终端头卡（机架风） */
.d-term {
  background: #0A130E;
  border: 2rpx solid var(--border);
  border-radius: 36rpx;
  padding: 30rpx 32rpx;
  font-family: Menlo, Consolas, monospace;
  margin-top: 28rpx;
}

.d-term .thead {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: var(--text2);
  border-bottom: 2rpx dashed var(--border2);
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.d-term .thead b {
  color: var(--gold);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.d-term .tl {
  display: flex;
  gap: 18rpx;
  align-items: center;
  font-size: 24rpx;
  color: var(--text);
  padding: 14rpx 0 0;
}

.d-term .tl .pr {
  color: var(--accent);
  font-weight: 700;
}

.d-term .tl .hint {
  color: var(--text2);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 章节横排小标 */
.d-sec {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 36rpx 0 18rpx;
}

.d-sec .ln {
  flex: 1;
  height: 2rpx;
  background: var(--border);
}

.d-sec text {
  font-size: 19rpx;
  letter-spacing: 5rpx;
  color: var(--text2);
  font-weight: 700;
}

.d-sec text b {
  color: var(--accent);
}

.d-sec.danger .danger-t {
  color: var(--danger);
}

.d-sec.danger .danger-t b {
  color: var(--danger);
}

.d-sec.danger .ln {
  background: var(--danger-soft);
}

/* 深色卡片 */
.card {
  background: linear-gradient(180deg, rgba(127, 224, 168, 0.035), rgba(127, 224, 168, 0) 42%), var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 40rpx;
  box-shadow: var(--shadow-sm);
}

/* 设备档案表单 */
.form-card {
  padding: 8rpx 32rpx;
}

.form-block {
  padding: 28rpx 0;
}

.form-label {
  font-size: 22rpx;
  color: var(--text2);
  margin-bottom: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--surface2);
  border: 2rpx solid var(--border);
  color: var(--text2);
  font-size: 27rpx;
  box-sizing: border-box;
}

.field-in {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: var(--text);
  font-size: 27rpx;
  font-weight: 600;
}

.divider {
  height: 2rpx;
  background: var(--border);
  margin: 4rpx 0;
}

/* 植物种类选择 */
.pick-field {
  justify-content: space-between;
  padding-right: 20rpx;
}

.pick-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pick-thumb {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 2rpx solid var(--border2);
}

.pick-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-family {
  font-size: 19rpx;
  color: var(--text2);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-ph {
  flex: 1;
  font-size: 27rpx;
  color: var(--text2);
}

.pick-chev {
  flex: none;
  font-size: 26rpx;
  line-height: 1;
  color: var(--accent);
}

/* 设备配网 */
.net-card {
  padding: 32rpx;
}

.net-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.net-title {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--text);
}

.net-chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--surface2);
  border: 2rpx solid var(--border);
  font-size: 20rpx;
  color: var(--text2);
  font-family: 'SF Pro Rounded', 'DIN Alternate', 'Bahnschrift', sans-serif;
}

.net-desc {
  display: block;
  font-size: 23rpx;
  color: var(--text2);
  line-height: 1.75;
  margin-top: 16rpx;
}

.net-url {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(245, 217, 139, 0.06);
  border: 2rpx dashed rgba(245, 217, 139, 0.5);
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
}

.net-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

/* 深色按钮 */
.dbtn-ghost,
.dbtn-soft {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 58rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.dbtn-ghost::after,
.dbtn-soft::after,
.btn-primary::after {
  border: none;
}

.dbtn-ghost {
  background: var(--surface2);
  border: 2rpx solid var(--border);
  color: var(--text2);
  font-weight: 600;
}

.dbtn-soft {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 700;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  margin-top: 36rpx;
  border-radius: 36rpx;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
  line-height: 1;
  box-shadow: 0 20rpx 56rpx rgba(127, 224, 168, 0.25);
}

/* 危险区（深色） */
.danger-card-d {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 30rpx;
  border-color: rgba(240, 142, 130, 0.4);
  background: linear-gradient(180deg, rgba(240, 142, 130, 0.06), transparent 55%), var(--surface);
}

.dg-ico-d {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--danger-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dg-ico-d text {
  color: var(--danger);
  font-weight: 800;
  font-size: 36rpx;
  font-family: Menlo, Consolas, monospace;
}

.dg-body-d {
  flex: 1;
  min-width: 0;
}

.dg-title-d {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--danger);
}

.dg-desc-d {
  display: block;
  font-size: 21rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 6rpx;
}

.dg-act-d {
  flex: none;
  font-size: 21rpx;
  font-weight: 800;
  color: var(--danger);
  letter-spacing: 2rpx;
  font-family: Menlo, Consolas, monospace;
}

/* ================= 植物选择弹层（双主题共用，变量随根节点级联） ================= */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(28, 34, 30, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.theme-dark .picker-mask {
  background: rgba(0, 0, 0, 0.72);
}

.picker-panel {
  width: 100%;
  height: 76vh;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--paper);
  border-top: 2rpx solid var(--line2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.24);
}

.theme-dark .picker-panel {
  border-top-color: var(--border);
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.44);
}

.picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx 16rpx;
  flex-shrink: 0;
}

.picker-title {
  display: block;
  color: var(--text);
  font-size: 34rpx;
  font-weight: 800;
}

.picker-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--text2);
  font-size: 20rpx;
}

.picker-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--jelly2);
  color: var(--text);
  font-size: 36rpx;
  line-height: 1;
}

.picker-toolbar {
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
}

.picker-search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: var(--jelly2);
  border: 2rpx solid var(--line2);
}

.theme-dark .picker-search-box {
  background: var(--surface2);
  border-color: var(--border);
}

.picker-search-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: var(--matcha-soft);
}

.picker-search-badge-text {
  color: var(--matcha-deep);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.picker-search-input {
  flex: 1;
  min-width: 0;
  color: var(--text);
  font-size: 26rpx;
  height: 100%;
}

.picker-placeholder {
  color: var(--text2);
}

.picker-list {
  flex: 1;
  min-height: 0;
}

.picker-empty {
  padding: 72rpx 0;
  text-align: center;
  color: var(--text2);
  font-size: 26rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 20rpx 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: var(--jelly);
  border: 2rpx solid var(--line2);
}

.theme-dark .picker-item {
  background: var(--surface2);
  border-color: var(--border);
}

.picker-item-selected {
  background: var(--matcha-soft);
  border-color: var(--matcha);
}

.picker-item-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--line2);
}

.theme-dark .picker-item-img {
  border-color: var(--border2);
}

.picker-item-info {
  flex: 1;
  min-width: 0;
}

.picker-item-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.picker-item-name {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 800;
}

.picker-fav-badge {
  color: var(--peach-deep);
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--peach-soft);
}

.picker-item-family {
  display: block;
  color: var(--text2);
  font-size: 20rpx;
  margin-bottom: 10rpx;
}

.picker-item-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.picker-tag-partial-shade { background: rgba(47, 162, 102, 0.12); color: #2FA266; }
.picker-tag-avoid-sun { background: rgba(245, 158, 11, 0.14); color: #D97706; }
.picker-tag-sun-loving { background: rgba(220, 38, 38, 0.12); color: #DC2626; }
.picker-tag-shade-tolerant { background: rgba(37, 99, 235, 0.12); color: #2563EB; }

.theme-dark .picker-tag-partial-shade { background: rgba(127, 224, 168, 0.13); color: #7FE0A8; }
.theme-dark .picker-tag-avoid-sun { background: rgba(245, 158, 11, 0.15); color: #F5B87A; }
.theme-dark .picker-tag-sun-loving { background: rgba(240, 142, 130, 0.14); color: #F08E82; }
.theme-dark .picker-tag-shade-tolerant { background: rgba(96, 165, 250, 0.14); color: #93C5FD; }

.picker-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--matcha);
  color: var(--matcha-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  flex-shrink: 0;
}
