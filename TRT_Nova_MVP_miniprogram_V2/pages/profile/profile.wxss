/* ================= 我的档案 · 双主题（浅色元气日光 / 深色萤火温室） ================= */
/* 变量沿用 app.wxss 全局定义，此处仅补充浅色票券用色 */

page {
  background: #F7F5EE;
}

/* page 背景随主题翻转，消除切页瞬间原生底与页面色的跳变 */
page:has(.theme-dark) { background: #0C1410; }

.theme-light {
  --gold: #B98A2F;
  --gold-soft: rgba(185, 138, 47, 0.12);
  --danger: #C05B3C;
  --danger-soft: rgba(192, 91, 60, 0.1);
}

/* ---------- 容器 ---------- */
.page {
  position: relative;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  background-image: radial-gradient(rgba(47, 162, 102, 0.045) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
  box-sizing: border-box;
}

.page.theme-dark {
  background-image: radial-gradient(rgba(127, 224, 168, 0.05) 2rpx, transparent 2rpx);
}

.scroll-content {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.top-shell {
  padding: 0 40rpx 44rpx;
}

/* ---------- 主题切换按钮 ---------- */
.theme-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--jelly2);
  border: 2rpx solid var(--line2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.theme-btn.dark {
  border-color: rgba(245, 217, 139, 0.35);
  background: rgba(245, 217, 139, 0.08);
}

/* ================= 浅色 · 元气日光（证件卡 + 票券） ================= */

/* 顶栏 */
.l-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 -4rpx 36rpx;
  padding: 16rpx 8rpx 24rpx;
}

.l-back {
  width: 72rpx;
  text-align: center;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--text2);
}

.l-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--text);
}

.l-acts {
  min-width: 72rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.l-signal {
  font-size: 30rpx;
  line-height: 1;
  color: var(--matcha);
}

/* 档案证件卡 */
.idcard {
  position: relative;
  display: flex;
  gap: 26rpx;
  padding: 30rpx 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid #23282F;
  background: linear-gradient(135deg, #2E4A3C, #223A2E);
  color: #F3F1E8;
  box-shadow: 0 12rpx 36rpx rgba(34, 58, 46, 0.25);
  overflow: hidden;
}

.idcard::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.photo {
  flex: none;
  width: 140rpx;
  height: 172rpx;
  background: #F3F1E8;
  border: 2rpx solid #23282F;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  z-index: 2;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.id-info {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.id-label {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  opacity: 0.85;
}

.id-name {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.id-b {
  font-weight: 700;
}

.seal {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid rgba(243, 241, 232, 0.55);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.3;
  transform: rotate(-12deg);
  background: rgba(243, 241, 232, 0.06);
  color: #F3F1E8;
  z-index: 2;
}

/* 功能导航 */
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 0 8rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.sec-line {
  flex: 1;
  border-top: 2rpx dashed var(--line2);
}

/* 功能票券 */
.tickets {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.ticket {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 28rpx 22rpx 34rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
  box-shadow: 0 4rpx 16rpx rgba(52, 66, 58, 0.06);
}

.ticket::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--matcha);
}

.ticket.tk-g::before {
  background: var(--gold);
}

.ticket.tk-d::before {
  background: var(--danger);
}

.ticket::after {
  content: "";
  position: absolute;
  right: -3rpx;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--line);
  clip-path: inset(0 0 0 50%);
}

.tico {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--matcha-soft);
  color: var(--matcha-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tk-g .tico {
  background: var(--gold-soft);
  color: var(--gold);
}

.tk-d .tico {
  border-color: var(--danger);
  background: var(--danger-soft);
  color: var(--danger);
}

.tico-txt {
  font-size: 32rpx;
  line-height: 1;
}

.tbody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.tt-danger {
  color: var(--danger);
}

.td {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text2);
}

.t-right {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 8rpx;
}

.tail {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--matcha-deep);
  letter-spacing: 2rpx;
}

.chev {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text2);
}

.chev-danger {
  color: var(--danger);
}

/* ================= 深色 · 萤火温室（夜间档案柜） ================= */

.nw {
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 217, 139, 0.45);
  padding: 10rpx 12rpx;
  font-weight: 600;
  position: relative;
  z-index: 2;
}

.ff {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 20rpx 8rpx rgba(245, 217, 139, 0.5);
  animation: fly 9s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}

.ff.f1 { left: 14%; top: 24%; }
.ff.f2 { right: 11%; top: 38%; animation-delay: 3.5s; animation-duration: 11s; }

@keyframes fly {
  0%, 100% { transform: translate(0, 0); opacity: 0.1; }
  30% { opacity: 0.85; }
  55% { transform: translate(32rpx, -44rpx); opacity: 0.45; }
  80% { opacity: 0.9; }
}

/* 顶栏：夜巡档案 */
.pg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 28rpx;
  position: relative;
  z-index: 2;
}

.back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--surface2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 40rpx;
  line-height: 1;
}

.mid {
  text-align: center;
  display: flex;
  flex-direction: column;
}

.mid .k {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--accent);
  font-weight: 800;
}

.mid .t {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 4rpx;
  color: var(--text);
}

.act {
  min-width: 68rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.d-signal {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  font-size: 28rpx;
  line-height: 1;
  animation: breathe 3s infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

/* 档案柜：左徽章 + 右条目 */
.d-file {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 2;
}

.fl {
  width: 232rpx;
  flex: none;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx 16rpx;
  box-sizing: border-box;
}

.d-av-ring {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: var(--surface2);
  border: 5rpx solid var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.d-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.d-name {
  max-width: 100%;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--surface2);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.chip.green {
  background: var(--accent-soft);
  border-color: rgba(245, 217, 139, 0.28);
}

.chip-b {
  font-size: 25rpx;
  color: var(--accent);
  font-weight: 700;
}

.d-fl-cap {
  font-size: 20rpx;
  color: var(--text2);
  text-align: center;
  line-height: 1.6;
}

.fr {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.frow {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}

.fico {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
}

.fico-d {
  color: var(--danger);
}

.fk {
  flex: none;
  font-size: 22rpx;
  color: var(--text2);
  letter-spacing: 2rpx;
  min-width: 118rpx;
}

.fk-danger {
  color: var(--danger);
}

.fv {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fv-d {
  color: var(--text2);
  font-weight: 500;
}

.ftail {
  flex: none;
  font-size: 20rpx;
  color: var(--text2);
}

.chev-d {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: var(--text2);
}

.chev-danger {
  color: var(--danger);
}

.frow-danger {
  border-color: var(--danger);
}

/* ---------- 深色整屏填充：档案柜拉伸占满剩余视口，条目均分高度 ---------- */
.page.theme-dark .top-shell {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
}

.page.theme-dark .d-file {
  flex: 1;
  min-height: 0;
}

.page.theme-dark .fr .frow {
  flex: 1;
}

/* ---------- 通用 ---------- */
.pressed {
  opacity: 0.72;
  transform: scale(0.98);
}

.bottom-spacer {
  height: calc(240rpx + env(safe-area-inset-bottom));
}

.fade-in {
  animation: none;
  opacity: 1;
}
