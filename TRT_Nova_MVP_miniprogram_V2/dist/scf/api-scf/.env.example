# api-scf 环境变量示例
# 下面带 <...> 的值需要你自己替换

# 数据库连接
DB_HOST=sh-cynosdbmysql-grp-g55nrpa0.sql.tencentcdb.com
DB_PORT=28245
DB_NAME=nova_iot
DB_USER=NovaSqlTest
DB_PASSWORD=TRTNova123
DB_CONN_LIMIT=5
JWT_SECRET=NovaAuth_2026_k8F3x9LmP2qR7vW4cY1nT6sH0aB5dE

# 验证阶段可临时使用
# 正式环境建议改成网关透传 openid，而不是长期依赖这个调试值
DEBUG_OPENID=test-openid

# OneNET auth
# 支持三种鉴权模式：
# - product : res=products/{productId}
# - project : res=projects/{projectId}
# - user    : res=userid/{userId}
ONENET_AUTH_MODE=user
ONENET_AUTH_METHOD=sha256
ONENET_AUTH_TTL_SECONDS=3600

# 兼容共享 access key
# 如果只配置 ONENET_ACCESS_KEY，product/project/user 模式都会回退读它
#ONENET_ACCESS_KEY=<onenet-access-key-base64>

# 产品鉴权
#ONENET_PRODUCT_ACCESS_KEY=QQd9qVG341WbnU3BDyVr/1tBcfEVzQ2F70M3052/GxE=

# 项目鉴权
#ONENET_PROJECT_ID=<project-id>
#ONENET_PROJECT_ACCESS_KEY=<project-access-key-base64>

# 用户鉴权
ONENET_USER_ID=495839
ONENET_USER_ACCESS_KEY=7d562166e897466ebea50532d3415e4b

# 设备控制映射
# 当前临时物模型标识符是 test
# 后续正式化后可改成 fan_switch
#FAN_SWITCH_IDENTIFIER=test

# EMQX command publish（可选；当 device/cmd 走 EMQX 下发时需要）
# EMQX_PUBLISH_URL=https://<deployment-api-host>/publish
# EMQX_APP_ID=<emqx-app-id>
# EMQX_APP_SECRET=<emqx-app-secret>
# EMQX_COMMAND_TOPIC_TEMPLATE=down/${logicalKey}
# EMQX_COMMAND_QOS=1
# EMQX_COMMAND_RETAIN=false
# DEVICE_CMD_PROVIDER_DEFAULT=onenet