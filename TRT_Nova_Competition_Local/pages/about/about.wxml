<view class="container" style="padding-top: {{statusBarHeight}}px;">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">关于我们</text>
    <view class="header-placeholder"></view>
  </view>

  <scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}">
    <view class="app-info-section">
      <view class="app-logo">
        <text class="logo-icon">🌿</text>
      </view>
      <text class="app-name">{{appInfo.name}}</text>
      <text class="app-version">版本 {{appInfo.version}}</text>
      <text class="app-description">{{appInfo.description}}</text>
    </view>

    <view class="section">
      <text class="section-title">核心功能</text>
      <view class="feature-list">
        <block wx:for="{{appInfo.features}}" wx:key="index">
          <view class="feature-item">
            <text class="feature-icon">✓</text>
            <text class="feature-text">{{item}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <text class="section-title">开发者信息</text>
      <view class="info-item">
        <text class="info-label">开发团队</text>
        <text class="info-value">{{appInfo.developer}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">联系邮箱</text>
        <text class="info-value">{{appInfo.contact}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">法律信息</text>
      <view class="legal-list">
        <view class="legal-item" bindtap="viewPrivacyPolicy">
          <text class="legal-text">隐私协议</text>
          <text class="arrow">></text>
        </view>
        <view class="legal-item" bindtap="viewUserAgreement">
          <text class="legal-text">用户协议</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>

    <view class="footer">
      <text class="footer-text">© 2026 {{appInfo.developer}}</text>
      <text class="footer-subtext">All rights reserved</text>
    </view>
  </scroll-view>
</view>
