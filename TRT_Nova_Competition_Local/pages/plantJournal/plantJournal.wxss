page { background: #f3f7e9; color: #244332; }
button::after { border: 0; }
.page { min-height: 100vh; position: relative; overflow: hidden; }
.page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background-image: radial-gradient(circle, rgba(36,67,50,.1) 1.5rpx, transparent 1.5rpx); background-size: 18rpx 18rpx; opacity: .35; }
.page-glow { position: fixed; width: 360rpx; height: 360rpx; border-radius: 50%; filter: blur(70rpx); opacity: .35; pointer-events: none; }.glow-one { right: -130rpx; top: -70rpx; background: #a6dc99; }.glow-two { left: -150rpx; bottom: 80rpx; background: #ffd27a; }
.topbar { position: relative; z-index: 3; display: flex; align-items: center; gap: 18rpx; padding: 18rpx 210rpx 22rpx 28rpx; }.icon-btn { width: 72rpx; height: 72rpx; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3rpx solid #244332; border-radius: 22rpx; background: #fffdf7; color: #244332; box-shadow: 4rpx 4rpx 0 #c9d8bd; font-size: 46rpx; font-weight: 900; }.brand-block { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }.brand-kicker { color: #7c3aed; font-size: 15rpx; letter-spacing: 3rpx; font-weight: 850; white-space: nowrap; }.brand-title { margin-top: 4rpx; color: #163b2a; font-size: 31rpx; font-weight: 950; white-space: nowrap; }
.content { position: relative; z-index: 2; height: calc(100vh - 104px); padding: 0 28rpx; box-sizing: border-box; }.hero-card, .record-card, .state-card { border: 3rpx solid #244332; background: rgba(255,253,247,.97); box-shadow: 7rpx 7rpx 0 #c9d8bd; }.hero-card { padding: 28rpx; border-radius: 30rpx; background: linear-gradient(135deg, #dff1d8, #fff8e7 62%); }.hero-kicker { display: block; color: #477c43; font-size: 18rpx; letter-spacing: 4rpx; font-weight: 900; }.hero-title { display: block; margin-top: 10rpx; color: #163b2a; font-size: 37rpx; line-height: 1.3; font-weight: 950; }.filter-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 18rpx 20rpx; border: 2rpx solid #244332; border-radius: 20rpx; background: #fffdf7; }.filter-label { display: block; color: #819083; font-size: 18rpx; }.filter-value { display: block; margin-top: 4rpx; color: #244332; font-size: 25rpx; font-weight: 900; }.filter-action { color: #ea580c; font-size: 21rpx; font-weight: 900; }.hero-record { height: 66rpx; margin-top: 16rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; box-shadow: 0 5rpx 0 #c77b22; font-size: 22rpx; font-weight: 950; }
.state-card { display: flex; flex-direction: column; align-items: center; margin-top: 24rpx; padding: 70rpx 32rpx; border-radius: 28rpx; color: #748679; }.loading-dot { width: 42rpx; height: 42rpx; margin-bottom: 20rpx; border: 7rpx solid #d7e5d2; border-top-color: #15803d; border-radius: 50%; animation: spin .9s linear infinite; }.state-title { color: #244332; font-size: 30rpx; font-weight: 950; }.state-desc { margin-top: 12rpx; color: #718176; text-align: center; font-size: 21rpx; line-height: 1.65; }.empty-icon { margin-bottom: 14rpx; font-size: 58rpx; }.retry-btn, .primary-btn { margin-top: 26rpx; padding: 0 34rpx; height: 72rpx; line-height: 67rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 22rpx; font-weight: 900; box-shadow: 0 5rpx 0 #c77b22; }
.timeline { position: relative; margin-top: 30rpx; padding-left: 40rpx; }.timeline-rail { position: absolute; left: 12rpx; top: 18rpx; bottom: 8rpx; width: 4rpx; border-radius: 4rpx; background: #7cab77; }.timeline-item { position: relative; margin-bottom: 28rpx; }.timeline-dot { position: absolute; left: -37rpx; top: 51rpx; width: 18rpx; height: 18rpx; border: 4rpx solid #f3f7e9; border-radius: 50%; background: #ea580c; box-shadow: 0 0 0 3rpx #244332; }.timeline-date { margin: 0 0 10rpx 4rpx; color: #477c43; font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; }.record-card { padding: 23rpx; border-radius: 26rpx; }.record-head { display: flex; align-items: center; gap: 14rpx; }.record-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid #244332; border-radius: 17rpx; background: #dff1d8; font-size: 28rpx; }.record-heading { flex: 1; min-width: 0; }.record-title { display: block; color: #244332; font-size: 27rpx; font-weight: 950; }.record-meta { display: block; margin-top: 5rpx; color: #7b8b80; font-size: 18rpx; }.archive-pill { flex-shrink: 0; padding: 7rpx 11rpx; border-radius: 999rpx; background: #e7ebe4; color: #68716a; font-size: 16rpx; font-weight: 850; }.record-content { display: block; margin-top: 18rpx; color: #476052; font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-top: 18rpx; }.photo-grid.count-1 { grid-template-columns: 1fr; }.photo-grid.count-2 { grid-template-columns: repeat(2, 1fr); }.record-photo { width: 100%; height: 180rpx; border: 2rpx solid #244332; border-radius: 16rpx; background: #dcebd3; }.photo-grid.count-1 .record-photo { height: 340rpx; }.record-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 2rpx dashed #d5dfd0; }.text-action { min-width: 92rpx; height: 54rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 18rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 900; }.text-action.edit { border: 2rpx solid #244332; background: #e4f1df; color: #244332; }.text-action.delete { border: 2rpx solid #a23c2b; background: #fff1eb; color: #a23c2b; }.text-action.disabled { opacity: .55; }.bottom-space { height: 170rpx; }
.composer-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(22,59,42,.45); backdrop-filter: blur(6rpx); }.composer { width: 100%; max-height: 88vh; padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-top: 4rpx solid #244332; border-radius: 34rpx 34rpx 0 0; background: #fffdf7; box-shadow: 0 -10rpx 0 rgba(36,67,50,.2); }.composer-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }.composer-kicker { display: block; color: #7c3aed; font-size: 17rpx; letter-spacing: 3rpx; font-weight: 900; }.composer-title { display: block; margin-top: 5rpx; color: #244332; font-size: 34rpx; font-weight: 950; }.close-btn { width: 64rpx; height: 64rpx; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3rpx solid #244332; border-radius: 19rpx; background: #f3f7e9; color: #244332; font-size: 38rpx; }.composer-scroll { max-height: 62vh; }.field { width: 100%; box-sizing: border-box; margin-bottom: 16rpx; border: 2rpx solid #9fb19f; border-radius: 19rpx; background: #f5f9ef; }.picker-field { min-height: 84rpx; padding: 14rpx 18rpx; display: flex; align-items: center; justify-content: space-between; }.field-label { display: block; color: #6b7e70; font-size: 18rpx; font-weight: 800; }.field-value { display: block; margin-top: 4rpx; color: #244332; font-size: 23rpx; font-weight: 900; }.field-arrow { color: #ea580c; font-size: 32rpx; }.two-fields { display: flex; gap: 12rpx; }.half-field { flex: 1; min-width: 0; }.input-field { padding: 15rpx 18rpx; }.text-input { width: 100%; height: 57rpx; margin-top: 5rpx; color: #244332; font-size: 23rpx; }.text-area { width: 100%; min-height: 150rpx; margin-top: 9rpx; color: #244332; font-size: 23rpx; line-height: 1.6; }.photo-section { margin-bottom: 18rpx; padding: 18rpx; border: 2rpx dashed #9fb19f; border-radius: 20rpx; background: #f8faF3; }.photo-section-head { display: flex; align-items: center; justify-content: space-between; }.photo-help { display: block; margin-top: 4rpx; color: #8a978d; font-size: 17rpx; }.choose-photo-btn { height: 58rpx; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 20rpx; border: 2rpx solid #244332; border-radius: 999rpx; background: #dff1d8; color: #244332; font-size: 19rpx; font-weight: 900; }.draft-photo-row { display: flex; gap: 12rpx; margin-top: 18rpx; }.draft-photo-wrap { position: relative; width: 160rpx; height: 160rpx; }.draft-photo { width: 100%; height: 100%; border: 2rpx solid #244332; border-radius: 17rpx; box-sizing: border-box; }.remove-photo { position: absolute; right: -9rpx; top: -9rpx; width: 42rpx; height: 42rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 2rpx solid #fff; border-radius: 50%; background: #c33b2f; color: #fff; font-size: 28rpx; }.composer-actions { display: flex; gap: 14rpx; padding-top: 12rpx; }.cancel-btn, .save-btn { flex: 1; height: 78rpx; margin: 0; border: 3rpx solid #244332; border-radius: 999rpx; font-size: 24rpx; font-weight: 950; line-height: 72rpx; }.cancel-btn { background: #eef3e9; color: #244332; }.save-btn { background: #f6ad35; color: #244332; box-shadow: 0 5rpx 0 #c77b22; }
@keyframes spin { to { transform: rotate(360deg); } }
