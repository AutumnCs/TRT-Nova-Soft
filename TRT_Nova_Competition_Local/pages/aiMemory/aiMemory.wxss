.memory-page { box-sizing: border-box; min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: #fffdf7; color: #191923; }
.topbar { padding: 18rpx 24rpx; display: flex; align-items: center; gap: 18rpx; background: #fffdf7; border-bottom: 2rpx solid #191923; box-shadow: 0 6rpx 0 #c9d8bd; }
.back-btn { margin: 0; width: 66rpx; height: 66rpx; line-height: 58rpx; padding: 0; border: 2rpx solid #191923; border-radius: 14rpx; background: #fff; color: #191923; font-size: 42rpx; }
.page-title, .page-subtitle { display: block; }.page-title { font-size: 34rpx; font-weight: 900; }.page-subtitle { margin-top: 4rpx; color: #6b7d70; font-size: 20rpx; }
.top-mark { margin-left: auto; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #191923; border-radius: 50%; background: #ffe16a; color: #7c3aed; font-size: 20rpx; font-weight: 900; box-shadow: 4rpx 4rpx 0 #ef3d4b; }
.intro-card, .filter-card, .state-card, .memory-card { margin: 22rpx 24rpx 0; padding: 22rpx; border: 2rpx solid #191923; border-radius: 18rpx; background: #fffdf7; box-shadow: 5rpx 5rpx 0 #2778c9; }
.intro-title, .intro-text { display: block; }.intro-title { font-size: 30rpx; font-weight: 900; }.intro-text { margin-top: 10rpx; color: #526158; font-size: 22rpx; line-height: 1.65; }
.intro-actions { margin-top: 18rpx; display: flex; gap: 12rpx; }.intro-actions button, .memory-actions button, .state-card button { margin: 0; min-height: 58rpx; line-height: 54rpx; padding: 0 18rpx; border: 2rpx solid #191923; border-radius: 11rpx; background: #dff1d8; color: #15803d; font-size: 21rpx; font-weight: 800; }
.intro-actions .clear-button, .memory-actions .delete-button { background: #fff1f2; color: #be123c; }
.filter-card { display: flex; align-items: center; justify-content: space-between; box-shadow: 5rpx 5rpx 0 #ffe16a; font-size: 23rpx; font-weight: 800; }
.state-card { display: flex; flex-direction: column; align-items: center; gap: 12rpx; text-align: center; color: #66766c; font-size: 22rpx; line-height: 1.6; }.error-state { color: #be123c; }
.memory-list { padding-bottom: 20rpx; }.memory-card { box-shadow: 5rpx 5rpx 0 #c9d8bd; }
.memory-groups { padding: 4rpx 24rpx 24rpx; }
.memory-group { margin-top: 28rpx; }
.memory-group-title, .memory-group-desc { display: block; }
.memory-group-title { font-size: 27rpx; font-weight: 900; }
.memory-group-desc { margin-top: 6rpx; color: #6b7d70; font-size: 19rpx; line-height: 1.55; }
.memory-group .memory-list { padding-bottom: 0; }
.memory-group .memory-card { margin-left: 0; margin-right: 0; }
.memory-head, .memory-type, .memory-source, .memory-actions { display: flex; align-items: center; }.memory-head { justify-content: space-between; gap: 12rpx; }.memory-type { gap: 12rpx; }.memory-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #191923; border-radius: 13rpx; background: #ffe16a; font-size: 20rpx; font-weight: 900; }
.memory-type-label, .memory-pet { display: block; }.memory-type-label { font-size: 22rpx; font-weight: 900; }.memory-pet { margin-top: 3rpx; color: #7c3aed; font-size: 18rpx; }
.confirm-badge { padding: 6rpx 10rpx; border-radius: 999rpx; background: #f1f5f9; color: #64748b; font-size: 17rpx; }.confirm-badge.confirmed { background: #dcfce7; color: #15803d; }
.memory-content { display: block; margin-top: 18rpx; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; }
.memory-source { margin-top: 15rpx; flex-direction: column; align-items: flex-start; gap: 4rpx; color: #6b7d70; font-size: 18rpx; word-break: break-all; }
.memory-actions { margin-top: 16rpx; justify-content: flex-end; gap: 10rpx; }
.context-fact + .context-fact { margin-top: 20rpx; padding-top: 8rpx; border-top: 1rpx solid #dde2d6; }
.memory-page .topbar .back-btn { flex: 0 0 66rpx; min-width: 66rpx; max-width: 66rpx; width: 66rpx; margin: 0; padding: 0; }
.memory-page .topbar > view:nth-child(2) { flex: 1; min-width: 0; }
.memory-page .topbar .top-mark { flex: 0 0 58rpx; }
.summary-topbar { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 20rpx 24rpx; border-bottom: 1rpx solid #e8e5dc; }
.summary-heading { flex: 1; min-width: 0; }
.summary-heading .page-title { font-size: 34rpx; font-weight: 700; }
.summary-updated { display: block; margin-top: 6rpx; color: #797b7d; font-size: 21rpx; }
.summary-topbar .summary-icon-button { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; min-height: 0; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: 20rpx; }
.summary-icon-button::after, .summary-edit-link::after { border: 0; }
.summary-icon-button image { width: 36rpx; height: 36rpx; }
.summary-status { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 26rpx 32rpx; }
.summary-status-label, .summary-status-note { display: block; }
.summary-status-label { font-size: 25rpx; font-weight: 600; }
.summary-status-note { margin-top: 6rpx; font-size: 21rpx; color: #737977; }
.summary-status switch { flex-shrink: 0; transform: scale(.82); transform-origin: right center; }
.summary-article, .summary-editor-section { padding: 26rpx 36rpx 32rpx; }
.summary-section-title, .summary-editor-label { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 22rpx; }
.summary-prose { display: block; white-space: pre-wrap; overflow-wrap: break-word; font-size: 29rpx; line-height: 1.85; letter-spacing: .2rpx; }
.summary-empty { font-size: 27rpx; line-height: 1.8; color: #727975; }
.summary-empty text { display: block; margin-bottom: 10rpx; }
.summary-article .summary-edit-link { display: inline-flex; gap: 12rpx; align-items: center; min-height: 72rpx; padding: 0 14rpx 0 0; margin: 24rpx 0 0; border: 0; background: transparent; color: #2778c9; font-size: 24rpx; text-align: left; }
.summary-edit-link image { width: 29rpx; height: 29rpx; opacity: .75; }
.summary-footnote { padding: 18rpx 36rpx 28rpx; color: #888b86; font-size: 21rpx; line-height: 1.65; }
.legacy-toggle { display: flex; justify-content: space-between; padding: 30rpx 36rpx; margin-top: 12rpx; border-top: 1rpx solid #e8e5dc; font-size: 23rpx; color: #6d7470; }
.summary-editor-hint { display: block; font-size: 23rpx; line-height: 1.6; color: #747b76; margin-bottom: 22rpx; }
.summary-editor { box-sizing: border-box; display: block; width: 100%; min-height: 420rpx; padding: 24rpx; border: 2rpx solid #b7cfe4; border-radius: 18rpx; background: #fff; font-size: 28rpx; line-height: 1.8; color: #191923; }
.summary-character-count { display: block; text-align: right; font-size: 20rpx; color: #8d938e; margin-top: 12rpx; }
.summary-edit-actions { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 28rpx; }
.summary-edit-actions button { flex: 1; margin: 0; min-height: 76rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 76rpx; }
.summary-cancel { background: #f0f0eb; color: #626861; }
.summary-save { background: #ffe16a; color: #24282b; }
.summary-save-error, .summary-error { display: block; color: #b72e40; font-size: 24rpx; line-height: 1.6; margin-top: 20rpx; }
.summary-error { padding: 20rpx 36rpx; }
.summary-conflict { padding: 22rpx; background: #fff2dd; border-radius: 16rpx; margin-top: 18rpx; font-size: 23rpx; line-height: 1.7; }
.summary-conflict text { display: block; }.summary-conflict-current { white-space: pre-wrap; margin: 16rpx 0; }
