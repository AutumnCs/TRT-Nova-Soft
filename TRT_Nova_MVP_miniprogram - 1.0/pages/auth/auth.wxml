<view class="container fade-in" style="padding-top: {{statusBarHeight}}px;">
  <view class="header">
    <text class="title">欢迎使用智能花盆</text>
    <text class="subtitle">请完成登录后继续</text>
  </view>

  <scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}">
    <view class="auth-section">
      <view class="auth-card">
        <text class="auth-card-title">快速登录</text>

        <view class="avatar-section">
          <button class="avatar-uploader" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          </button>
          <text class="avatar-hint">点击选择头像</text>
        </view>

        <view class="nickname-section">
          <input
            type="nickname"
            class="nickname-input"
            placeholder="请输入昵称"
            value="{{userInfo.nickName}}"
            bind:change="onInputChange"
            maxlength="20"
          />
        </view>

        <view class="guide-text">
          <text>头像和昵称完整后将自动登录</text>
        </view>

        <view wx:if="{{hasUserInfo}}" class="logged-in">
          <view class="user-info">
            <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
            <text class="user-nickname">{{userInfo.nickName}}</text>
          </view>
          <button class="enter-btn" bindtap="loginSuccess">进入首页</button>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
