.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.provision-card {
  margin-top: 24rpx;
}

.row {
  margin-bottom: 24rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  color: #111827;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.input,
.picker {
  height: 88rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  line-height: 88rpx;
  color: #111827;
  font-size: 28rpx;
  background: #fafafa;
}

.save-btn {
  margin-top: 30rpx;
  background: #16a34a;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.provision-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.provision-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.provision-tip {
  font-size: 22rpx;
  color: #166534;
  background: #e7f8ef;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.provision-desc {
  font-size: 25rpx;
  line-height: 1.7;
  color: #4b5563;
}

.provision-url-box {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #f5f7f6;
  padding: 18rpx 20rpx;
}

.provision-url {
  font-size: 28rpx;
  color: #111827;
}

.provision-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ghost-btn,
.copy-btn {
  flex: 1;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.ghost-btn {
  background: #eef2f0;
  color: #1f2937;
}

.copy-btn {
  background: #dff4e5;
  color: #166534;
}
