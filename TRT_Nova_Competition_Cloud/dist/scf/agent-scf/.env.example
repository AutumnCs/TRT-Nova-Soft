# agent-scf 环境变量示例

# 数据库连接
DB_HOST=<mysql-host>
DB_PORT=3306
DB_NAME=<mysql-database>
DB_USER=<mysql-user>
DB_PASSWORD=<mysql-password>
DB_CONN_LIMIT=5

# 鉴权
JWT_SECRET=<jwt-secret>

# 仅隔离开发环境可显式开启；生产环境保持 0
ALLOW_LEGACY_OPENID_FALLBACK=0
DEBUG_OPENID=<debug-openid>

# 普通对话 API，可接 OpenAI-compatible Chat Completions 服务
LLM_API_ENABLED=false
LLM_API_BASE_URL=https://api.example.com
LLM_API_PATH=/v1/chat/completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500
LLM_TIMEOUT_MS=12000

# M7 Phase 2 只读影子运行时。默认关闭；开启后不接管回复，也没有业务写工具。
AGENT_SHADOW_ENABLED=false
# 建议使用独立随机密钥生成不可逆日志指纹；留空时回退 JWT_SECRET。
AGENT_SHADOW_FINGERPRINT_KEY=
AGENT_SHADOW_SAMPLE_RATE=1
AGENT_SHADOW_MAX_STEPS=3
AGENT_SHADOW_MAX_TOOL_CALLS=5
AGENT_SHADOW_TIMEOUT_MS=12000
AGENT_SHADOW_MAX_TOKENS=320

# M7 Phase 3 受控灰度。默认关闭；开启后按账号 + 会话稳定抽样，失败回落 legacy。
AGENT_ROLLOUT_ENABLED=false
# 建议与 Shadow 指纹密钥分开；留空时依次回退 AGENT_SHADOW_FINGERPRINT_KEY、JWT_SECRET。
AGENT_ROLLOUT_COHORT_KEY=
AGENT_ROLLOUT_SAMPLE_RATE=0.1
AGENT_ROLLOUT_MAX_STEPS=3
AGENT_ROLLOUT_MAX_TOOL_CALLS=5
AGENT_ROLLOUT_TIMEOUT_MS=12000
AGENT_ROLLOUT_MAX_TOKENS=500
# NOVA M6 参赛阶段：Chat / Vision 对所有账户不限次数；仍记录调用与 Token 用量。
VISION_MODEL=replace-with-your-vision-model
VISION_IMAGE_DETAIL=low
VISION_TIMEOUT_MS=30000
