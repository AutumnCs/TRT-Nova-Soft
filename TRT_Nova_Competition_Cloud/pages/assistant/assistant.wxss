.new-conversation-button { margin: 0; min-height: 48rpx; line-height: 44rpx; padding: 0 11rpx; border: 2rpx solid #191923; border-radius: 12rpx; background: #ffe16a; color: #191923; font-size: 17rpx; font-weight: 900; }
.new-conversation-button::after { border: 0; }

.composer-chip { margin: 2rpx 2rpx 7rpx; max-width: calc(100% - 4rpx); min-height: 42rpx; padding: 6rpx 8rpx; display: inline-flex; align-items: center; gap: 7rpx; border: 2rpx solid #7c3aed; border-radius: 999rpx; background: #f3e8ff; color: #5b21b6; font-size: 17rpx; font-weight: 850; box-sizing: border-box; }
.composer-chip-mark { padding: 2rpx 6rpx; border-radius: 999rpx; background: #7c3aed; color: #fff; font-size: 13rpx; letter-spacing: 1rpx; }
.composer-chip-remove { width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fffdf7; color: #5b21b6; font-size: 22rpx; }
.rewrite-chip { border-color: #2778c9; background: #eef6ff; color: #385b70; }
.rewrite-chip-mark { background: #2778c9; }

.pending-document-row { margin: 3rpx 2rpx 7rpx; padding: 8rpx; display: flex; align-items: center; gap: 11rpx; border-bottom: 2rpx solid #e4dfd1; }
.pending-document-mark, .message-document-mark { flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid #191923; border-radius: 10rpx; background: #e8f0ff; color: #2778c9; font-size: 14rpx; font-weight: 950; }
.pending-document-mark { width: 68rpx; height: 68rpx; }
.message-document { margin: 8rpx 0 10rpx; padding: 10rpx; display: flex; align-items: center; gap: 10rpx; border: 2rpx solid #191923; border-radius: 12rpx; background: #fffdf7; }
.message-document-mark { width: 58rpx; height: 58rpx; }
.message-document-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.message-document-name { overflow: hidden; color: #191923; font-size: 19rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.message-document-meta { color: #66766c; font-size: 15rpx; }
