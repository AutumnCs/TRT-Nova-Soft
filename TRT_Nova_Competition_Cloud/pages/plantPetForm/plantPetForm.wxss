.form-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 150rpx; background: #f3f7e9; color: #244332; }
.form-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 10% 4%, rgba(166, 220, 153, .48), transparent 30%), radial-gradient(circle at 92% 12%, rgba(255, 190, 84, .25), transparent 26%); }
.topbar, .form-card, .state-card, .submit-btn { position: relative; z-index: 1; }.topbar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 26rpx 20rpx; }.back-btn, .top-mark { width: 72rpx; height: 72rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3rpx solid #244332; border-radius: 22rpx; background: #fffdf7; color: #244332; box-shadow: 4rpx 4rpx 0 #c9d8bd; }.back-btn { margin: 0; padding: 0; font-size: 44rpx; line-height: 1; }.back-btn::after, .retry-btn::after, .submit-btn::after { border: 0; }.top-mark { color: #ea580c; font-size: 34rpx; font-weight: 900; }.brand-block { display: flex; flex-direction: column; align-items: center; }.brand { color: #163b2a; font-size: 32rpx; font-weight: 900; }.brand-sub { margin-top: 3rpx; color: #84958b; font-size: 16rpx; letter-spacing: 3rpx; }
.form-card { margin: 8rpx 28rpx 22rpx; padding: 26rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: rgba(255, 253, 247, .96); box-shadow: 7rpx 7rpx 0 #c9d8bd; }.hero-form { display: flex; gap: 20rpx; }.cover-picker { position: relative; width: 190rpx; height: 190rpx; flex-shrink: 0; }.cover-preview { width: 190rpx; height: 190rpx; border: 3rpx solid #244332; border-radius: 22rpx; background: #dcebd3; box-sizing: border-box; }.cover-picker-label { position: absolute; left: 10rpx; right: 10rpx; bottom: 10rpx; padding: 8rpx 0; border-radius: 999rpx; background: rgba(22,59,42,.82); color: #fff; text-align: center; font-size: 18rpx; font-weight: 800; }.hero-fields { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }.cover-hint, .field-help { margin-top: 10rpx; color: #7b8c80; font-size: 19rpx; line-height: 1.5; }
.section-kicker { display: block; color: #477c43; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 800; }.section-title { display: block; margin-top: 7rpx; color: #163b2a; font-size: 34rpx; font-weight: 900; }.section-desc { display: block; margin-top: 8rpx; color: #748679; font-size: 22rpx; line-height: 1.55; }.inline-warning { display: block; margin-top: 14rpx; padding: 12rpx 15rpx; border-radius: 14rpx; background: #fff0c7; color: #8a5a12; font-size: 20rpx; }
.species-scroll { margin-top: 20rpx; width: 100%; white-space: nowrap; }.species-row { display: inline-flex; gap: 14rpx; padding: 4rpx 6rpx 12rpx 2rpx; }.species-card { width: 166rpx; overflow: hidden; border: 3rpx solid transparent; border-radius: 20rpx; background: #eef4e6; }.species-card.selected { border-color: #244332; box-shadow: 0 5rpx 0 #7cab77; }.species-image { width: 166rpx; height: 126rpx; display: block; background: #dcebd3; }.species-name { display: block; padding: 11rpx 8rpx 13rpx; overflow: hidden; text-overflow: ellipsis; text-align: center; color: #244332; font-size: 21rpx; font-weight: 800; }.species-card.unknown { height: 180rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; }.unknown-icon { width: 74rpx; height: 74rpx; line-height: 74rpx; border-radius: 50%; background: #f6ad35; color: #244332; text-align: center; font-size: 42rpx; font-weight: 900; }
.field-block { margin-top: 22rpx; }.field-label { display: block; margin-bottom: 9rpx; color: #355c43; font-size: 22rpx; font-weight: 800; }.text-input, .picker-field, .notes-input { width: 100%; box-sizing: border-box; border: 2rpx solid #a9bca9; border-radius: 18rpx; background: #f7faef; color: #244332; font-size: 25rpx; }.text-input { height: 78rpx; padding: 0 20rpx; }.name-input { font-size: 28rpx; font-weight: 750; }.picker-field { display: flex; align-items: center; justify-content: space-between; height: 78rpx; padding: 0 20rpx; }.notes-input { min-height: 180rpx; padding: 18rpx 20rpx; line-height: 1.6; }
.submit-btn { margin: 32rpx 28rpx 0; height: 92rpx; line-height: 92rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; box-shadow: 0 7rpx 0 #c77b22; font-size: 29rpx; font-weight: 900; }.submit-btn.disabled { opacity: .65; }
.state-card { display: flex; flex-direction: column; align-items: center; margin: 40rpx 28rpx; padding: 70rpx 30rpx; border: 3rpx dashed #8eaa91; border-radius: 28rpx; background: #fffdf7; color: #748679; font-size: 24rpx; }.loading-dot { width: 40rpx; height: 40rpx; margin-bottom: 20rpx; border: 7rpx solid #d6e4d2; border-top-color: #15803d; border-radius: 50%; animation: spin .9s linear infinite; }.state-title { color: #244332; font-size: 30rpx; font-weight: 900; }.state-desc { margin-top: 10rpx; text-align: center; line-height: 1.6; }.retry-btn { margin-top: 24rpx; padding: 0 34rpx; height: 74rpx; line-height: 74rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 23rpx; font-weight: 800; }
.topbar { padding-right: 210rpx; gap: 16rpx; }
.topbar .back-btn, .topbar .top-mark { flex: 0 0 72rpx; min-width: 72rpx; max-width: 72rpx; }
.topbar .brand-block { flex: 1; min-width: 0; }
.topbar .brand, .topbar .brand-sub { white-space: nowrap; }
@keyframes spin { to { transform: rotate(360deg); } }
