.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 80rpx; background: #f3f7e9; color: #244332; }
.intro-card, .current-card, .search-card, .result-card, .source-card, .error-card { border: 3rpx solid #244332; border-radius: 27rpx; background: #fffdf7; box-shadow: 7rpx 7rpx 0 #c9d8bd; }
.intro-card { padding: 28rpx; background: #dceefa; box-shadow: 7rpx 7rpx 0 #8cb9d8; }.kicker, .section-kicker { display: block; color: #2778c9; font-size: 16rpx; font-weight: 900; letter-spacing: 3rpx; }.title { display: block; margin-top: 7rpx; color: #191923; font-size: 46rpx; font-weight: 950; }.desc { display: block; margin-top: 10rpx; color: #5c7183; font-size: 21rpx; line-height: 1.6; }
.current-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 23rpx; }.current-city { display: block; margin-top: 6rpx; color: #191923; font-size: 29rpx; font-weight: 950; }.clear-btn { flex-shrink: 0; height: 58rpx; margin: 0; padding: 0 22rpx; line-height: 58rpx; border: 2rpx solid #a23c2b; border-radius: 999rpx; background: #fff1eb; color: #a23c2b; font-size: 18rpx; font-weight: 900; }.clear-btn::after, .search-btn::after, .location-btn::after, .city-row::after { border: 0; }
.search-card, .result-card { margin-top: 22rpx; padding: 24rpx; }.section-title { display: block; color: #191923; font-size: 28rpx; font-weight: 950; }.section-desc { display: block; margin-top: 7rpx; color: #687c6d; font-size: 19rpx; line-height: 1.55; }.search-row { display: flex; gap: 12rpx; margin-top: 18rpx; }.search-input { flex: 1; min-width: 0; height: 76rpx; box-sizing: border-box; padding: 0 20rpx; border: 2rpx solid #244332; border-radius: 18rpx; background: #f7f3e8; color: #191923; font-size: 22rpx; }.search-btn { width: 132rpx; height: 76rpx; margin: 0; padding: 0; line-height: 76rpx; border: 3rpx solid #244332; border-radius: 18rpx; background: #f6ad35; color: #244332; box-shadow: 0 5rpx 0 #c77b22; font-size: 21rpx; font-weight: 900; }.divider { display: flex; align-items: center; justify-content: center; margin: 23rpx 0 16rpx; color: #8b968d; font-size: 18rpx; }.divider::before, .divider::after { content: ''; flex: 1; height: 2rpx; background: #d7dfd3; }.divider text { padding: 0 15rpx; }.location-btn { width: 100%; height: 76rpx; margin: 0; line-height: 76rpx; border: 3rpx solid #244332; border-radius: 18rpx; background: #dff1d8; color: #244332; font-size: 22rpx; font-weight: 900; }.privacy-note { display: block; margin-top: 14rpx; color: #7b887e; font-size: 16rpx; line-height: 1.6; }
.error-card { margin-top: 22rpx; padding: 20rpx 22rpx; border-color: #a23c2b; background: #fff1eb; box-shadow: 6rpx 6rpx 0 #e6a08f; color: #a23c2b; font-size: 19rpx; line-height: 1.55; }.result-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 17rpx; }.city-row { width: 100%; min-height: 86rpx; display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin: 0; padding: 14rpx 17rpx; line-height: 1.3; border: 2rpx solid #9eb29d; border-radius: 18rpx; background: #f7faf4; text-align: left; }.city-copy { flex: 1; min-width: 0; }.city-name { display: block; color: #244332; font-size: 23rpx; font-weight: 900; }.city-meta { display: block; margin-top: 5rpx; overflow: hidden; color: #6f8175; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }.city-id { flex-shrink: 0; color: #2778c9; font-size: 16rpx; font-weight: 800; }
.source-card { display: flex; flex-direction: column; gap: 8rpx; margin-top: 22rpx; padding: 20rpx 22rpx; color: #6b776d; font-size: 16rpx; line-height: 1.55; box-shadow: none; }
