.detail-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 90rpx; background: #f3f7e9; color: #244332; }
.detail-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 10% 4%, rgba(166, 220, 153, .48), transparent 30%), radial-gradient(circle at 92% 12%, rgba(255, 190, 84, .25), transparent 26%); }
.topbar, .hero-card, .status-card, .info-card, .journal-card, .care-card, .action-card, .danger-card, .state-card { position: relative; z-index: 1; }.topbar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 26rpx 20rpx; }.back-btn, .edit-btn, .top-mark { height: 72rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3rpx solid #244332; border-radius: 22rpx; background: #fffdf7; color: #244332; box-shadow: 4rpx 4rpx 0 #c9d8bd; }.back-btn { width: 72rpx; margin: 0; padding: 0; font-size: 44rpx; line-height: 1; }.edit-btn { min-width: 92rpx; margin: 0; padding: 0 18rpx; font-size: 22rpx; font-weight: 850; }.top-mark { width: 72rpx; color: #ea580c; font-size: 34rpx; font-weight: 900; }.back-btn::after, .edit-btn::after, .retry-btn::after, .secondary-action::after, .danger-action::after, .care-add::after, .care-error button::after, .care-task-action::after, .journal-more::after, .journal-add::after { border: 0; }.brand-block { display: flex; flex-direction: column; align-items: center; }.brand { color: #163b2a; font-size: 32rpx; font-weight: 900; }.brand-sub { margin-top: 3rpx; color: #84958b; font-size: 16rpx; letter-spacing: 3rpx; }
.hero-card { height: 470rpx; margin: 8rpx 28rpx 22rpx; overflow: hidden; border: 3rpx solid #244332; border-radius: 30rpx; background: #dcebd3; box-shadow: 8rpx 8rpx 0 #7cab77; }.hero-image { width: 100%; height: 100%; }.hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(17,44,30,.02) 35%, rgba(17,44,30,.82) 100%); }.hero-copy { position: absolute; left: 26rpx; right: 26rpx; bottom: 26rpx; display: flex; flex-direction: column; align-items: flex-start; }.species-pill { padding: 7rpx 14rpx; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 20rpx; font-weight: 850; }.pet-name { margin-top: 10rpx; color: #fffdf7; font-size: 48rpx; line-height: 1.15; font-weight: 950; text-shadow: 2rpx 2rpx 0 #163b2a; }.pet-location { margin-top: 8rpx; color: #e2eee1; font-size: 23rpx; }
.status-card, .info-card, .journal-card, .care-card, .action-card, .danger-card { margin: 0 28rpx 22rpx; padding: 25rpx 26rpx; border: 3rpx solid #244332; border-radius: 26rpx; background: #fffdf7; box-shadow: 7rpx 7rpx 0 #c9d8bd; }.status-card.recorded { background: #dff2dc; }.status-card.incomplete, .status-card.due { background: #fff0c7; }.status-card.overdue { background: #ffe2da; }.status-card.archived { background: #e8ece7; }.status-head { display: flex; align-items: center; justify-content: space-between; }.status-label { color: #244332; font-size: 29rpx; font-weight: 900; }.status-mark { color: #15803d; font-size: 22rpx; }.status-card.incomplete .status-mark, .status-card.due .status-mark { color: #d38217; }.status-card.overdue .status-mark { color: #d94f35; }.status-card.archived .status-mark { color: #7a827d; }.status-reason { display: block; margin-top: 10rpx; color: #5f7465; font-size: 22rpx; line-height: 1.6; }
.section-kicker { display: block; margin-bottom: 10rpx; color: #477c43; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 850; }.info-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 26rpx; padding: 19rpx 0; border-bottom: 2rpx dashed #d4ded0; }.info-row:last-child { border-bottom: 0; }.info-label { flex-shrink: 0; color: #7a8b7e; font-size: 22rpx; }.info-value { color: #244332; font-size: 24rpx; font-weight: 750; text-align: right; }.notes-row { flex-direction: column; gap: 10rpx; }.notes-value { width: 100%; box-sizing: border-box; padding: 17rpx; border-radius: 16rpx; background: #f3f7e9; text-align: left; line-height: 1.6; font-weight: 500; }
.journal-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding-bottom: 16rpx; border-bottom: 2rpx dashed #d4ded0; }.journal-title { display: block; color: #244332; font-size: 28rpx; font-weight: 900; }.journal-head-actions { flex-shrink: 0; display: flex; gap: 8rpx; }.journal-more, .journal-add { height: 58rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 15rpx; border: 2rpx solid #244332; border-radius: 999rpx; color: #244332; font-size: 18rpx; font-weight: 850; }.journal-more { background: #e8f0e3; }.journal-add { background: #f6ad35; }.journal-empty { padding: 26rpx 2rpx 5rpx; color: #75877a; font-size: 21rpx; line-height: 1.6; }.journal-preview-list { display: flex; flex-direction: column; padding-top: 8rpx; }.journal-preview { display: flex; align-items: center; gap: 13rpx; padding: 14rpx 0; border-bottom: 2rpx dashed #d4ded0; }.journal-preview:last-child { border-bottom: 0; }.journal-preview-photo { width: 82rpx; height: 82rpx; flex-shrink: 0; border: 2rpx solid #244332; border-radius: 15rpx; }.journal-preview-copy { flex: 1; min-width: 0; }.journal-preview-date { display: block; color: #477c43; font-size: 16rpx; font-weight: 850; }.journal-preview-title { display: block; margin-top: 4rpx; overflow: hidden; color: #244332; font-size: 22rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.journal-preview-content { display: block; margin-top: 3rpx; overflow: hidden; color: #7a8b7e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.journal-preview-arrow { color: #ea580c; font-size: 31rpx; }
.care-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding-bottom: 16rpx; border-bottom: 2rpx dashed #d4ded0; }.care-title { display: block; color: #244332; font-size: 28rpx; font-weight: 900; }.care-add { flex-shrink: 0; margin: 0; padding: 0 20rpx; height: 62rpx; line-height: 62rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 19rpx; font-weight: 850; }.care-empty, .care-error { padding: 28rpx 4rpx 8rpx; color: #75877a; font-size: 21rpx; line-height: 1.6; }.care-error { display: flex; align-items: center; justify-content: space-between; }.care-error button { margin: 0; padding: 0; border: 0; background: transparent; color: #ea580c; font-size: 20rpx; font-weight: 850; }
.care-list { display: flex; flex-direction: column; gap: 13rpx; padding-top: 17rpx; }.care-task { padding: 16rpx; border: 2rpx solid #cbdac5; border-radius: 19rpx; background: #f7faf4; }.care-task.completed { opacity: .72; }.care-task.overdue { border-color: #e6a08f; background: #fff7f4; }.care-task-main { display: flex; gap: 13rpx; }.care-task-icon { width: 50rpx; height: 50rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid #244332; border-radius: 14rpx; background: #dff1d8; font-size: 24rpx; }.care-task-copy { flex: 1; min-width: 0; }.care-task-line { display: flex; align-items: flex-start; gap: 9rpx; }.care-task-title { flex: 1; color: #244332; font-size: 23rpx; font-weight: 900; }.care-task-status { flex-shrink: 0; color: #9a5a08; font-size: 16rpx; font-weight: 850; }.care-task.overdue .care-task-status { color: #a23c2b; }.care-task.completed .care-task-status { color: #176b3a; }.care-task-meta, .care-task-desc { display: block; margin-top: 5rpx; color: #75877a; font-size: 18rpx; line-height: 1.5; }.care-task-desc { color: #536b5b; }.care-task-actions { display: flex; gap: 7rpx; margin-top: 13rpx; }.care-task-action { flex: 1; height: 55rpx; margin: 0; padding: 0 6rpx; line-height: 55rpx; border: 2rpx solid #244332; border-radius: 13rpx; font-size: 17rpx; font-weight: 850; }.care-task-action.complete { background: #15803d; color: #fff; }.care-task-action.postpone { background: #fff0c7; color: #7c510d; }.care-task-action.edit { background: #e8f0e3; color: #244332; }.care-task-action.delete { background: #fff7f4; color: #a23c2b; }
.secondary-action, .danger-action { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 850; }.secondary-action { border: 3rpx solid #244332; background: #fff0c7; color: #7c510d; box-shadow: 0 5rpx 0 #d9ae54; }.action-help { display: block; margin-top: 13rpx; color: #7a8b7e; text-align: center; font-size: 20rpx; }.danger-card { border-color: #9f3e2d; box-shadow: 7rpx 7rpx 0 #e4a08d; }.danger-title { color: #9f3e2d; font-size: 27rpx; font-weight: 900; }.danger-desc { display: block; margin-top: 8rpx; color: #7f655f; font-size: 21rpx; line-height: 1.55; }.danger-action { margin-top: 20rpx; border: 3rpx solid #7c2d20; background: #d94f35; color: #fffdf7; box-shadow: 0 5rpx 0 #9f3e2d; }
.state-card { display: flex; flex-direction: column; align-items: center; margin: 40rpx 28rpx; padding: 70rpx 30rpx; border: 3rpx dashed #8eaa91; border-radius: 28rpx; background: #fffdf7; color: #748679; font-size: 24rpx; }.loading-dot { width: 40rpx; height: 40rpx; margin-bottom: 20rpx; border: 7rpx solid #d6e4d2; border-top-color: #15803d; border-radius: 50%; animation: spin .9s linear infinite; }.state-title { color: #244332; font-size: 30rpx; font-weight: 900; }.state-desc { margin-top: 10rpx; text-align: center; line-height: 1.6; }.retry-btn { margin-top: 24rpx; padding: 0 34rpx; height: 74rpx; line-height: 74rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 23rpx; font-weight: 800; }
.topbar { padding-right: 210rpx; gap: 16rpx; }
.topbar .back-btn { flex: 0 0 72rpx; min-width: 72rpx; max-width: 72rpx; }
.topbar .edit-btn { flex: 0 0 92rpx; min-width: 92rpx; max-width: 92rpx; }
.topbar .brand-block { flex: 1; min-width: 0; }
.topbar .brand { white-space: nowrap; }
@keyframes spin { to { transform: rotate(360deg); } }
