<view class="garden-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="topbar">
    <button class="back-btn" bindtap="goBackHome">‹</button>
    <view class="brand-block"><text class="brand">我的花园</text><text class="brand-sub">PLANT GALLERY</text></view>
    <view class="more-btn">···</view>
  </view>

  <view class="garden-intro"><text class="intro-kicker">植宠收藏</text><text class="intro-title">一起照顾每一盆植物</text><text class="intro-subtitle">{{summaryText}}</text></view>

  <scroll-view class="list-scroll" scroll-y>
    <view class="device-list">
      <block wx:for="{{devices}}" wx:key="logicalKey">
        <view class="device-entry" bindtap="openDeviceDetail" data-logicalkey="{{item.logicalKey}}">
          <image class="device-image" src="{{item.image}}" mode="aspectFill" />
          <view class="device-main">
            <view class="top-row"><text class="name">{{item.alias}}</text><text class="online {{item.online ? 'ok' : 'offline'}}">{{item.online ? '在线' : '离线'}}</text></view>
            <text class="meta">{{item.location}} · 智能花盆</text>
            <text class="plant-type">植物类型：{{item.plantType}}</text>
            <view class="status-line {{item.statusType}}"><view class="status-dot"></view><text>{{item.statusText}}</text><text class="detail-arrow">查看详情 ›</text></view>
          </view>
        </view>
      </block>

      <view wx:if="{{!hasDevices}}" class="empty-state" bindtap="openDeviceManager">
        <text class="empty-icon">＋</text><text class="empty-title">还没有绑定设备</text><text class="empty-desc">绑定一台智能花盆，开始收集植宠的状态和成长记录。</text><view class="empty-btn"><text class="empty-btn-text">去绑定设备</text></view>
      </view>
    </view>
  </scroll-view>

  <view class="fab" hover-class="pressed" bindtap="openDeviceManager"><text class="fab-plus">+</text><text class="fab-label">添加设备</text></view>
</view>
