.task-form-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 170rpx; background: #f3f7e9; color: #244332; }
.task-form-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 8% 4%, rgba(166,220,153,.46), transparent 30%), radial-gradient(circle at 92% 12%, rgba(255,190,84,.24), transparent 26%); }
.topbar, .form-card, .state-card, .submit-bar { position: relative; z-index: 1; }
.topbar { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 26rpx 22rpx; }
.back-btn, .top-mark { width: 72rpx; height: 72rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 3rpx solid #244332; border-radius: 22rpx; background: #fffdf7; color: #244332; box-shadow: 4rpx 4rpx 0 #c9d8bd; }
.back-btn { font-size: 44rpx; }.back-btn::after, .state-btn::after, .submit-btn::after, .cancel-proposal-btn::after { border: 0; }.top-mark { color: #15803d; font-size: 30rpx; font-weight: 900; }
.title-block { flex: 1; min-width: 0; display: flex; flex-direction: column; }.page-title { color: #163b2a; font-size: 34rpx; font-weight: 900; }.page-subtitle { margin-top: 3rpx; color: #76887b; font-size: 19rpx; }
.form-card { margin: 0 28rpx 22rpx; padding: 27rpx 26rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: #fffdf7; box-shadow: 7rpx 7rpx 0 #c9d8bd; }
.section-kicker { display: block; margin-bottom: 8rpx; color: #477c43; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 850; }
.field-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 2rpx dashed #d4ded0; }.field-row:last-child { border-bottom: 0; }.sub-row { padding-left: 22rpx; background: #f3f7e9; border-radius: 16rpx; border-bottom: 0; }
.field-block { padding: 19rpx 0 4rpx; }.field-label { color: #52695a; font-size: 23rpx; font-weight: 750; }.field-help { display: block; margin-top: 4rpx; color: #8b998e; font-size: 18rpx; }.label-copy { flex: 1; }.field-control { flex: 1; }.picker-value { color: #244332; text-align: right; font-size: 24rpx; font-weight: 800; }
.text-input, .text-area { width: 100%; box-sizing: border-box; margin-top: 11rpx; padding: 18rpx; border: 2rpx solid #cbdac5; border-radius: 17rpx; background: #f4f9ef; color: #244332; font-size: 24rpx; }.text-area { min-height: 130rpx; line-height: 1.6; }
.interval-input { width: 130rpx; box-sizing: border-box; padding: 14rpx 18rpx; border: 2rpx solid #cbdac5; border-radius: 15rpx; background: #fffdf7; text-align: center; font-size: 24rpx; font-weight: 800; }
.picker-locked { color: #607066; }.picker-locked text { margin-left: 10rpx; color: #8b998e; font-size: 18rpx; font-weight: 700; }
.rule-note { margin-top: 22rpx; padding: 19rpx; border-radius: 18rpx; background: #fff0c7; }.rule-note-title { display: block; color: #7c510d; font-size: 22rpx; font-weight: 850; }.rule-note-desc { display: block; margin-top: 7rpx; color: #7f6b43; font-size: 20rpx; line-height: 1.55; }
.state-card { display: flex; flex-direction: column; align-items: center; margin: 38rpx 28rpx; padding: 70rpx 30rpx; border: 3rpx dashed #8eaa91; border-radius: 28rpx; background: #fffdf7; color: #748679; font-size: 24rpx; text-align: center; }.loading-dot { width: 40rpx; height: 40rpx; margin-bottom: 20rpx; border: 7rpx solid #d6e4d2; border-top-color: #15803d; border-radius: 50%; animation: spin .9s linear infinite; }.state-title { color: #244332; font-size: 30rpx; font-weight: 900; }.state-desc { margin-top: 10rpx; line-height: 1.6; }.state-btn { margin-top: 24rpx; padding: 0 34rpx; height: 74rpx; line-height: 74rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; font-size: 23rpx; font-weight: 800; }
.submit-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(243,247,233,.96); }.submit-btn { flex: 1; width: auto; height: 88rpx; line-height: 88rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; box-shadow: 0 6rpx 0 #c77b22; font-size: 26rpx; font-weight: 900; }.cancel-proposal-btn { width: 190rpx; height: 88rpx; line-height: 82rpx; margin: 0; padding: 0 20rpx; border: 3rpx solid #9f2d2d; border-radius: 999rpx; background: #fffdf7; color: #9f2d2d; font-size: 23rpx; font-weight: 850; }
@keyframes spin { to { transform: rotate(360deg); } }
