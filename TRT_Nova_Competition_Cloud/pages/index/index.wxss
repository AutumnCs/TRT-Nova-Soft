.garden-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 190rpx; background: #f3f7e9; color: #244332; }
.garden-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 10% 5%, rgba(166, 220, 153, .5), transparent 31%), radial-gradient(circle at 92% 12%, rgba(255, 190, 84, .28), transparent 27%); }
.page-head, .summary-card, .weather-card, .today-card, .view-tabs, .content-area, .add-fab { position: relative; z-index: 1; }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 38rpx 30rpx 22rpx; }
.head-copy { flex: 1; min-width: 0; }.kicker { display: block; color: #477c43; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 750; }.title { display: block; margin-top: 6rpx; color: #163b2a; font-size: 54rpx; line-height: 1.15; font-weight: 900; }.subtitle { display: block; margin-top: 10rpx; color: #6f8275; font-size: 23rpx; }
.knowledge-btn { flex-shrink: 0; width: 112rpx; min-height: 96rpx; margin: 0; padding: 12rpx 8rpx; border: 3rpx solid #244332; border-radius: 24rpx; background: #fffdf7; color: #244332; box-shadow: 5rpx 5rpx 0 #c9d8bd; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.knowledge-btn::after, .state-btn::after, .add-fab::after { border: 0; }.knowledge-icon { font-size: 34rpx; line-height: 1; font-weight: 900; }.knowledge-text { margin-top: 7rpx; font-size: 19rpx; font-weight: 750; }
.summary-card { display: flex; align-items: center; justify-content: space-between; margin: 6rpx 28rpx 22rpx; padding: 24rpx 26rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: #a8d99b; box-shadow: 7rpx 7rpx 0 #7cab77; overflow: hidden; }
.summary-main { display: flex; align-items: center; gap: 18rpx; }.summary-number { color: #163b2a; font-size: 66rpx; line-height: 1; font-weight: 950; }.summary-copy { display: flex; flex-direction: column; }.summary-title { color: #163b2a; font-size: 27rpx; font-weight: 850; }.summary-desc { margin-top: 6rpx; color: #47704a; font-size: 20rpx; }.summary-sprout { color: #f6ad35; font-size: 64rpx; transform: rotate(14deg); text-shadow: 3rpx 3rpx 0 #244332; }
.weather-card { margin: 0 28rpx 22rpx; padding: 23rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: #dceefa; box-shadow: 7rpx 7rpx 0 #8cb9d8; }.weather-card.stale { background: #f1eee5; box-shadow: 7rpx 7rpx 0 #c5bda8; }.weather-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }.weather-kicker { display: block; color: #2778c9; font-size: 16rpx; letter-spacing: 2rpx; font-weight: 900; }.weather-city { display: block; margin-top: 6rpx; color: #191923; font-size: 27rpx; font-weight: 950; }.weather-setting { flex-shrink: 0; color: #ef3d4b; font-size: 19rpx; font-weight: 900; }.weather-loading { display: flex; align-items: center; gap: 14rpx; min-height: 108rpx; color: #5c7183; font-size: 21rpx; }.weather-loading-dot { width: 30rpx; height: 30rpx; border: 5rpx solid rgba(39,120,201,.2); border-top-color: #2778c9; border-radius: 50%; animation: spin .9s linear infinite; }.weather-facts { display: flex; align-items: center; gap: 15rpx; padding: 18rpx 0 14rpx; }.weather-icon { font-size: 60rpx; line-height: 1; }.weather-primary { display: flex; align-items: flex-end; gap: 10rpx; }.weather-temp { color: #191923; font-size: 55rpx; line-height: 1; font-weight: 950; }.weather-desc { padding-bottom: 5rpx; color: #385b70; font-size: 22rpx; font-weight: 850; }.weather-secondary { display: flex; flex-direction: column; gap: 4rpx; margin-left: auto; color: #577386; font-size: 18rpx; text-align: right; }.weather-unavailable { display: flex; align-items: center; gap: 15rpx; min-height: 108rpx; }.weather-unavailable-icon { width: 52rpx; height: 52rpx; line-height: 49rpx; border: 3rpx solid #191923; border-radius: 50%; color: #2778c9; text-align: center; font-size: 32rpx; font-weight: 900; }.weather-unavailable-title { display: block; color: #191923; font-size: 24rpx; font-weight: 900; }.weather-unavailable-desc { display: block; margin-top: 5rpx; color: #617687; font-size: 19rpx; }.weather-proof { display: flex; flex-wrap: wrap; gap: 7rpx 14rpx; padding: 11rpx 0 14rpx; border-top: 2rpx dashed rgba(25,25,35,.18); color: #5b7080; font-size: 17rpx; }.weather-cache-state { color: #176b3a; font-weight: 900; }.weather-card.stale .weather-cache-state { color: #9a5a08; }.solar-term-block { padding: 16rpx 17rpx; border: 2rpx solid #244332; border-radius: 19rpx; background: #fffdf7; }.solar-term-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.solar-term-name { color: #ef3d4b; font-size: 28rpx; font-weight: 950; }.solar-term-next { color: #7b6c54; font-size: 17rpx; font-weight: 800; }.solar-term-tip { display: block; margin-top: 9rpx; color: #3e5848; font-size: 20rpx; line-height: 1.55; }.solar-term-boundary { display: block; margin-top: 8rpx; color: #8c8a82; font-size: 15rpx; line-height: 1.5; }
.today-card { margin: 0 28rpx 22rpx; padding: 23rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: #fffdf7; box-shadow: 7rpx 7rpx 0 #c9d8bd; }.today-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding-bottom: 17rpx; border-bottom: 2rpx dashed #c9d8bd; }.today-kicker { display: block; color: #477c43; font-size: 16rpx; letter-spacing: 3rpx; font-weight: 800; }.today-title { display: block; margin-top: 5rpx; color: #244332; font-size: 27rpx; font-weight: 900; }.streak-chip { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding: 10rpx 16rpx; border-radius: 17rpx; background: #fff0c7; }.streak-number { color: #ea580c; font-size: 30rpx; line-height: 1; font-weight: 950; }.streak-label { margin-top: 4rpx; color: #806431; font-size: 15rpx; }
.home-task-list { display: flex; flex-direction: column; gap: 11rpx; padding-top: 16rpx; }.home-task { display: flex; align-items: center; gap: 12rpx; padding: 14rpx; border: 2rpx solid #cbdac5; border-radius: 18rpx; background: #f7faf4; }.home-task.overdue { border-color: #e6a08f; background: #fff7f4; }.home-task-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid #244332; border-radius: 14rpx; background: #dff1d8; font-size: 24rpx; }.home-task-copy { flex: 1; min-width: 0; }.home-task-line { display: flex; align-items: center; gap: 8rpx; }.home-task-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #244332; font-size: 22rpx; font-weight: 850; }.home-task-status { flex-shrink: 0; color: #a23c2b; font-size: 16rpx; font-weight: 800; }.home-task-meta { display: block; margin-top: 5rpx; color: #75877a; font-size: 18rpx; }.check-btn { flex-shrink: 0; height: 54rpx; margin: 0; padding: 0 17rpx; line-height: 54rpx; border: 2rpx solid #244332; border-radius: 999rpx; background: #15803d; color: #fff; font-size: 18rpx; font-weight: 850; }.check-btn::after { border: 0; }
.today-empty, .task-error { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; padding: 23rpx 4rpx 8rpx; color: #75877a; font-size: 20rpx; }.today-empty button, .task-error button { flex-shrink: 0; margin: 0; padding: 0; border: 0; background: transparent; color: #ea580c; font-size: 20rpx; font-weight: 850; }.today-empty button::after, .task-error button::after { border: 0; }.today-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 15rpx; padding-top: 14rpx; border-top: 2rpx dashed #d4ded0; color: #ea580c; font-size: 20rpx; font-weight: 850; }
.view-tabs { display: flex; gap: 12rpx; margin: 0 28rpx 20rpx; padding: 8rpx; border: 3rpx solid #244332; border-radius: 24rpx; background: #fffdf7; }
.view-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 17rpx 12rpx; border-radius: 17rpx; color: #738578; font-size: 24rpx; font-weight: 800; }.view-tab.active { background: #f6ad35; color: #244332; box-shadow: inset 0 -4rpx 0 #c77b22; }.tab-count { min-width: 36rpx; padding: 2rpx 8rpx; border-radius: 999rpx; background: rgba(255,255,255,.65); text-align: center; font-size: 19rpx; }
.content-area { padding: 0 28rpx; }.pet-list { display: flex; flex-direction: column; gap: 18rpx; }
.pet-card { display: flex; gap: 20rpx; padding: 18rpx; border: 3rpx solid #244332; border-radius: 28rpx; background: rgba(255, 253, 247, .96); box-shadow: 7rpx 7rpx 0 #c9d8bd; }
.pet-image { width: 196rpx; height: 230rpx; flex-shrink: 0; border: 3rpx solid #244332; border-radius: 22rpx; background: #dcebd3; }.pet-main { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 4rpx 2rpx; }.pet-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx; }.pet-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #163b2a; font-size: 32rpx; font-weight: 900; }
.status-pill { flex-shrink: 0; padding: 6rpx 11rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }.status-pill.recorded { color: #176b3a; background: #dff2dc; }.status-pill.incomplete, .status-pill.due { color: #9a5a08; background: #fff0c7; }.status-pill.overdue { color: #a23c2b; background: #ffe2da; }.status-pill.archived { color: #667069; background: #e8ece7; }
.species-name { margin-top: 8rpx; color: #477c43; font-size: 23rpx; font-weight: 750; }.pet-meta { display: flex; flex-direction: column; gap: 5rpx; margin-top: 13rpx; color: #75877a; font-size: 20rpx; }.status-reason { margin-top: 13rpx; color: #5f7465; font-size: 20rpx; line-height: 1.48; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }.detail-link { display: flex; justify-content: flex-end; gap: 8rpx; margin-top: auto; padding-top: 10rpx; color: #ea580c; font-size: 21rpx; font-weight: 850; }
.state-card { display: flex; flex-direction: column; align-items: center; padding: 76rpx 34rpx; text-align: center; border: 3rpx dashed #8eaa91; border-radius: 28rpx; background: rgba(255, 253, 247, .92); }.state-icon { width: 78rpx; height: 78rpx; line-height: 78rpx; border: 3rpx solid #244332; border-radius: 50%; background: #f6ad35; color: #244332; font-size: 42rpx; font-weight: 900; }.state-title { margin-top: 20rpx; color: #244332; font-size: 31rpx; font-weight: 900; }.state-desc { margin-top: 12rpx; color: #748679; font-size: 23rpx; line-height: 1.65; }.state-btn { margin-top: 28rpx; padding: 0 38rpx; height: 78rpx; line-height: 78rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; box-shadow: 0 6rpx 0 #c77b22; font-size: 24rpx; font-weight: 850; }
.loading-dot { width: 42rpx; height: 42rpx; border: 7rpx solid #d6e4d2; border-top-color: #15803d; border-radius: 50%; animation: spin .9s linear infinite; }.error-state .state-icon { color: #fff; background: #d94f35; }
.add-fab { position: fixed; right: 34rpx; bottom: 146rpx; display: flex; align-items: center; gap: 8rpx; margin: 0; padding: 0 28rpx; height: 92rpx; border: 3rpx solid #244332; border-radius: 999rpx; background: #f6ad35; color: #244332; box-shadow: 0 7rpx 0 #c77b22, 0 14rpx 24rpx rgba(79, 67, 30, .18); }.fab-plus { font-size: 38rpx; font-weight: 900; }.fab-label { font-size: 24rpx; font-weight: 900; }
@keyframes spin { to { transform: rotate(360deg); } }
