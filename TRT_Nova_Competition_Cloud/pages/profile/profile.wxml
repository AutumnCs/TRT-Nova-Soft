<view class="page"><view class="grid-bg"></view><scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}"><view class="top-shell" style="padding-top: {{statusBarHeight}}px;"><view class="top-bar"><view class="top-icon">‹</view><view class="top-title">我的档案</view><view class="top-signal">●</view></view><view class="hero-card"><view class="hero-burst"></view><view class="hero-avatar-wrap"><view class="avatar-ring"></view><image src="{{user.avatar}}" mode="aspectFill" class="avatar-lg" binderror="onAvatarError"></image><view class="avatar-status"></view></view><text class="user-name">{{user.name}}</text><view class="user-level-pill"><text class="user-level-icon">✦</text><text class="user-level">{{user.level}}</text></view><text class="hero-caption">记录你的植宠宇宙</text></view></view><view class="growth-card" bindtap="openGrowthTimeline"><view class="growth-head"><view><text class="growth-kicker">RECENT GROWTH</text><text class="growth-title">最近成长</text></view><text class="growth-more">全部 ›</text></view><text wx:if="{{growthLoading}}" class="growth-empty">正在整理记录…</text><text wx:elif="{{!recentGrowth.length}}" class="growth-empty">还没有成长记录，点击这里写下第一篇。</text><view wx:else class="growth-list"><view wx:for="{{recentGrowth}}" wx:key="id" class="growth-item"><image wx:if="{{item.coverPhoto}}" class="growth-photo" src="{{item.coverPhoto}}" mode="aspectFill" /><view class="growth-copy"><text class="growth-item-title">{{item.title}}</text><text class="growth-meta">{{item.plantPetName}} · {{item.dateLabel}}</text></view></view></view></view><view class="menu-list"><block wx:for="{{menu}}" wx:key="index"><view class="menu-item" hover-class="pressed" bindtap="onMenuItemTap" data-index="{{index}}"><view class="menu-left"><view class="menu-icon-wrap"><text class="menu-icon">{{item.icon}}</text></view><view class="menu-copy"><text class="menu-title">{{item.title}}</text><text class="menu-desc">{{item.desc}}</text></view></view><view class="menu-right"><text class="menu-tail">{{item.tail}}</text><text class="arrow">›</text></view></view></block><view class="menu-item logout-item" hover-class="pressed" bindtap="onLogout"><view class="menu-left"><view class="menu-icon-wrap logout-wrap"><text class="menu-icon logout-icon">↗</text></view><view class="menu-copy"><text class="menu-title logout-title">退出登录</text><text class="menu-desc logout-desc">清除本地登录状态</text></view></view><view class="menu-right"><text class="menu-tail logout-tail">退出</text><text class="arrow logout-arrow">›</text></view></view></view><view class="bottom-spacer"></view></scroll-view></view>
