<view class="page">
  <view class="grid-bg"></view>
  <view class="scanline"></view>

  <view class="shell">
    <view class="topbar">
      <view class="topbar-left">
        <text class="eyebrow">CONFIG MODE</text>
        <text class="title">Device Settings</text>
      </view>
      <view class="status-pill {{selectedPlant ? 'status-pill-on' : 'status-pill-off'}}">
        <text class="status-dot"></text>
        <text class="status-text">{{selectedPlant ? 'READY' : 'WAITING'}}</text>
      </view>
    </view>

    <view class="hero-card">
      <view class="hero-icon-wrap">
        <view class="hero-icon-glow"></view>
        <view class="hero-icon">
          <text class="hero-icon-text">◎</text>
        </view>
      </view>

      <view class="hero-main">
        <view class="hero-headline-row">
          <text class="hero-id">ID: {{logicalKey || 'UNASSIGNED'}}</text>
          <view class="hero-online {{selectedPlant ? 'online' : 'offline'}}">
            <text class="hero-online-dot"></text>
            <text class="hero-online-text">{{selectedPlant ? 'ONLINE' : 'OFFLINE'}}</text>
          </view>
        </view>
        <text class="hero-name">{{alias || 'Device Alias'}}</text>
        <text class="hero-sub">{{selectedPlant ? selectedPlant.name : 'Monstera Deliciosa'}}</text>
      </view>
    </view>

    <view class="section-label">DEVICE PROFILE</view>

    <view class="form-card">
      <view class="row">
        <text class="label">设备别名 <text class="label-en">[Device Alias]</text></text>
        <view class="field-shell">
          <text class="field-prefix">></text>
          <input class="input" placeholder="请输入设备别名" value="{{alias}}" bindinput="onAliasInput" />
        </view>
      </view>

      <view class="row" bindtap="openPlantPicker">
        <text class="label">植物种类 <text class="label-en">[Plant Type]</text></text>
        <view class="field-shell picker-shell {{selectedPlant ? '' : 'placeholder-shell'}}">
          <view wx:if="{{selectedPlant}}" class="picker-row">
            <image class="picker-thumb" src="{{selectedPlant.image}}" mode="aspectFill" />
            <view class="picker-info">
              <text class="picker-name">{{selectedPlant.name}}</text>
              <text class="picker-family">{{selectedPlant.family}}</text>
            </view>
            <text class="picker-arrow">▾</text>
          </view>
          <view wx:else class="picker-row">
            <text class="picker-placeholder-text">请选择植物</text>
            <text class="picker-arrow">▾</text>
          </view>
        </view>
      </view>

      <view class="row">
        <text class="label">地理位置 <text class="label-en">[Location]</text></text>
        <view class="field-shell">
          <text class="field-prefix">#</text>
          <input class="input" placeholder="请输入种植地点" value="{{location}}" bindinput="onLocationInput" />
        </view>
      </view>
    </view>

    <view class="section-label">NETWORK PROVISION</view>

    <view class="provision-card">
      <view class="provision-head">
        <text class="provision-title">设备配网</text>
        <text class="provision-tag">Browser Setup</text>
      </view>
      <text class="provision-desc">
        如果设备还没有连上家的 Wi-Fi，请先连接设备热点，再用浏览器打开下面地址完成配网。
      </text>
      <view class="provision-url-box">
        <text class="provision-url">{{provisionUrl}}</text>
      </view>
      <view class="provision-actions">
        <button class="ghost-btn" bindtap="showProvisionGuide">查看说明</button>
        <button class="copy-btn" bindtap="copyProvisionUrl">复制地址</button>
      </view>
    </view>

    <view class="section-label danger">DANGER ZONE</view>

    <view class="danger-card">
      <view class="danger-icon">!</view>
      <view class="danger-body">
        <text class="danger-title">解除绑定</text>
        <text class="danger-desc">
          解绑后设备将从当前账号移除，原有设备信息会保留在系统中，方便后续重新绑定。
        </text>
      </view>
      <view class="danger-action">
        <text class="danger-btn-text">UNBIND</text>
      </view>
    </view>

    <button class="save-btn" bindtap="onSave" loading="{{saving}}">保存设置</button>
  </view>
</view>

<view wx:if="{{showPlantPicker}}" class="picker-mask" catchtap="closePlantPicker">
  <view class="picker-panel" catchtap="stopPropagation">
    <view class="picker-header">
      <view>
        <text class="picker-title">选择植物</text>
        <text class="picker-subtitle">Pick a plant for this device</text>
      </view>
      <view class="picker-close" bindtap="closePlantPicker">×</view>
    </view>

    <view class="picker-toolbar">
      <view class="picker-search-box">
        <view class="picker-search-badge">
          <text class="picker-search-badge-text">SEARCH</text>
        </view>
        <input
          class="picker-search-input"
          placeholder="搜索植物名称或科属"
          placeholder-class="picker-placeholder"
          bindinput="onPickerKeywordInput"
          bindconfirm="onPickerSearchConfirm"
          value="{{pickerKeyword}}"
          focus="{{pickerInputFocus}}"
          confirm-type="done"
        />
      </view>
    </view>

    <scroll-view scroll-y="true" class="picker-list" show-scrollbar="{{false}}">
      <view wx:if="{{pickerPlants.length === 0}}" class="picker-empty">
        <text>未找到相关植物</text>
      </view>
      <view
        wx:for="{{pickerPlants}}"
        wx:key="id"
        class="picker-item {{selectedPlant && selectedPlant.id === item.id ? 'picker-item-selected' : ''}}"
        bindtap="selectPlant"
        data-id="{{item.id}}"
      >
        <image class="picker-item-img" src="{{item.image}}" mode="aspectFill" />
        <view class="picker-item-info">
          <view class="picker-item-name-row">
            <text class="picker-item-name">{{item.name}}</text>
            <text wx:if="{{item.isFavorite}}" class="picker-fav-badge">收藏</text>
          </view>
          <text class="picker-item-family">{{item.family}}</text>
          <view class="picker-item-tag picker-tag-{{item.feature}}">{{item.featureText}}</view>
        </view>
        <view wx:if="{{selectedPlant && selectedPlant.id === item.id}}" class="picker-check">OK</view>
      </view>
    </scroll-view>
  </view>
</view>
