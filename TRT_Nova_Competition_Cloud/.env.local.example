# 竞赛本地配置模板。npm run local:setup 生成独立密码、JWT 和本机端口配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nova_competition_local
DB_USER=nova_competition
DB_PASSWORD=<generated-by-local-setup>
DB_CONN_LIMIT=5

# 仅供绑定到 127.0.0.1 的本地开发服务器签发测试 JWT。
JWT_SECRET=<local-development-jwt-secret>
LOCAL_DEV_AUTH_ENABLED=true
# 登录页的本地稳定测试身份，不是真实微信 openid。
LOCAL_DEV_OPENID=dev_wechat_user
ALLOW_LEGACY_OPENID_FALLBACK=0

# 仅本地开发启用：图片内容写入独立测试库，不调用 CloudBase/COS。
LOCAL_MEDIA_ENABLED=true

# 本地 Chat/Vision 共用同一凭证。Key 文件由本地后端读取，不复制进本仓库。
LLM_API_ENABLED=false
LLM_API_BASE_URL=
LLM_API_PATH=/chat/completions
LLM_API_KEY_FILE=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=700

# 影子运行默认关闭，不增加旁路模型调用。
AGENT_SHADOW_ENABLED=false
AGENT_SHADOW_FINGERPRINT_KEY=<local-shadow-hmac-secret>
AGENT_SHADOW_SAMPLE_RATE=1
AGENT_SHADOW_MAX_STEPS=3
AGENT_SHADOW_MAX_TOOL_CALLS=5
AGENT_SHADOW_TIMEOUT_MS=12000
AGENT_SHADOW_MAX_TOKENS=320

# 竞赛版使用已接受的内部运行时；不改变工具写入确认边界。
AGENT_ROLLOUT_ENABLED=true
AGENT_ROLLOUT_COHORT_KEY=<local-rollout-hmac-secret>
AGENT_ROLLOUT_SAMPLE_RATE=1
AGENT_ROLLOUT_MAX_STEPS=3
AGENT_ROLLOUT_MAX_TOOL_CALLS=5
AGENT_ROLLOUT_TIMEOUT_MS=12000
AGENT_ROLLOUT_MAX_TOKENS=700
VISION_MODEL=
VISION_IMAGE_DETAIL=low
VISION_TIMEOUT_MS=30000

# 和风天气只由本地/云端后端访问。私钥文件放在仓库外，不要把内容发到聊天或写进 Git。
QWEATHER_ENABLED=false
QWEATHER_API_HOST=
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY_FILE=
QWEATHER_TIMEOUT_MS=5000

LOCAL_PORT=3000
