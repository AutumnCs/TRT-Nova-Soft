# api-scf environment variables
# Replace the placeholders below before deployment.

# Database connection
DB_HOST=<database-host>
DB_PORT=<database-port>
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_CONN_LIMIT=5

# Must match auth-scf
JWT_SECRET=<same-as-auth-scf>
