/* pages/wiki/wiki.wxss */
page {
  background-color: #F3F4F6;
  font-family: -apple-system, sans-serif;
  color: #1F2937;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.scroll-content {
  flex: 1;
  padding-top: 10px;
  box-sizing: border-box;
}

/* Search */
.search-box-container {
  padding: 0 16px 16px;
}

.search-box {
  background-color: white;
  height: 44px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.search-icon {
  margin-right: 8px;
  font-size: 14px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  height: 100%;
}

.placeholder {
  color: #9CA3AF;
}

/* Post Card */
.post-list {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.post-card {
  background-color: white;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  transition: transform 0.2s;
}

.post-card:active {
  transform: scale(0.99);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.post-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin-right: 12px;
  background-color: #E5E7EB;
}

.post-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-username {
  font-size: 15px;
  font-weight: 600;
  color: #1F2937;
}

.post-time {
  font-size: 12px;
  color: #9CA3AF;
}

.post-more {
  color: #9CA3AF;
  font-weight: 700;
  padding: 0 8px;
}

.post-content {
  margin-bottom: 12px;
}

.post-text {
  font-size: 15px;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 8px;
  display: block;
}

.post-image {
  width: 100%;
  height: 200px;
  border-radius: 12px;
  background-color: #F3F4F6;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #F3F4F6;
  padding-top: 12px;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border-radius: 8px;
  transition: background-color 0.2s;
}

.action-btn:active {
  background-color: #F3F4F6;
}

.action-icon {
  font-size: 18px;
}

.action-text {
  font-size: 13px;
  color: #6B7280;
  font-weight: 500;
}

.action-btn.active .action-text {
  color: #EF4444;
}

.action-btn.active .action-icon {
  animation: heart-bounce 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes heart-bounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* FAB */
.fab-btn {
  position: fixed;
  bottom: 120px;
  right: 24px;
  width: 56px;
  height: 56px;
  background-color: #10B981;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
  z-index: 100; /* Increased Z-index */
  transition: transform 0.2s;
}

.fab-btn:active {
  transform: scale(0.9);
  background-color: #059669;
}

.fab-icon {
  color: white;
  font-size: 32px;
  font-weight: 300;
  margin-top: -4px;
}

/* Comment Bottom Sheet */
.comment-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  z-index: 5000; /* Maximize Z-index */
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.comment-sheet {
  width: 100%; /* Ensure full width */
  background-color: white;
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
  padding: 0;
  display: flex;
  flex-direction: column;
  height: 70vh; 
  padding-bottom: env(safe-area-inset-bottom); /* Handle safe area properly */
  box-sizing: border-box; /* Include padding in width/height */
  animation: slide-up 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  padding: 16px 24px;
  border-bottom: 1px solid #F3F4F6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sheet-title {
  font-size: 16px;
  font-weight: 700;
  color: #1F2937;
}

.close-btn {
  font-size: 24px;
  color: #9CA3AF;
  line-height: 1;
  padding: 4px;
}

.comment-list {
  flex: 1;
  padding: 16px 24px;
  overflow-y: auto;
}

.comment-item {
  display: flex;
  margin-bottom: 24px;
}

.comment-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin-right: 12px;
  background-color: #E5E7EB;
  flex-shrink: 0;
}

.comment-right {
  flex: 1;
}

.comment-user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.comment-user {
  font-size: 13px;
  font-weight: 600;
  color: #6B7280;
}

.comment-likes {
  font-size: 12px;
  color: #9CA3AF;
}

.comment-content {
  font-size: 14px;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 6px;
  display: block;
}

.comment-time {
  font-size: 12px;
  color: #9CA3AF;
}

.input-row {
  display: flex;
  gap: 12px;
  align-items: center;
  width: 100%;
  padding: 12px 24px;
  border-top: 1px solid #F3F4F6;
  background-color: white;
  box-sizing: border-box;
}

.comment-input {
  flex: 1;
  background-color: #F3F4F6;
  height: 40px;
  border-radius: 20px;
  padding: 0 16px;
  font-size: 14px;
}

.send-btn {
  color: #10B981;
  font-weight: 600;
  padding: 8px;
}