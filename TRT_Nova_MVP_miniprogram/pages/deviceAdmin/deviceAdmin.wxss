.container {
  padding: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.input {
  height: 84rpx;
  border: 1px solid #d8d8d8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
}

.btn {
  margin-top: 8rpx;
  background: #10b981;
  color: #fff;
}

.registry-title {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.registry-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 24rpx;
}

.registry-item {
  background: #fff;
  border: 1px solid #ececec;
  border-radius: 10rpx;
  padding: 14rpx;
}

.registry-line {
  display: block;
  font-size: 24rpx;
  color: #374151;
  margin-bottom: 6rpx;
}

.registry-empty {
  color: #9ca3af;
  font-size: 24rpx;
}