.garden-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f3f7f5 0%, #f9fbfa 100%);
  position: relative;
}

.header {
  padding: 20rpx 32rpx 8rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

.back-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #111827;
  display: block;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  display: block;
}

.list-scroll {
  height: calc(100vh - 160rpx);
}

.device-list {
  padding: 16rpx 26rpx 180rpx;
}

.device-card {
  background: #fff;
  border-radius: 26rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
  display: flex;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.device-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.device-main {
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.online {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.online.ok {
  background: #dcfce7;
  color: #15803d;
}

.online.offline {
  background: #f3f4f6;
  color: #6b7280;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.plant-type {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.status-chip {
  margin-top: 14rpx;
  width: fit-content;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.status-chip.good {
  background: #e7f8ef;
  color: #166534;
}

.status-chip.warn {
  background: #fff4e5;
  color: #c2410c;
}

.status-chip.pending {
  background: #f3f4f6;
  color: #6b7280;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #374151;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 16rpx;
  background: #10B981;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(16,185,129,0.3);
}

.empty-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.empty-btn-text {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 140rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #65a36f;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(20, 83, 45, 0.28);
}

.fab-plus {
  color: #fff;
  font-size: 62rpx;
  line-height: 1;
}
