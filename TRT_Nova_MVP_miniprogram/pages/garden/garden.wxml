<view class="garden-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="header">
    <view class="header-top">
      <view class="back-btn" bindtap="goBackHome">←</view>
      <text class="title">我的花园</text>
      <view class="back-placeholder"></view>
    </view>
    <text class="subtitle">{{summaryText}}</text>
  </view>

  <scroll-view class="list-scroll" scroll-y>
    <view class="device-list">
      <block wx:for="{{devices}}" wx:key="logicalKey">
        <view class="device-card" bindtap="openDeviceDetail" data-logicalkey="{{item.logicalKey}}">
          <image class="device-image" src="{{item.image}}" mode="aspectFill" />
          <view class="device-main">
            <view class="top-row">
              <text class="name">{{item.alias}}</text>
              <text class="online {{item.online ? 'ok' : 'offline'}}">{{item.online ? '在线' : '离线'}}</text>
            </view>
            <text class="meta">{{item.location}} · 智能花盆</text>
            <text class="plant-type">植物类型：{{item.plantType}}</text>
            <view class="status-chip {{item.statusType}}">
              <text>{{item.statusText}}</text>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{devices.length === 0}}" class="empty">
        <text>还没有设备，点击右下角添加</text>
      </view>
    </view>
  </scroll-view>

  <view class="fab" bindtap="openDeviceManager">
    <text class="fab-plus">+</text>
  </view>
</view>
