page {
  background:
    radial-gradient(circle at top, rgba(53, 255, 149, 0.08), transparent 28%),
    linear-gradient(180deg, #07110d 0%, #091612 44%, #07110d 100%);
  color: #eafdf0;
}

.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.container::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(82, 255, 164, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(82, 255, 164, 0.08) 1px, transparent 1px);
  background-size: 28px 28px;
  opacity: 0.35;
  mask-image: linear-gradient(180deg, rgba(0,0,0,0.7), transparent 96%);
}

.fade-in {
  animation: fadeIn 0.35s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.topbar {
  position: relative;
  z-index: 2;
  padding: 12px 16px 6px;
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.topbar-brand {
  flex: 1;
  min-width: 0;
}

.topbar-kicker {
  display: block;
  font-size: 10px;
  letter-spacing: 2px;
  color: rgba(116, 255, 180, 0.65);
  text-transform: uppercase;
  margin-bottom: 2px;
}

.plant-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(14, 23, 19, 0.9), rgba(9, 18, 14, 0.96));
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow:
    0 0 0 1px rgba(71, 255, 149, 0.06) inset,
    0 0 18px rgba(33, 255, 135, 0.08);
}

.plant-picker-content {
  min-width: 0;
  flex: 1;
}

.plant-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #66f2a8;
  text-shadow: 0 0 12px rgba(68, 255, 151, 0.35);
}

.plant-meta {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.62);
}

.plant-picker-arrow {
  color: #63f2a4;
  font-size: 14px;
}

.topbar-signal {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 27, 21, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow: 0 0 16px rgba(39, 255, 143, 0.08);
}

.topbar-signal-icon {
  font-size: 16px;
  color: #68ffab;
}

.plant-chip-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.plant-personality-chip,
.plant-favorability-chip {
  min-height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid rgba(122, 255, 175, 0.18);
  background: rgba(15, 27, 21, 0.9);
  box-shadow: 0 0 14px rgba(39, 255, 143, 0.06);
}

.plant-personality-label,
.plant-favorability-label {
  font-size: 10px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(123, 255, 177, 0.76);
}

.plant-personality-value,
.plant-favorability-value {
  font-size: 12px;
  font-weight: 700;
  color: #effff4;
}

.scroll-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding: 2px 16px calc(120px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dark-panel,
.dark-card,
.card,
.device-item,
.add-device,
.grid-item,
.extra-item,
.device-card,
.chat-bubble,
.no-device-guide {
  background: linear-gradient(180deg, rgba(13, 21, 17, 0.96), rgba(10, 18, 14, 0.96));
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow:
    0 0 0 1px rgba(86, 255, 156, 0.05) inset,
    0 0 18px rgba(0, 0, 0, 0.22);
}

.plant-section {
  position: relative;
  min-height: 450rpx;
  padding: 22rpx;
  margin-bottom: 16px;
  border-radius: 28px;
  overflow: hidden;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(80, 255, 164, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(80, 255, 164, 0.08) 1px, transparent 1px);
  background-size: 24px 24px;
  opacity: 0.28;
  pointer-events: none;
}

.glow-bg {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  right: -38px;
  top: 10px;
  background: rgba(68, 255, 151, 0.18);
  filter: blur(34px);
  pointer-events: none;
}

.plant-circle {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 208rpx;
  height: 208rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid rgba(122, 255, 175, 0.18);
  box-shadow:
    0 0 0 1px rgba(103, 255, 171, 0.08) inset,
    0 0 26px rgba(46, 255, 146, 0.18);
}

.plant-img {
  width: 100%;
  height: 100%;
}

.status-pill {
  position: absolute;
  min-height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(11, 18, 14, 0.92);
  border: 1px solid rgba(122, 255, 175, 0.16);
  box-shadow: 0 0 20px rgba(31, 255, 130, 0.08);
  z-index: 2;
}

.status-pill-left {
  top: 20px;
  left: 18px;
}

.status-pill-right {
  top: 20px;
  right: 18px;
  max-width: 44%;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  padding-top: 8px;
  padding-bottom: 8px;
}

.status-pill-label {
  font-size: 10px;
  letter-spacing: 1px;
  color: #7ef4ac;
}

.status-pill-value {
  font-size: 9px;
  line-height: 1.2;
  color: rgba(223, 255, 232, 0.68);
  white-space: nowrap;
}

.weather-widget {
  position: absolute;
  left: 24px;
  bottom: 22px;
  min-width: 96px;
  height: 52px;
  padding: 0 12px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(13, 21, 17, 0.94);
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow: 0 0 18px rgba(31, 255, 130, 0.08);
}

.weather-icon {
  font-size: 18px;
}

.weather-temp {
  font-size: 16px;
  font-weight: 800;
  color: #effff4;
}

.bubble {
  position: absolute;
  min-width: 92px;
  min-height: 42px;
  padding: 8px 10px;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  border: 1px solid rgba(122, 255, 175, 0.16);
  background: rgba(10, 18, 14, 0.9);
  z-index: 1;
}

.bubble-success {
  box-shadow: 0 0 18px rgba(46, 255, 146, 0.08);
}

.bubble-warning {
  border-color: rgba(255, 174, 65, 0.28);
  box-shadow: 0 0 18px rgba(255, 174, 65, 0.08);
}

.bubble-icon {
  font-size: 12px;
}

.bubble-text {
  font-size: 11px;
  color: rgba(232, 255, 238, 0.82);
}

.mood-icon {
  position: absolute;
  right: 22px;
  bottom: 28px;
  width: 42px;
  height: 42px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 21, 17, 0.94);
  border: 1px solid rgba(122, 255, 175, 0.14);
  box-shadow: 0 0 18px rgba(31, 255, 130, 0.08);
  font-size: 20px;
}

.dialogue-section,
.section {
  margin-bottom: 16px;
}

.dialogue-section {
  padding: 14px;
  border-radius: 22px;
}

.chat-bubble {
  border-radius: 20px;
  padding: 14px 16px;
}

.chat-text {
  display: block;
  font-size: 14px;
  line-height: 1.7;
  color: rgba(236, 255, 242, 0.9);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 800;
  color: #f4fff7;
}

.add-todo-btn,
.refresh-btn {
  min-height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(12, 20, 15, 0.9);
  border: 1px solid rgba(122, 255, 175, 0.14);
  color: #63f2a4;
}

.add-todo-btn text,
.refresh-btn-text {
  font-size: 12px;
  font-weight: 700;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.card {
  padding: 14px;
  border-radius: 20px;
}

.dark-task-card {
  background: linear-gradient(180deg, rgba(13, 21, 17, 0.95), rgba(10, 18, 14, 0.96));
}

.border-l-red {
  border-left: 4px solid rgba(255, 98, 98, 0.85);
}

.border-l-blue {
  border-left: 4px solid rgba(90, 211, 255, 0.85);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-circle {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(18, 30, 23, 0.95);
  border: 1px solid rgba(122, 255, 175, 0.1);
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #f4fff7;
}

.card-desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
}

.text-red {
  color: rgba(255, 130, 130, 0.9);
}

.text-gray {
  color: rgba(223, 255, 232, 0.58);
}

.empty-state {
  padding: 14px 0 2px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.56);
}

.no-device-guide {
  padding: 18px;
  border-radius: 22px;
}

.no-device-icon {
  display: block;
  font-size: 24px;
  margin-bottom: 8px;
}

.no-device-title {
  display: block;
  font-size: 15px;
  font-weight: 800;
  color: #f4fff7;
}

.no-device-desc {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.6;
  color: rgba(223, 255, 232, 0.6);
}

.device-scroll {
  overflow: hidden;
}

.device-list {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.device-list::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.device-item,
.add-device {
  width: 168px;
  min-width: 168px;
  padding: 14px;
  border-radius: 22px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.device-item.active {
  border-color: rgba(113, 255, 170, 0.28);
  box-shadow:
    0 0 0 1px rgba(79, 255, 160, 0.08) inset,
    0 0 18px rgba(39, 255, 143, 0.1);
}

.device-item-icon,
.add-device-icon {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
}

.device-item-name {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #f4fff7;
}

.device-item-plant,
.device-item-location,
.device-item-status {
  display: block;
  font-size: 11px;
  line-height: 1.5;
  color: rgba(223, 255, 232, 0.62);
}

.status-text-online {
  color: rgba(117, 255, 180, 0.96);
}

.status-text-offline {
  color: rgba(255, 186, 103, 0.95);
}

.add-device {
  justify-content: center;
  align-items: center;
  color: #63f2a4;
  border-style: dashed;
  background: rgba(10, 18, 14, 0.76);
}

.add-device-text {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.grid-item {
  padding: 14px;
  border-radius: 20px;
  min-height: 116px;
}

.grid-icon-wrap {
  width: 32px;
  height: 32px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
}

.grid-icon-emoji {
  font-size: 16px;
}

.grid-value {
  display: block;
  font-size: 24px;
  font-weight: 800;
  color: #66f2a8;
  line-height: 1.1;
}

.unit {
  font-size: 12px;
  color: rgba(223, 255, 232, 0.64);
  margin-left: 2px;
}

.grid-label {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: rgba(223, 255, 232, 0.58);
}

.extra-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.extra-item {
  padding: 14px;
  border-radius: 18px;
  min-height: 86px;
}

.extra-item.full {
  grid-column: 1 / -1;
}

.extra-label {
  display: block;
  font-size: 11px;
  letter-spacing: 1px;
  color: rgba(122, 255, 175, 0.58);
  margin-bottom: 10px;
}

.extra-value {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: #f4fff7;
  line-height: 1.55;
  word-break: break-all;
}

.extra-value.uid {
  color: #67f2a4;
}

.control-section {
  margin-top: 4px;
}

.device-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.device-card {
  position: relative;
  border-radius: 24px;
  padding: 16px;
  min-height: 164px;
  overflow: hidden;
}

.device-card.active {
  border-color: rgba(113, 255, 170, 0.3);
  box-shadow:
    0 0 0 1px rgba(79, 255, 160, 0.08) inset,
    0 0 18px rgba(39, 255, 143, 0.12);
}

.device-card.pending {
  opacity: 0.92;
}

.device-state-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  min-width: 66px;
  height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 34, 26, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.14);
}

.device-state-badge.is-on {
  background: linear-gradient(180deg, rgba(91, 255, 169, 0.98), rgba(37, 195, 104, 0.98));
}

.device-state-badge.is-off {
  background: rgba(18, 30, 23, 0.96);
}

.device-state-badge-text {
  font-size: 11px;
  font-weight: 800;
  color: #05110b;
}

.device-icon-box {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  background: rgba(18, 30, 23, 0.96);
  border: 1px solid rgba(122, 255, 175, 0.12);
  box-shadow: 0 0 18px rgba(39, 255, 143, 0.08);
}

.device-icon {
  font-size: 26px;
}

.device-info {
  max-width: 82%;
}

.device-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: #f4fff7;
}

.device-status {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  color: #66f2a8;
}

.device-hint {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.6;
  color: rgba(223, 255, 232, 0.58);
}
