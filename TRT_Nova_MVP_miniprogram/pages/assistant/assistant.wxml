<view class="assistant-page">
  <view class="assistant-shell">
    <view class="assistant-header" style="padding-top: calc({{statusBarHeight}}px + {{headerTopGap}}rpx);">
      <view class="header-topbar">
        <view class="header-title-wrap">
          <view class="header-brand">
            <text class="header-brand-icon">🌱</text>
            <text class="header-brand-text">TRT NOVA_AI</text>
          </view>
          <text class="header-subtitle">PLANT CARE CONSOLE</text>
        </view>

        <view class="header-actions">
          <view class="header-icon-button">
            <text class="header-icon">⟲</text>
          </view>
          <view class="header-icon-button">
            <text class="header-icon">◌</text>
          </view>
        </view>
      </view>

      <view class="assistant-status-strip">
        <view class="assistant-status-led"></view>
        <text class="assistant-status-text">{{selectedLogicalKey ? selectedDeviceName : 'NOVA HUB-01'}} // LINK: {{selectedLogicalKey ? 'ACTIVE' : 'STANDBY'}}</text>
        <view class="assistant-status-badge">{{devices.length > 0 ? 'ONLINE' : 'IDLE'}}</view>
      </view>

      <picker wx:if="{{devices.length > 0}}" range="{{devices}}" range-key="name" bindchange="onDeviceChange">
        <view class="device-chip">
          <view class="device-chip-left">
            <text class="device-chip-label">DEVICE</text>
            <text class="device-chip-value">{{selectedDeviceName}}</text>
          </view>
          <view class="device-chip-row">
            <text class="device-chip-meta">{{selectedLogicalKey ? selectedLogicalKey : 'NO_LINK'}}</text>
            <text class="device-chip-arrow">▼</text>
          </view>
        </view>
      </picker>

      <view class="hero-card">
        <view class="hero-avatar-wrap">
          <view class="hero-avatar">🤖</view>
          <view class="hero-avatar-rim"></view>
        </view>

        <view class="hero-copy">
          <text class="hero-kicker">NOVA-AI // SYS.MSG</text>
          <text class="hero-title">我会结合当前设备状态，给你最直接的养护建议。</text>
          <text class="hero-desc">可以问我浇水、光照、湿度、好感度和历史趋势，我会优先围绕当前设备回答。</text>
        </view>
      </view>

      <view class="hero-shortcuts">
        <view class="hero-shortcut" data-text="我的植物现在状态怎么样？" bindtap="onQuickQuestionTap">
          <text class="hero-shortcut-icon">CHK_NTR</text>
          <text class="hero-shortcut-text">状态检测</text>
        </view>
        <view class="hero-shortcut" data-text="我现在要不要浇水？" bindtap="onQuickQuestionTap">
          <text class="hero-shortcut-icon">H2O</text>
          <text class="hero-shortcut-text">浇水建议</text>
        </view>
        <view class="hero-shortcut" data-text="最近湿度变化如何？" bindtap="onQuickQuestionTap">
          <text class="hero-shortcut-icon">TMP</text>
          <text class="hero-shortcut-text">温度分析</text>
        </view>
        <view class="hero-shortcut" data-text="如何提高好感度？" bindtap="onQuickQuestionTap">
          <text class="hero-shortcut-icon">SYNC</text>
          <text class="hero-shortcut-text">好感度</text>
        </view>
      </view>
    </view>

    <scroll-view
      scroll-y="true"
      class="message-scroll"
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollAnchor}}"
    >
      <view class="message-list">
        <block wx:for="{{messages}}" wx:key="id">
          <view wx:if="{{index === 1}}" class="timeline-hint">SESSION // {{messages[index].timeLabel}}</view>
          <view id="msg-{{index}}" class="message-row {{item.role === 'user' ? 'is-user' : 'is-assistant'}}">
            <view wx:if="{{item.role === 'assistant'}}" class="message-avatar assistant-avatar">AI</view>
            <view class="message-bubble {{item.role === 'user' ? 'user-bubble' : 'assistant-bubble'}}">
              <view class="bubble-topline">
                <text class="bubble-role">{{item.role === 'assistant' ? 'NOVA-AI // SYS.MSG' : 'USR // CMD'}}</text>
                <text wx:if="{{item.timeLabel}}" class="bubble-time">{{item.timeLabel}}</text>
              </view>

              <view wx:if="{{item.loading}}" class="thinking-block">
                <view class="thinking-dots">
                  <text class="thinking-dot dot-1"></text>
                  <text class="thinking-dot dot-2"></text>
                  <text class="thinking-dot dot-3"></text>
                </view>
                <text class="thinking-text">{{item.text}}</text>
              </view>

              <text wx:else class="message-text">{{item.text}}</text>

              <text wx:if="{{item.summary}}" class="message-summary">{{item.summary}}</text>

              <view wx:if="{{item.suggestions && item.suggestions.length}}" class="message-tags">
                <view
                  wx:for="{{item.suggestions}}"
                  wx:key="index"
                  class="message-tag"
                  data-text="{{item}}"
                  bindtap="onQuickQuestionTap"
                >
                  <text>{{item}}</text>
                </view>
              </view>

              <view wx:if="{{item.role === 'assistant' && !item.loading}}" class="message-actions">
                <view class="message-action">◎</view>
                <view class="message-action">⧉</view>
                <view class="message-action">↻</view>
              </view>
            </view>
            <view wx:if="{{item.role === 'user'}}" class="message-avatar user-avatar">USR</view>
          </view>
        </block>
      </view>
    </scroll-view>

    <view class="input-panel">
      <view class="quick-row">
        <view class="quick-chip" data-text="我的植物现在状态怎么样？" bindtap="onQuickQuestionTap">
          <text>CHK_NTR</text>
        </view>
        <view class="quick-chip" data-text="我现在要不要浇水？" bindtap="onQuickQuestionTap">
          <text>LGT_EXP</text>
        </view>
        <view class="quick-chip" data-text="最近湿度变化如何？" bindtap="onQuickQuestionTap">
          <text>TMP_HST</text>
        </view>
      </view>

      <view class="input-card">
        <view class="input-box">
          <view class="input-side-button">
            <text class="input-side-icon">＋</text>
          </view>

          <textarea
            class="assistant-input"
            placeholder="> Enter command..."
            maxlength="300"
            auto-height="true"
            cursor-spacing="24"
            value="{{inputValue}}"
            bindinput="onInput"
          />

          <view
            class="send-fab {{sending || !canSend ? 'disabled' : ''}}"
            bindtap="sendMessage"
          >
            <text class="send-fab-icon">{{sending ? '...' : '➤'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
