<view class="page">
  <view class="scan-grid"></view>

  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-side" bindtap="goBack">←</view>
    <view class="nav-center">
      <text class="brand">NOVA_SYS.v1</text>
      <text class="subline">{{device ? (device.online ? 'REC // ONLINE' : 'REC // OFFLINE') : 'REC // IDLE'}}</text>
    </view>
    <view class="nav-side nav-menu">···</view>
  </view>

  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="loading-mask">
      <view class="loading-dot"></view>
      <text class="loading-text">SYNCING DEVICE...</text>
    </view>

    <view wx:if="{{device}}" class="hero-panel">
      <view class="hero-glow hero-glow-left"></view>
      <view class="hero-glow hero-glow-right"></view>

      <view class="status-row">
        <view class="status-badge {{device.online ? 'ok' : 'off'}}">
          <text class="status-dot"></text>
          <text class="status-text">{{device.online ? 'ONLINE // SYNCED' : 'OFFLINE // STANDBY'}}</text>
        </view>
        <view class="status-chrono">REC // {{device.online ? 'LIVE' : 'HOLD'}}</view>
      </view>

      <view class="hero-main">
        <view class="hero-image-wrap">
          <image class="hero-image" src="{{device.image}}" mode="aspectFill" />
        </view>

        <view class="hero-copy">
          <view class="hero-title-row">
            <text class="hero-title">{{device.alias}}</text>
            <view class="hero-actions">
              <view class="hero-action hero-action-secondary" bindtap="goPlantJournal">LOG</view>
              <view class="hero-action hero-action-primary" bindtap="goSettings">CFG</view>
            </view>
          </view>

          <text class="hero-meta">{{device.location}} ・ {{device.plantType}}</text>
          <view
            wx:if="{{device.latestCommand}}"
            class="hero-tag"
            bindtap="showLatestCommandDetail"
            data-commandid="{{device.latestCommand.commandId}}"
          >
            <text class="hero-tag-label">CMD</text>
            <text class="hero-tag-value">{{device.latestCommandText}}</text>
          </view>
          <view wx:if="{{extraInfo.personality && extraInfo.personality !== '--'}}" class="hero-tag">
            <text class="hero-tag-label">BIO</text>
            <text class="hero-tag-value">{{extraInfo.personality}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{metricTabs.length > 0}}" class="metric-grid">
      <view
        wx:for="{{metricTabs}}"
        wx:key="key"
        class="metric-card {{item.active ? 'active' : ''}}"
        bindtap="onMetricTap"
        data-key="{{item.key}}"
      >
        <text class="metric-label">{{item.label}}</text>
        <view class="metric-value-line">
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-unit">{{item.unit}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{device}}" class="bio-panel">
      <view class="bio-card bio-main">
        <text class="bio-label">{{extraInfo.isDead === '是' ? '生命状态' : '好感度'}}</text>
        <text class="bio-value">{{extraInfo.isDead === '是' ? '已死亡' : extraInfo.favorability}}</text>
      </view>

      <view class="bio-card bio-secondary">
        <text class="bio-label">灵魂状态</text>
        <text class="bio-value">{{extraInfo.soulState}}</text>
      </view>

      <view class="bio-card bio-wide">
        <view>
          <text class="bio-label">植物类型</text>
          <text class="bio-value">{{extraInfo.reportedPlantType}}</text>
        </view>
        <view class="bio-chip">#</view>
      </view>
    </view>

    <view wx:if="{{device}}" class="trend-panel">
      <view class="trend-head">
        <view>
          <text class="trend-title">SENSOR_TREND</text>
          <text class="trend-subtitle">{{trendTip}}</text>
        </view>

        <view class="range-switch">
          <view
            wx:for="{{rangeOptions}}"
            wx:key="key"
            class="range-item {{rangeKey===item.key ? 'active' : ''}}"
            bindtap="onRangeTap"
            data-key="{{item.key}}"
          >{{item.label}}</view>
        </view>
      </view>

      <canvas id="trendCanvas" canvas-id="trendCanvas" class="chart"></canvas>

      <view class="trend-stats">
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendMin}}</text>
          <text class="trend-stat-label">MIN</text>
        </view>
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendAvg}}</text>
          <text class="trend-stat-label">AVG</text>
        </view>
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendMax}}</text>
          <text class="trend-stat-label">MAX</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
