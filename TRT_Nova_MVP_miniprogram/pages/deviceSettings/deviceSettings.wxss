.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.row {
  margin-bottom: 24rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  color: #111827;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.input,
.picker {
  height: 88rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  line-height: 88rpx;
  color: #111827;
  font-size: 28rpx;
  background: #fafafa;
}

.save-btn {
  margin-top: 30rpx;
  background: #16a34a;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}
