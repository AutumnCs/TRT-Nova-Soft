page {
  background: #07110d;
  color: #eaf7ee;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, rgba(47, 255, 128, 0.10), transparent 26%),
    linear-gradient(180deg, #07110d 0%, #071512 42%, #081210 100%);
  overflow: hidden;
}

.grid-bg {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(35, 221, 125, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(35, 221, 125, 0.08) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity: 0.38;
  pointer-events: none;
}

.scroll-content {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.top-shell {
  padding: 0 20px 22px;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 -2px 18px;
  padding: 8px 4px 12px;
}

.top-icon,
.top-signal {
  width: 36px;
  text-align: center;
  font-size: 22px;
  line-height: 1;
  color: #31f38b;
  text-shadow: 0 0 12px rgba(49, 243, 139, 0.55);
}

.top-title {
  flex: 1;
  text-align: center;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 3px;
  color: #39ff88;
  text-shadow: 0 0 16px rgba(57, 255, 136, 0.45);
}

.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 18px 22px;
  border-radius: 28px;
  border: 1px solid rgba(62, 255, 142, 0.22);
  background:
    linear-gradient(180deg, rgba(7, 18, 14, 0.92), rgba(9, 24, 19, 0.88));
  box-shadow:
    0 0 0 1px rgba(30, 255, 126, 0.08) inset,
    0 0 26px rgba(27, 255, 116, 0.10);
}

.hero-avatar-wrap {
  position: relative;
  width: 144px;
  height: 144px;
  margin-bottom: 16px;
}

.avatar-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 3px solid rgba(50, 255, 140, 0.75);
  box-shadow:
    0 0 0 8px rgba(50, 255, 140, 0.08),
    0 0 28px rgba(50, 255, 140, 0.36);
}

.avatar-lg {
  position: absolute;
  inset: 10px;
  width: calc(100% - 20px);
  height: calc(100% - 20px);
  border-radius: 50%;
  background: #122019;
}

.avatar-status {
  position: absolute;
  right: 16px;
  bottom: 12px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #2fe07c;
  border: 4px solid #07110d;
  box-shadow: 0 0 0 3px rgba(47, 224, 124, 0.18);
}

.user-name {
  font-size: 28px;
  line-height: 1.1;
  font-weight: 800;
  color: #f4faf6;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.14);
}

.user-level-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  padding: 10px 18px;
  border-radius: 999px;
  border: 1px solid rgba(49, 243, 139, 0.45);
  background: rgba(8, 28, 21, 0.82);
  box-shadow: 0 0 18px rgba(49, 243, 139, 0.12);
}

.user-level-icon {
  color: #39ff88;
  font-size: 16px;
  line-height: 1;
}

.user-level {
  color: #39ff88;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 10px 20px 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88px;
  padding: 18px 18px 18px 16px;
  border-radius: 22px;
  border: 1px solid rgba(41, 255, 121, 0.16);
  background: linear-gradient(180deg, rgba(9, 18, 15, 0.96), rgba(7, 15, 12, 0.96));
  box-shadow:
    0 0 0 1px rgba(49, 255, 136, 0.05) inset,
    0 10px 24px rgba(0, 0, 0, 0.26);
}

.menu-left {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 14px;
}

.menu-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: 1px solid rgba(57, 255, 136, 0.26);
  background: radial-gradient(circle at 50% 35%, rgba(57, 255, 136, 0.18), rgba(8, 18, 14, 0.88));
  box-shadow: 0 0 16px rgba(57, 255, 136, 0.14);
}

.logout-wrap {
  border-color: rgba(255, 86, 86, 0.24);
  background: radial-gradient(circle at 50% 35%, rgba(255, 86, 86, 0.18), rgba(34, 12, 12, 0.92));
  box-shadow: 0 0 18px rgba(255, 86, 86, 0.12);
}

.menu-icon {
  font-size: 20px;
  color: #39ff88;
}

.logout-icon {
  color: #ff6262;
}

.menu-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.menu-title {
  font-size: 20px;
  line-height: 1.2;
  font-weight: 800;
  color: #f4faf6;
  letter-spacing: 1px;
}

.menu-desc {
  margin-top: 6px;
  font-size: 12px;
  color: rgba(143, 191, 163, 0.72);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 14px;
  flex: none;
}

.menu-tail {
  font-size: 13px;
  font-weight: 700;
  color: #2fe07c;
  letter-spacing: 1px;
}

.arrow {
  flex: none;
  color: rgba(98, 255, 145, 0.82);
  font-size: 26px;
  line-height: 1;
}

.logout-item {
  border-color: rgba(255, 86, 86, 0.36);
  background: linear-gradient(180deg, rgba(41, 10, 10, 0.98), rgba(24, 9, 9, 0.98));
  box-shadow:
    0 0 0 1px rgba(255, 86, 86, 0.08) inset,
    0 0 24px rgba(255, 86, 86, 0.12);
}

.logout-title,
.logout-arrow {
  color: #ff5a5a;
}

.logout-tail {
  color: #ff7b7b;
}

.logout-desc {
  color: rgba(255, 177, 177, 0.7);
}

.bottom-spacer {
  height: 120px;
}

.fade-in {
  animation: none;
  opacity: 1;
}
