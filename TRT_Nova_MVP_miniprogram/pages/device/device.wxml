<!-- pages/device/device.wxml -->
<view class="container fade-in">
  <!-- Header Section -->
  <view class="header-section">
    <view class="header-content">
      <view class="title-large">设备管理</view>
      <view class="subtitle">连接并控制您的智能设备</view>
    </view>
    <view class="header-icon-bg">
      <text class="header-icon">📱</text>
    </view>
  </view>

  <!-- Bind Device Card -->
  <view class="section">
    <view class="card bind-card">
      <view class="card-header">
        <text class="card-title">添加新设备</text>
      </view>
      <view class="input-group">
        <view class="input-wrapper">
          <text class="input-icon">🆔</text>
          <input class="modern-input" placeholder="输入设备 ID" placeholder-class="input-placeholder" bindinput="onIdInput" value="{{deviceId}}" />
        </view>
        <view class="input-wrapper">
          <text class="input-icon">🏷️</text>
          <input class="modern-input" placeholder="设备名称 (可选)" placeholder-class="input-placeholder" bindinput="onNameInput" value="{{deviceName}}" />
        </view>
      </view>
      <button class="primary-btn" bindtap="bindDevice" hover-class="btn-hover">
        <text>✨ 立即绑定</text>
      </button>
    </view>
  </view>

  <!-- Device List Section -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的设备</text>
      <view class="refresh-btn" bindtap="refreshData" hover-class="refresh-hover">
        <text class="refresh-icon">🔄</text>
        <text>刷新</text>
      </view>
    </view>

    <view class="device-list-container">
      <block wx:for="{{deviceList}}" wx:key="_id">
        <view class="device-card fade-in-up" style="animation-delay: {{index * 0.1}}s">
          <view class="device-card-top">
            <view class="device-icon-circle">
              <text>📟</text>
            </view>
            <view class="device-info">
              <text class="device-name">{{item.deviceName || '未命名设备'}}</text>
              <text class="device-id">ID: {{item.deviceId}}</text>
            </view>
            <view class="device-status-badge">
              <text class="status-dot"></text>
              <text>在线</text>
            </view>
          </view>
          
          <view class="device-data-area">
             <text class="data-label">最新数据:</text>
             <text class="data-value">{{item.datapoints ? '已接收数据' : '暂无数据'}}</text>
             <view class="time-tag">{{item.updateTime || '刚刚'}}</view>
          </view>

          <view class="device-actions">
            <view class="cmd-input-wrapper">
              <input class="cmd-input" placeholder="输入指令..." bindinput="onCmdInput" data-index="{{index}}" />
            </view>
            <button class="send-btn" bindtap="sendCmd" data-id="{{item.deviceId}}" hover-class="send-btn-hover">
              <text>发送</text>
            </button>
          </view>
        </view>
      </block>

      <view wx:if="{{deviceList.length === 0}}" class="empty-state">
        <view class="empty-icon">🍃</view>
        <text class="empty-text">暂无设备，快去绑定一个吧~</text>
      </view>
    </view>
  </view>
</view>
