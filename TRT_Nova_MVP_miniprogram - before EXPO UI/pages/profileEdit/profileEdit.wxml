<view class="container fade-in" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav">
    <view class="nav-btn" bindtap="goBack">←</view>
    <text class="nav-title">个人资料</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="header">
    <text class="title">个人资料</text>
    <text class="subtitle">完善信息，获得更贴心的养护建议</text>
  </view>

  <scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}">
    <view class="card">
      <view class="row avatar-row">
        <view class="row-left">
          <text class="label">头像</text>
        </view>
        <view class="row-right flex-1">
          <view class="avatar-wrap">
            <button wx:if="{{!isApp}}" class="avatar-uploader" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
              <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="avatar-empty"><text class="avatar-empty-icon">📷</text></view>
            </button>
            <button wx:else class="avatar-uploader" bindtap="onPickAvatar">
              <image wx:if="{{form.avatarUrl}}" class="avatar" src="{{form.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="avatar-empty"><text class="avatar-empty-icon">📷</text></view>
            </button>
          </view>
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">昵称</text>
        </view>
        <view class="row-right flex-1">
          <input
            type="nickname"
            class="input"
            placeholder="请输入昵称"
            value="{{form.nickName}}"
            bindinput="onNickNameChange"
            maxlength="20"
          />
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">性别</text>
        </view>
        <view class="row-right flex-1">
          <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
            <view class="picker">
              <text class="picker-text">{{genderOptions[genderIndex].label}}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">所在地区</text>
        </view>
        <view class="row-right flex-1">
          <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
            <view class="picker">
              <text class="picker-text">{{regionText || '请选择'}}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">生日</text>
        </view>
        <view class="row-right flex-1">
          <picker mode="date" value="{{form.birthday}}" bindchange="onBirthdayChange">
            <view class="picker">
              <text class="picker-text">{{form.birthday || '请选择'}}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">种植经验</text>
        </view>
        <view class="row-right flex-1">
          <picker mode="selector" range="{{experienceOptions}}" value="{{experienceIndex}}" bindchange="onExperienceChange">
            <view class="picker">
              <text class="picker-text">{{form.experienceLevel || '请选择'}}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>

      <view class="textarea-field">
        <text class="label">个性签名</text>
        <textarea
          class="textarea"
          placeholder="介绍一下你吧（可选）"
          value="{{form.signature}}"
          bindinput="onSignatureInput"
          maxlength="120"
          auto-height="true"
        />
      </view>
    </view>

    <view class="card">
      <view class="row">
        <view class="row-left">
          <text class="label">手机号</text>
        </view>
        <view class="row-right flex-1">
          <input class="input" type="number" placeholder="选填" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="20" />
        </view>
      </view>

      <view class="row">
        <view class="row-left">
          <text class="label">邮箱</text>
        </view>
        <view class="row-right flex-1">
          <input class="input" type="text" placeholder="选填" value="{{form.email}}" bindinput="onEmailInput" maxlength="50" />
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </scroll-view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
      保存
    </button>
  </view>
</view>
