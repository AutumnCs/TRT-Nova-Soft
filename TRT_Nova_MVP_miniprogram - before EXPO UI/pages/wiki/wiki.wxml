<view wx:if="{{!showDetail}}" class="container">
  <view class="search-section" style="padding-top: calc({{statusBarHeight}}px + 8px)">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索植物名称、科属或特征"
        placeholder-class="placeholder"
        bindinput="onSearch"
      />
    </view>
    <view class="category-tags">
      <view class="tag {{activeCategory === 'all' ? 'active' : ''}}" bindtap="switchCategory" data-category="all">全部</view>
      <view class="tag {{activeCategory === 'favorites' ? 'active' : ''}}" bindtap="switchCategory" data-category="favorites">我的收藏</view>
    </view>
  </view>

  <scroll-view scroll-y="true" class="scroll-content" show-scrollbar="{{false}}">
    <view wx:if="{{loading && filteredPlants.length === 0}}" class="skeleton-grid">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-image"></view>
        <view class="skeleton-body">
          <view class="skeleton-line skeleton-line-lg"></view>
          <view class="skeleton-line skeleton-line-md"></view>
          <view class="skeleton-chip"></view>
        </view>
      </view>
    </view>

    <view wx:else class="plant-grid fade-in">
      <block wx:for="{{filteredPlants}}" wx:key="id">
        <view class="plant-card" bindtap="showPlantDetail" data-id="{{item.id}}">
          <view class="plant-image-container">
            <image class="plant-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="favorite-icon {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-id="{{item.id}}">
              <text>{{item.isFavorite ? '❤️' : '🤍'}}</text>
            </view>
          </view>

          <view class="plant-info">
            <text class="plant-name">{{item.name}}</text>
            <text class="plant-family">{{item.family}}</text>
            <view class="feature-tag {{item.feature}}">
              {{item.featureText}}
            </view>
          </view>

          <view class="detail-btn">
            <text>i</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{!loading || filteredPlants.length > 0}}" class="calendar-section fade-in" bindtap="openPlantJournal">
      <view class="calendar-header">
        <text class="calendar-title">{{calendarYear}} 年 {{calendarMonth}} 月植物日历</text>
        <view class="calendar-icon">
          <text>{{calendarDay}}</text>
        </view>
      </view>
      <text class="calendar-desc">今日推荐：{{calendarTodayPlant}}・点击打开成长记录与当天待办</text>
    </view>
  </scroll-view>
</view>

<view wx:else class="container detail-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="detail-nav" style="padding-top: {{detailNavPaddingTop}}px;">
    <view class="nav-btn close-btn" bindtap="closeDetail">
      <text>×</text>
    </view>
    <text class="nav-title">卡片详情</text>
    <view class="nav-actions">
      <view class="nav-btn fav-btn {{currentPlant.isFavorite ? 'fav-active' : ''}}" bindtap="toggleDetailFavorite">
        <text>{{currentPlant.isFavorite ? '❤️' : '🤍'}}</text>
      </view>
      <view class="nav-btn share-btn">
        <text>📤</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y="true" class="detail-scroll" show-scrollbar="{{false}}">
    <view class="plant-showcase">
      <image class="showcase-image" src="{{currentPlant.image}}" mode="aspectFill"></image>
      <view class="plant-details">
        <text class="showcase-name">{{currentPlant.name}}</text>
        <text class="showcase-scientific">{{currentPlant.scientificName}}</text>
        <view class="showcase-tags">
          <view class="tag-item" wx:for="{{currentPlant.tags}}" wx:key="*this">
            {{item}}
          </view>
        </view>
      </view>
    </view>

    <view class="plant-intro">
      <text class="section-title">植物简介</text>
      <text class="intro-text">{{currentPlant.description}}</text>
      <view class="more-link" bindtap="toggleMore">
        {{showMore ? '收起 ↑' : '查看更多详细资料 ↓'}}
      </view>
    </view>

    <view class="care-info">
      <text class="section-title">养护信息</text>
      <view class="care-grid">
        <view class="care-item">
          <view class="care-icon">☀️</view>
          <text class="care-text">{{currentPlant.care.light}}</text>
        </view>
        <view class="care-item">
          <view class="care-icon">💧</view>
          <text class="care-text">{{currentPlant.care.water}}</text>
        </view>
      </view>
    </view>

    <view class="action-section">
      <button class="add-reminder-btn" bindtap="addReminder">加入养护提醒</button>
    </view>
  </scroll-view>
</view>
